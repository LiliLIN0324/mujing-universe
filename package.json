{
  "name": "mujing-site",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/check-packs.mjs --warn && node scripts/check-roster.mjs --warn",
    "prebuild": "node scripts/test-font-chars.mjs && node scripts/check-fonts.mjs && node scripts/check-packs.mjs && node scripts/check-roster.mjs",
    "build": "astro build",
    "check:packs": "node scripts/check-packs.mjs",
    "check:roster": "node scripts/check-roster.mjs",
    "check:fonts": "node scripts/test-font-chars.mjs && node scripts/check-fonts.mjs",
    "fonts": "python scripts/subset-fonts.py",
    "fetch-covers": "node scripts/fetch-ring-covers.mjs",
    "preview": "astro preview --port 4471 --host 127.0.0.1"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.50.0",
    "astro": "^7.4.12",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@fontpkg/alibaba-pu-hui-ti-3-0": "^3.1.2"
  }
}