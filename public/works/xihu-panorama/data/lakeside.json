  "landmarks": [
    { "id": "duanqiao", "name": "断桥", "en": "DUAN QIAO · LINGERING SNOW", "x": 330, "y": -322, "z": 40, "r": 78,
      "desc": "白堤东端的一道石拱桥。雪后桥阳雪融、桥阴未消，远望似断非断，便有了“断桥残雪”。桥头四柱华表按南宋形制示意（宋桥无亭，非测绘级）。" },
    { "id": "bai", "name": "白堤", "en": "BAI CAUSEWAY · WILLOWS IN MIST", "x": -40, "y": -518, "z": 12, "r": 70,
      "desc": "西湖北缘的长堤，东起断桥、西至平湖秋月，桃柳相间，雨雾里像一笔淡墨。" },
    { "id": "su", "name": "苏堤", "en": "SU CAUSEWAY · SIX BRIDGES", "x": -420, "y": 12, "z": 12, "r": 80,
      "desc": "苏轼疏浚西湖，以葑泥筑成三里长堤。六桥卧波，烟柳夹岸，春晨尤宜缓行。" },
    { "id": "quyuan", "name": "曲院风荷", "en": "BREEZE-STIRRED LOTUS", "x": -300, "y": -390, "z": 8, "r": 100,
      "desc": "南宋时此处有酿酒曲院，临荷而开。夏日风过，荷香与酒香一并上岸。" },
    { "id": "huxinting", "name": "湖心亭", "en": "MID-LAKE PAVILION", "x": 78, "y": 75, "z": 40, "r": 62,
      "desc": "湖心小岛上的一座临水亭。停舟暂歇，四望皆水，晴雨各有清趣。" },
    { "id": "santan", "name": "三潭印月", "en": "THREE POOLS MIRRORING THE MOON", "x": 150, "y": 430, "z": 16, "r": 105,
      "desc": "三座小石塔立在湖心亭南。月夜塔内点灯，圆孔透光映水，与天上月影相叠。" },
    { "id": "leifeng", "name": "雷峰塔", "en": "LEIFENG PAGODA · EVENING GLOW", "x": 592, "y": 570, "z": 170, "r": 84,
      "desc": "立在西湖南岸的夕照山上。塔影入湖，暮色里最见苍古，也牵着白娘子的旧传说。" },
    { "id": "baochu", "name": "保俶塔", "en": "BAOCHU PAGODA · NEEDLE IN THE HILLS", "x": 449, "y": -744, "z": 118, "r": 70,
      "desc": "宝石山上的细长古塔，与雷峰塔隔湖相望。一秀一厚，都是西湖远山里的旧识。" }
