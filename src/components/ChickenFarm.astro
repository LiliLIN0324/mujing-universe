---
/**
 * 幕景鸡场：官网适配层。
 * 引擎权威源 = GitHub endtree-FDE/coop.js @ 9b12c91（PR#2 squash → main）。
 * 本文件不再内嵌旧 fork 引擎；只负责把 tip init() 挂进站点，并保留站侧 hooks。
 * Vite 6：模块从 src/lib/coop/* 加载（禁止 import public/coop）。
 */
const { page = 'home' } = Astro.props;
---
<!-- tip coop.js 在 #farm 不存在时注入 MARKUP（含货架/地琴 DOM）。此处不重复 markup。 -->
<!-- 给适配脚本可读的当前页 id（tip 也读 body[data-page] / cfg.page） -->
<div id="coop-page-bridge" data-page={page} hidden></div>
<script>
  /* ===== 官网适配层：tip init + 站侧页面表 / 不挂库内 chat（MimiChat.astro）===== */
  import init from '../lib/coop/coop.js';
  import pack from '../lib/coop/pack.json';
  import sprite from '../lib/coop/sprite.svg?raw';

  const pages = [
    { id: 'home', label: '首页', href: '/' },
    { id: 'works', label: '作品页', href: '/works/' },
    { id: 'about', label: '关于页', href: '/about/' },
    { id: 'news', label: '动态页', href: '/news/' },
    { id: 'contact', label: '合作页', href: '/contact/' },
  ];

  /* tip CSS 里 .farm-hint bottom:52px 会盖住左下货架；官网抬高提示，不改 tip 引擎逻辑。 */
  if (!document.getElementById('coop-site-hint-clearance')) {
    const st = document.createElement('style');
    st.id = 'coop-site-hint-clearance';
    st.textContent = [
      '.farm-hint { bottom: 86px !important; }',
      '@media (max-width: 768px) {',
      '  .farm-hint { left: 10px; bottom: calc(82px + env(safe-area-inset-bottom, 0px)) !important; }',
      '}',
    ].join('\n');
    document.head.appendChild(st);
  }

  window.__coopVer = window.__coopVer || 'site-9b12c91';
  const bridge = document.getElementById('coop-page-bridge');
  const page = (bridge && bridge.dataset.page)
    || document.body?.dataset?.page
    || 'home';

  init({
    pack,
    sprite,
    brand: '幕景鸡场',
    page,
    pages,
    /* 不传 chat：管家由 MimiChat.astro 承担，避免 tip 再挂 src/chat.js */
  });
</script>
