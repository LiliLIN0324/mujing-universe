---
import { allWorks } from '../lib';
import newsData from '../data/news.json';
import artist from '../data/artist.json';
import { coopVer } from '../lib/coop-ver.mjs';

/**
 * 幕景鸡场：官网适配层。
 * 引擎权威源 = GitHub endtree-FDE/coop.js（src/coop.js）。
 * 本文件不内嵌引擎；只负责把 init() 挂进站点，并保留站侧 hooks。
 * Vite 6：模块从 src/lib/coop/* 加载（禁止 import public/coop）。
 *
 * 边界（2026-11-03 起）：
 *   玩法、界面、配色、器物外观全在引擎里；站侧只做「接线」。
 *   站侧不画任何装饰——纯装饰不算功能，要做也要能说明它承载了什么信息。
 *   站侧引擎副本 src/lib/coop/coop.js 由 scripts/sync-site.mjs 单向覆盖，禁手改。
 */
const { page = 'home' } = Astro.props;

/* ===== 鸡场快讯的内容源（2026-11-04）=====
   机制在引擎，内容由站侧推：引擎只管「什么时候报、报哪条、怎么显示、给什么奖励、别重复报」，
   内容由官网给 —— 引擎抄一份就会过期（官网天天有新作品和新动态）。
   这里把作品 / 动态 / 履历整理成快讯条目，页面加载时推给引擎（window 的 farm:content）。 */
const NEWS_MAX = 8;              // 动态只推最近 8 条（更早的报出来也没人看）
const cut = (s, n = 42) => {
  const t = String(s || '').replace(/\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, n) + '…' : t;
};
const works = await allWorks();
const newsRows = (newsData.items || [])
  .slice()
  .sort((a, b) => String(b.start || '').localeCompare(String(a.start || '')))
  .slice(0, NEWS_MAX);
const farmContent = [
  ...works.map((w) => ({
    id: 'work:' + w.slug, kind: 'work', label: '新作品',
    title: w.title, text: cut(w.description), href: '/works/' + w.slug + '/',
    /* 地图上谷仓边的作品架要缩略图：机制在引擎，内容在站侧（作品天天在变） */
    cover: w.icon || (w.images && w.images[0]) || '',
    place: 'works',
  })),
  ...newsRows.map((n) => ({
    id: 'news:' + n.id, kind: 'news', label: '新动态',
    title: cut(n.title, 30), text: cut(n.summary), href: '/news/#' + n.id,
  })),
  ...(artist.talks || []).map((t, i) => ({
    id: 'talk:' + i + ':' + t.title, kind: 'bio', label: '履历',
    title: cut(t.title, 34), text: cut([t.event, t.location].filter(Boolean).join(' · ')), href: '/about/',
  })),
  ...(artist.awards || []).flatMap((a) => (a.items || []).map((it) => ({
    id: 'award:' + a.category + ':' + it.name + ':' + (it.year || ''), kind: 'bio', label: '获奖',
    title: cut(it.name, 30), text: cut([a.category, it.year].filter(Boolean).join(' · ')), href: '/about/',
  }))),
];
/* 塞进 <script type="application/json"> 之前，把 "<" 换成 < 的 JSON 转义 ——
   否则内容里出现 "</script>" 会把标签提前关掉。JSON.parse 会把它还原回 <。 */
const farmContentJson = JSON.stringify(farmContent).replace(/</g, '\\u003c');

/* 版本号：按 public/packs/** 的实际内容算出来（src/lib/coop-ver.mjs）。
   以前是手写常量（'site-universe01-r8'）—— 换了图忘了改，用户就一直吃旧图。
   现在换任何一张素材，构建出的版本号自动变，CDN 自然失效。 */
const coopVerValue = coopVer({ dev: import.meta.env.DEV });
---
<!-- tip coop.js 在 #farm 不存在时注入 MARKUP（含货架/地琴 DOM）。此处不重复 markup。 -->
<!-- 给适配脚本可读的当前页 id（tip 也读 body[data-page] / cfg.page） -->
<div id="coop-page-bridge" data-page={page} hidden></div>

<!-- 鸡场快讯的内容源：给下面的适配脚本读（引擎不抄内容，抄了会过期） -->
<script type="application/json" id="farm-content" is:inline set:html={farmContentJson}></script>

<!-- 素材缓存版本号：构建时算出来的，引擎拿它给 /packs/... 的 URL 加查询串 -->
<script type="application/json" id="coop-ver" is:inline set:html={JSON.stringify(coopVerValue)}></script>

<script>
  /* ===== 官网适配层：tip init + 站侧页面表 / 不挂库内 chat（MimiChat.astro）===== */
  import init from '../lib/coop/coop.js';
  import pack from '../lib/coop/pack.json';
  import sprite from '../lib/coop/sprite.svg?raw';

  const pages = [
    { id: 'home', label: '首页', href: '/' },
    { id: 'works', label: '作品页', href: '/works/' },
    { id: 'about', label: '关于页', href: '/about/' },
    { id: 'news', label: '动态页', href: '/news/' },
    { id: 'contact', label: '合作页', href: '/contact/' },
  ];

  /* tip CSS 里 .farm-hint bottom:52px 会盖住左下货架；官网抬高提示，不改 tip 引擎逻辑。 */
  if (!document.getElementById('coop-site-hint-clearance')) {
    const st = document.createElement('style');
    st.id = 'coop-site-hint-clearance';
    st.textContent = [
      '.farm-hint { bottom: 86px !important; }',
      '@media (max-width: 768px) {',
      '  .farm-hint { left: 10px; bottom: calc(82px + env(safe-area-inset-bottom, 0px)) !important; }',
      '}',
    ].join('\n');
    document.head.appendChild(st);
  }

  /* 版本号来自构建时算出的 #coop-ver（见 src/lib/coop-ver.mjs）。
     读不到就退回一个显眼的占位值 —— 宁可缓存失效重来，也不要悄悄吃旧图。 */
  let VER = 'site-universe01-unknown';
  try {
    VER = JSON.parse(document.getElementById('coop-ver')?.textContent || '""') || VER;
  } catch { /* 读不到就用占位 */ }
  window.__coopVer = window.__coopVer || VER;
  const bridge = document.getElementById('coop-page-bridge');
  const page = (bridge && bridge.dataset.page)
    || document.body?.dataset?.page
    || 'home';

  init({
    pack,
    sprite,
    brand: '幕景鸡场',
    page,
    pages,
    /* 不传 chat：管家由 MimiChat.astro 承担，避免 tip 再挂 src/chat.js */
  });

  /* ===== 鸡场快讯：把官网的内容推给引擎 =====
     引擎监听 window 的 farm:content（detail.items = [{id,kind,label,title,text,href}]），
     收到之后会挑一条让鸡走到场中央冒泡，并给一点奖励。两条路都走：
       1) window.__coopContent —— 引擎起得晚（动态 import）时也能读到；
       2) farm:content 事件 —— 引擎已经在跑时立刻生效。 */
  let farmContent = [];
  try {
    const raw = document.getElementById('farm-content')?.textContent || '[]';
    farmContent = JSON.parse(raw);
  } catch { /* 读不到就不推，鸡场照常跑 */ }
  window.__coopContent = { items: farmContent };
  window.dispatchEvent(new CustomEvent('farm:content', { detail: { items: farmContent } }));

  /* ===== A 逛站联动：站侧把「你看了什么」告诉鸡场 =====
     引擎监听 window 上的 farm:visit：看作品给米、看动态给蛋，
     看够 3 次作品解锁水缸。鸡场关着时奖励先存着，下次开场兑现。 */
  const VISIT_TARGETS = [
    ['a[href^="/works/"], .wf-cards .card, .wf .idx .row, .m-card, .fs-slide', 'work'],
    ['.news-list li .hit', 'news'],
  ];
  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!t || !t.closest) return;
    /* 鸡场自己的界面不算逛站 */
    if (t.closest('#farm, .mimi-panel, .mimi-launch, .butter-box, .mimi-hi')) return;
    for (const [sel, kind] of VISIT_TARGETS) {
      const hit = t.closest(sel);
      if (!hit) continue;
      const name = (hit.querySelector('h1, h2, .title, .ttl') || hit).textContent || '';
      window.dispatchEvent(new CustomEvent('farm:visit', {
        detail: { kind, title: name.trim().slice(0, 40) },
      }));
      return;
    }
  }, true);
</script>
