---
/**
 * 合作工作台。填表走 mailto，无后端。
 * 定金码 public/consult/pay-qr.png。
 */
const { tool = '' } = Astro.props;
const email = 'lily1326685527@gmail.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent('合作')}`;
const needs = ['古画', '民乐音画', '展览 · 委托'] as const;
const tiers = [
  ['1', '¥1', '试收款'],
  ['9.9', '¥9.9', '短咨询'],
  ['49', '¥49', '半小时'],
  ['99', '¥99', '正式咨询'],
  ['custom', '自定义', '自己输入'],
] as const;
const names: Record<string, string> = {
  mail: '邮件',
  feishu: '飞书',
  deposit: '定金',
  wechat: '微信',
};
const known = Object.keys(names);
const start = known.includes(tool) ? tool : 'mail';
---
<main class="bench" id="bench" data-tool={start}>
  <section class="panel" id="start" aria-label="Mimi">
    <header class="hd">
      <img class="face" src="/mimi/avatar-72.webp" alt="" width="72" height="72"/>
      <p class="who">Mimi</p>
      <p class="status"><i aria-hidden="true"></i><span id="bench-status">{names[start]}</span></p>
    </header>

    <div class="side">
      <h1>你好，我是 Mimi。</h1>
      <div class="chips" role="toolbar">
        <button type="button" data-tool="mail" aria-pressed={start === 'mail' ? 'true' : 'false'}>邮件</button>
        <button type="button" data-tool="feishu" aria-pressed={start === 'feishu' ? 'true' : 'false'}>飞书</button>
        <button type="button" data-tool="deposit" aria-pressed={start === 'deposit' ? 'true' : 'false'}>定金</button>
        <button type="button" data-tool="wechat" aria-pressed={start === 'wechat' ? 'true' : 'false'}>微信<span class="badge">待</span></button>
      </div>
    </div>

    <div class="work">
      <form class="pane" id="pane-mail" action={mailto} method="post" enctype="text/plain" hidden={start !== 'mail'}>
        <div class="fields">
          <label>称呼<input name="称呼" autocomplete="name" required/></label>
          <label>品牌·单位<input name="品牌·单位" autocomplete="organization"/></label>
          <label>邮箱<input name="邮箱" type="email" autocomplete="email" inputmode="email" required/></label>
          <label>方向
            <select name="方向">
              <option value="" selected></option>
              {needs.map((item) => <option value={item}>{item}</option>)}
            </select>
          </label>
          <label class="wide">简述<textarea name="简述" rows="5"></textarea></label>
        </div>
        <div class="send">
          <button class="solid" type="submit">发送</button>
          <a class="quiet" href={mailto}>{email}</a>
        </div>
      </form>

      <div class="pane" id="feishu" hidden={start !== 'feishu'}>
        <button class="mark" type="button" data-zoom="/mimi/feishu-qr.png" data-cap="终树的飞书名片">
          <img src="/mimi/feishu-qr.png" alt="终树的飞书名片" width="431" height="568"/>
        </button>
      </div>

      <div class="pane" id="pane-deposit" hidden={start !== 'deposit'}>
        <div class="tiers" role="group" aria-label="定金">
          {tiers.map(([id, amount, name]) => (
            <button type="button" data-tier={id} data-amount={amount} data-name={name} aria-pressed="false">
              <b>{amount}</b>
              <small>{name}</small>
            </button>
          ))}
        </div>
        <div class="pay" id="pay" hidden>
          <button class="mark" type="button" data-zoom="/consult/pay-qr.png" data-cap="收款码">
            <img src="/consult/pay-qr.png" alt="收款码" width="691" height="691"/>
          </button>
          <div>
            <p class="pay-name" id="pay-name"></p>
            <p class="after">付后 · <a href="#mail">邮件</a>或<a href="#feishu">飞书</a></p>
          </div>
        </div>
      </div>

      <div class="pane" id="wechat" hidden={start !== 'wechat'}>
        <p class="soon">还没有。</p>
      </div>
    </div>
  </section>
</main>

<div class="light" id="bench-light" hidden>
  <img id="bench-light-img" alt="" width="691" height="691"/>
  <button type="button" id="bench-light-x">关闭</button>
</div>

<script is:inline>
  const root = document.getElementById('bench');
  const form = document.getElementById('pane-mail');
  if (root && form) {
    const studio = 'lily1326685527@gmail.com';
    const names = { mail: '邮件', feishu: '飞书', deposit: '定金', wechat: '微信' };
    const buttons = [...root.querySelectorAll('button[data-tool]')];
    const status = document.getElementById('bench-status');
    const panes = {
      mail: form,
      feishu: document.getElementById('feishu'),
      deposit: document.getElementById('pane-deposit'),
      wechat: document.getElementById('wechat'),
    };
    const pay = document.getElementById('pay');
    const payName = document.getElementById('pay-name');
    const light = document.getElementById('bench-light');
    const lightImg = document.getElementById('bench-light-img');

    function hashTool() {
      const h = location.hash.replace('#', '');
      if (h === 'mail' || h === 'feishu' || h === 'deposit' || h === 'wechat') return h;
      if (h === 'start') return 'mail';
      return null;
    }
    function show(name, pushHash) {
      const tool = panes[name] ? name : 'mail';
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.tool === tool ? 'true' : 'false'));
      Object.entries(panes).forEach(([key, el]) => { if (el) el.hidden = key !== tool; });
      if (status) status.textContent = names[tool];
      if (pushHash) {
        const next = '#' + tool;
        if (location.hash !== next) history.replaceState(null, '', next);
      }
    }
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.tool, true)));

    root.querySelectorAll('[data-tier]').forEach((b) => {
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-tier]').forEach((n) => n.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        if (pay) pay.hidden = false;
        if (payName) payName.textContent = b.dataset.amount + ' ' + b.dataset.name;
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('称呼') || '').trim();
      const org = String(data.get('品牌·单位') || '').trim();
      const from = String(data.get('邮箱') || '').trim();
      const need = String(data.get('方向') || '').trim();
      const brief = String(data.get('简述') || '').trim();
      const subject = need ? '合作 · ' + need : '合作';
      const body = [
        '称呼：' + name,
        '品牌·单位：' + (org || '—'),
        '邮箱：' + from,
        '方向：' + (need || '—'),
        '',
        brief,
      ].join('\n');
      location.href = 'mailto:' + studio + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });

    function closeLight() {
      if (!light) return;
      light.hidden = true;
      lightImg?.removeAttribute('src');
    }
    root.querySelectorAll('[data-zoom]').forEach((b) => {
      b.addEventListener('click', () => {
        if (!light || !lightImg) return;
        lightImg.src = b.dataset.zoom;
        lightImg.alt = b.dataset.cap || '';
        light.hidden = false;
        document.getElementById('bench-light-x')?.focus();
      });
    });
    document.getElementById('bench-light-x')?.addEventListener('click', closeLight);
    light?.addEventListener('click', (e) => { if (e.target === light) closeLight(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLight(); });

    const fromHash = hashTool();
    show(fromHash === null ? (root.dataset.tool || 'mail') : fromHash, false);
    window.addEventListener('hashchange', () => {
      const h = hashTool();
      if (h !== null) show(h, false);
    });
  }
</script>

<style>
  .bench {
    width: min(960px, calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    padding: 28px 0 64px;
  }
  .panel {
    display: grid;
    grid-template-columns: 280px 1fr;
    grid-template-rows: auto 1fr;
    min-height: 480px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
  }
  .hd {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 16px;
    border-bottom: 1px solid var(--ink);
  }
  .face {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .who {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .status {
    margin: 0 0 0 auto;
    font-size: 12px;
    letter-spacing: 0.14em;
  }
  .status i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--ink);
    vertical-align: 1px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 22px 16px 16px;
    border-right: 1px solid var(--ink);
  }
  .side h1 {
    margin: 0;
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }
  .chips button,
  .tiers button,
  .solid,
  .light button {
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--sans);
    cursor: pointer;
  }
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .badge {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .chips button:hover,
  .chips button[aria-pressed="true"],
  .tiers button:hover,
  .tiers button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .chips button:hover .badge,
  .chips button[aria-pressed="true"] .badge { color: #fff; }
  .work { padding: 22px 20px 20px; }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
  }
  .wide { grid-column: 1 / -1; }
  label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    margin-top: 6px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.4;
  }
  input,
  select { height: 44px; padding: 0 12px; }
  select {
    appearance: none;
    padding-right: 32px;
    background-image: linear-gradient(45deg, transparent 50%, #1a1a1c 50%), linear-gradient(135deg, #1a1a1c 50%, transparent 50%);
    background-position: calc(100% - 18px) 19px, calc(100% - 12px) 19px;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }
  select:has(option[value=""]:checked) { color: var(--muted); }
  textarea { min-height: 140px; padding: 10px 12px; resize: vertical; }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 16px;
  }
  .solid {
    min-height: 44px;
    padding: 0 22px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.14em;
  }
  .solid:hover { opacity: 0.82; }
  .quiet {
    color: var(--muted);
    font-family: var(--en), var(--sans);
    font-size: 13px;
    letter-spacing: 0;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .quiet:hover { border-bottom-color: var(--muted); }
  .soon,
  .after,
  .pay-name { margin: 0; }
  .after { margin-top: 10px; font-size: 14px; letter-spacing: 0.04em; }
  .after a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .tiers { display: flex; flex-wrap: wrap; gap: 8px; }
  .tiers button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 5.6rem;
    padding: 8px 10px 9px;
    text-align: left;
  }
  .tiers button b {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tiers button small { font-size: 12px; letter-spacing: 0.04em; }
  .mark {
    display: block;
    width: min(200px, 100%);
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    cursor: zoom-in;
  }
  .mark img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  .pay {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px 18px;
    align-items: center;
    margin-top: 16px;
  }
  .pay-name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .soon { font-size: 22px; font-weight: 600; letter-spacing: -0.03em; }
  .pay[hidden],
  .pane[hidden],
  .light[hidden] { display: none !important; }
  .light {
    position: fixed;
    inset: 0;
    z-index: 220;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    background: #fff;
  }
  .light img {
    width: auto;
    max-width: min(440px, 88vw);
    max-height: 78vh;
    height: auto;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
  }
  .light button {
    min-width: 88px;
    min-height: 40px;
    padding: 8px 16px;
    font-size: 14px;
    letter-spacing: 0.12em;
  }
  @media (max-width: 720px) {
    .bench { width: calc(100% - 2 * var(--gutter)); padding-top: 16px; }
    .panel { grid-template-columns: 1fr; min-height: 0; }
    .side { gap: 16px; border-right: 0; border-bottom: 1px solid var(--ink); }
    .side h1 { font-size: 26px; }
    .chips { margin-top: 0; }
    .fields, .pay { grid-template-columns: 1fr; }
    .wide { grid-column: auto; }
  }
</style>
<style is:global>
  body:has(#bench),
  body:has(#bench) header.top.top--home,
  body:has(#bench) header.top.top--home.top--page,
  body:has(#bench) header.top.top--home.is-shown,
  body:has(#bench) .top--home nav,
  body:has(#bench) footer.bot {
    background: #fff;
  }
  body:has(#bench) #mimi { display: none !important; }
  body:has(#bench) footer.bot { padding-bottom: 28px; }
</style>
