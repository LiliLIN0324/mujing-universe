---
/**
 * 合作工作台壳：只保留合作页的版面骨架与文案，对话本体是 MimiChat（variant="bench"）——
 * 与全站浮层小窗（variant="panel"）同一实现、同一会话（sessionStorage 'mimi-session-v1'）、
 * 同一内容：chips / CTA / IM 列表 / 输入行逐项一致。
 * 邮件表单卡 / 飞书名片卡 / 微信卡由对话框在 log 内渲染（#mail / #feishu / #wechat 落地对应卡片）。
 * 邮件走 mailto，飞书是名片二维码。不收款。
 */
import MimiChat from './MimiChat.astro';
const email = 'lily1326685527@gmail.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent('合作')}`;
---
<main class="bench" id="bench">
  <h1 class="title">你好，我是 Mimi。</h1>
  <MimiChat variant="bench" />
  <noscript><p class="noscript"><a href={mailto}>{email}</a></p></noscript>
</main>

<style>
  .bench {
    width: min(960px, calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    padding: 12px 0;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .title {
    margin: 0;
    padding: 12px 2px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .noscript { margin: 0; padding: 10px 2px; }
  .noscript a {
    color: var(--muted);
    font-family: var(--en), var(--sans);
    font-size: 13px;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .noscript a:hover { border-bottom-color: var(--muted); }
  @media (max-width: 720px) {
    .bench { padding-top: 8px; }
    .title { font-size: 20px; }
  }
</style>
<style is:global>
  html:has(#bench),
  body:has(#bench) {
    height: 100%;
    overflow: hidden;
    background: var(--bg);
  }
  body:has(#bench) {
    display: flex;
    flex-direction: column;
  }
  body:has(#bench) header.top { flex: none; }
  body:has(#bench) #content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  body:has(#bench),
  body:has(#bench) header.top.top--home,
  body:has(#bench) header.top.top--home.top--page,
  body:has(#bench) header.top.top--home.is-shown,
  body:has(#bench) .top--home nav,
  body:has(#bench) footer.bot {
    background: var(--bg);
  }
  body:has(#bench) footer.bot { flex: none; padding-top: 12px; padding-bottom: 12px; }
</style>
