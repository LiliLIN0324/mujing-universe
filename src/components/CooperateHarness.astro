---
/**
 * 合作工作台。定金码是 public/consult/alipay-qr.png 裁出的可扫区域，
 * 见 public/consult/pay-qr.png。不接支付接口。
 */
const { tool = '' } = Astro.props;
const email = 'lily1326685527@gmail.com';
const mailto = `mailto:${email}`;
const alipay = 'https://qr.alipay.com/tsx13075wejgikstvu1cv5d';
const subjects = [
  ['古画', '古画'],
  ['民乐音画', '民乐音画'],
  ['展览 · 委托', '展览委托'],
] as const;
const tiers = [
  ['1', '¥1', '试收款', '同一张码。在支付宝里选 ¥1。'],
  ['9.9', '¥9.9', '短咨询', '同一张码。在支付宝里选 ¥9.9。'],
  ['49', '¥49', '半小时', '同一张码。在支付宝里选 ¥49。'],
  ['99', '¥99', '正式咨询', '同一张码。在支付宝里选 ¥99。'],
  ['custom', '自定义', '自己输入', '扫码后在支付宝里输入金额。'],
] as const;
const lines: Record<string, string> = {
  '': '写邮件、看名片，或付定金。',
  mail: '邮件到这。',
  feishu: '名片在这。',
  deposit: '选一档。扫码后邮件或飞书找我们排期。',
  wechat: '微信号在这。',
};
const names: Record<string, string> = {
  '': '就绪',
  mail: '写邮件',
  feishu: '飞书',
  deposit: '定金',
  wechat: '微信',
};
const start = tool in lines ? tool : '';
---
<main class="bench" id="bench" data-tool={start}>
  <section class="panel" id="start" aria-label="Mimi 合作">
    <header class="hd">
      <img class="face" src="/mimi/avatar-72.webp" alt="" width="72" height="72"/>
      <div class="who">
        <h1>Mimi</h1>
        <p>合作</p>
      </div>
      <p class="status"><i aria-hidden="true"></i><span id="bench-status">{names[start]}</span></p>
    </header>

    <div class="side">
      <div class="log">
        <p class="sys"><span class="tag">系统</span>选一个动作。</p>
        <p class="asst"><span class="tag">Mimi</span><span id="bench-asst">{lines[start]}</span></p>
      </div>
      <div class="tools" role="toolbar" aria-label="动作">
        <button type="button" data-tool="mail" data-line={lines.mail} aria-pressed={start === 'mail' ? 'true' : 'false'}>写邮件</button>
        <button type="button" data-tool="feishu" data-line={lines.feishu} aria-pressed={start === 'feishu' ? 'true' : 'false'}>飞书</button>
        <button type="button" data-tool="deposit" data-line={lines.deposit} aria-pressed={start === 'deposit' ? 'true' : 'false'}>定金</button>
        <button type="button" data-tool="wechat" data-line={lines.wechat} aria-pressed={start === 'wechat' ? 'true' : 'false'}>微信</button>
      </div>
    </div>

    <div class="out">
      <p class="tag out-tag">结果 <span id="bench-out-name">{start ? `· ${names[start]}` : ''}</span></p>
      <p class="idle" id="pane-empty" hidden={start !== ''}>未选择动作。</p>

      <div class="pane" id="pane-mail" hidden={start !== 'mail'}>
        <a class="addr" href={mailto}>{email}</a>
        <p class="acts"><a class="solid" href={mailto}>写邮件</a></p>
        <p class="kinds">
          <span>主题</span>
          {subjects.map(([label, subject]) => (
            <a href={`${mailto}?subject=${encodeURIComponent(subject)}`}>{label}</a>
          ))}
        </p>
      </div>

      <div class="pane" id="feishu" hidden={start !== 'feishu'}>
        <button class="mark" type="button" data-zoom="/mimi/feishu-qr.png" data-cap="终树的飞书名片">
          <img src="/mimi/feishu-qr.png" alt="终树的飞书名片" width="431" height="568"/>
        </button>
        <p class="hint">点按放大</p>
      </div>

      <div class="pane" id="pane-deposit" hidden={start !== 'deposit'}>
        <div class="tiers" role="group" aria-label="定金档位">
          {tiers.map(([id, amount, name, note]) => (
            <button type="button" data-tier={id} data-amount={amount} data-name={name} data-note={note} aria-pressed="false">
              <b>{amount}</b>
              <small>{name}</small>
            </button>
          ))}
        </div>
        <div class="pay" id="pay" hidden>
          <button class="mark" type="button" data-zoom="/consult/pay-qr.png" data-cap="收款码">
            <img src="/consult/pay-qr.png" alt="收款码" width="691" height="691"/>
          </button>
          <div>
            <p class="pay-name" id="pay-name"></p>
            <p class="hint">点按放大</p>
            <p class="after">付后<a href={mailto}>发邮件</a>或<a href="#feishu">飞书</a>，我们排期。</p>
            <p class="fine">人工对账。</p>
            <p class="fine"><a href={alipay}>用支付宝打开</a></p>
          </div>
        </div>
        <noscript>
          <img class="fallback" src="/consult/pay-qr.png" alt="收款码" width="691" height="691"/>
          <p>扫码后在支付宝里输入金额。付后发邮件或飞书排期。人工对账。</p>
        </noscript>
      </div>

      <div class="pane" id="wechat" hidden={start !== 'wechat'}>
        <p class="wx" id="wx-id">endTree-26</p>
        <p class="acts"><button class="ghost" type="button" id="copy-wx">复制</button></p>
      </div>
    </div>
  </section>
</main>

<div class="light" id="bench-light" hidden>
  <img id="bench-light-img" alt="" width="691" height="691"/>
  <button type="button" id="bench-light-x">关闭</button>
</div>

<script is:inline>
  const root = document.getElementById('bench');
  if (root) {
    const statusNames = { mail: '写邮件', feishu: '飞书', deposit: '定金', wechat: '微信' };
    const buttons = [...root.querySelectorAll('[data-tool]')];
    const lines = {};
    buttons.forEach((b) => { lines[b.dataset.tool] = b.dataset.line; });
    const asst = document.getElementById('bench-asst');
    const status = document.getElementById('bench-status');
    const outName = document.getElementById('bench-out-name');
    const empty = document.getElementById('pane-empty');
    const panes = {
      mail: document.getElementById('pane-mail'),
      feishu: document.getElementById('feishu'),
      deposit: document.getElementById('pane-deposit'),
      wechat: document.getElementById('wechat'),
    };
    const pay = document.getElementById('pay');
    const payName = document.getElementById('pay-name');
    const light = document.getElementById('bench-light');
    const lightImg = document.getElementById('bench-light-img');

    function hashTool() {
      const h = location.hash.replace('#', '');
      if (h === 'mail' || h === 'feishu' || h === 'deposit' || h === 'wechat') return h;
      if (h === 'start') return '';
      return null;
    }
    function mark(tool) {
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.tool === tool ? 'true' : 'false'));
      Object.entries(panes).forEach(([key, el]) => { if (el) el.hidden = key !== tool; });
      if (empty) empty.hidden = !!tool;
      const label = statusNames[tool] || '就绪';
      if (status) status.textContent = label;
      if (outName) outName.textContent = tool ? '· ' + label : '';
    }
    function show(name, pushHash) {
      const tool = panes[name] ? name : '';
      mark(tool);
      if (asst) asst.textContent = (tool && lines[tool]) || '写邮件、看名片，或付定金。';
      if (pushHash) {
        const next = tool ? '#' + tool : '';
        if (location.hash !== next) history.replaceState(null, '', next || location.pathname);
      }
    }
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.tool, true)));
    root.querySelectorAll('[data-tier]').forEach((b) => {
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-tier]').forEach((n) => n.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        if (pay) pay.hidden = false;
        if (payName) payName.textContent = b.dataset.amount + ' ' + b.dataset.name;
        if (asst) asst.textContent = b.dataset.note || lines.deposit;
        if (status) status.textContent = b.dataset.amount;
        if (outName) outName.textContent = '· ' + b.dataset.amount;
      });
    });

    const copy = document.getElementById('copy-wx');
    function copyId() {
      const ta = document.createElement('textarea');
      ta.value = 'endTree-26';
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '0';
      ta.style.left = '0';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.focus();
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
      return ok;
    }
    copy?.addEventListener('click', () => {
      const finish = (ok) => {
        copy.textContent = ok ? '已复制' : '请长按微信号复制';
        window.setTimeout(() => { copy.textContent = '复制'; }, 1600);
      };
      if (copyId()) { finish(true); return; }
      if (navigator.clipboard && window.isSecureContext) {
        const timer = window.setTimeout(() => finish(false), 500);
        navigator.clipboard.writeText('endTree-26').then(() => {
          window.clearTimeout(timer);
          finish(true);
        }).catch(() => {
          window.clearTimeout(timer);
          finish(false);
        });
        return;
      }
      finish(false);
    });

    function closeLight() {
      if (!light) return;
      light.hidden = true;
      lightImg?.removeAttribute('src');
    }
    root.querySelectorAll('[data-zoom]').forEach((b) => {
      b.addEventListener('click', () => {
        if (!light || !lightImg) return;
        lightImg.src = b.dataset.zoom;
        lightImg.alt = b.dataset.cap || '';
        light.hidden = false;
        document.getElementById('bench-light-x')?.focus();
      });
    });
    document.getElementById('bench-light-x')?.addEventListener('click', closeLight);
    light?.addEventListener('click', (e) => { if (e.target === light) closeLight(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLight(); });

    const fromHash = hashTool();
    show(fromHash === null ? (root.dataset.tool || '') : fromHash, false);
    window.addEventListener('hashchange', () => {
      const h = hashTool();
      if (h !== null) show(h, false);
    });
  }
</script>

<style>
  .bench {
    width: min(880px, calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    padding: 28px 0 64px;
  }
  .panel {
    display: grid;
    grid-template-columns: 280px 1fr;
    grid-template-rows: auto 1fr;
    min-height: 520px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
  }
  .hd {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--ink);
  }
  .face {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border: 1px solid var(--ink);
    border-radius: 0;
    flex: none;
  }
  .who h1 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .who p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.16em;
    line-height: 1.2;
  }
  .status {
    margin: 0 0 0 auto;
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1;
  }
  .status i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--ink);
    vertical-align: 1px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 16px;
    border-right: 1px solid var(--ink);
  }
  .log { display: flex; flex-direction: column; gap: 14px; }
  .sys, .asst, .idle, .after, .fine, .hint, .pay-name, .kinds { margin: 0; }
  .tag {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.2;
  }
  .sys, .asst { font-size: 15px; line-height: 1.45; }
  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: auto;
  }
  .tools button,
  .tiers button,
  .ghost,
  .solid,
  .light button {
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--sans);
    cursor: pointer;
  }
  .tools button {
    min-height: 44px;
    padding: 8px 10px;
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .tools button:hover,
  .tools button[aria-pressed="true"],
  .tiers button:hover,
  .tiers button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .out { padding: 16px 18px 20px; }
  .out-tag { margin-bottom: 14px; }
  .idle { font-size: 15px; }
  .addr {
    font-family: var(--en), var(--sans);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .acts { margin: 14px 0 0; }
  .solid {
    display: inline-flex;
    align-items: center;
    padding: 12px 18px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
  }
  .solid:hover { opacity: 0.82; }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin-top: 16px;
  }
  .kinds span { color: var(--muted); font-size: 12px; letter-spacing: 0.14em; }
  .kinds a,
  .after a,
  .fine a {
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .mark {
    display: block;
    width: min(200px, 100%);
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    cursor: zoom-in;
  }
  .mark img,
  .fallback {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  .fallback { width: min(200px, 100%); margin-top: 12px; border: 1px solid var(--ink); }
  .hint, .fine { margin-top: 8px; color: var(--muted); font-size: 13px; letter-spacing: 0.04em; }
  .tiers { display: flex; flex-wrap: wrap; gap: 8px; }
  .tiers button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 5.6rem;
    padding: 8px 10px 9px;
    text-align: left;
  }
  .tiers button b {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tiers button small { font-size: 12px; letter-spacing: 0.04em; }
  .pay {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px 18px;
    align-items: start;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .pay-name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .after { margin-top: 10px; font-size: 15px; line-height: 1.5; }
  .wx {
    margin: 0;
    font-family: var(--en), var(--sans);
    font-size: 22px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .ghost {
    padding: 8px 14px;
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .ghost:hover { background: var(--ink); color: #fff; }
  .light {
    position: fixed;
    inset: 0;
    z-index: 220;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    background: #fff;
  }
  .pay[hidden],
  .pane[hidden],
  .idle[hidden],
  .light[hidden] { display: none !important; }
  .light img {
    width: auto;
    max-width: min(440px, 88vw);
    max-height: 78vh;
    height: auto;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
  }
  .light button {
    min-width: 88px;
    padding: 10px 16px;
    font-size: 14px;
    letter-spacing: 0.12em;
  }
  @media (max-width: 720px) {
    .bench { width: calc(100% - 2 * var(--gutter)); padding-top: 16px; }
    .panel { grid-template-columns: 1fr; min-height: 0; }
    .side { border-right: 0; border-bottom: 1px solid var(--ink); }
    .tools { margin-top: 0; }
    .pay { grid-template-columns: 1fr; }
    .addr, .wx, .pay-name { font-size: 18px; }
  }
</style>
<style is:global>
  body:has(#bench),
  body:has(#bench) header.top.top--home,
  body:has(#bench) header.top.top--home.top--page,
  body:has(#bench) header.top.top--home.is-shown,
  body:has(#bench) .top--home nav,
  body:has(#bench) footer.bot {
    background: #fff;
  }
  body:has(#bench) #mimi { display: none !important; }
  body:has(#bench) footer.bot { padding-bottom: 28px; }
</style>
