---
/**
 * 合作工作台。对话走现有 /api/chat。
 * 邮件走 mailto，定金码 public/consult/pay-qr.png。无支付接口。
 */
const { tool = '' } = Astro.props;
const email = 'lily1326685527@gmail.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent('合作')}`;
const needs = ['古画', '民乐音画', '展览 · 委托'] as const;
const tiers = [
  ['1', '¥1', '试收款'],
  ['9.9', '¥9.9', '短咨询'],
  ['49', '¥49', '半小时'],
  ['99', '¥99', '正式咨询'],
  ['custom', '自定义', '自己输入'],
] as const;
const names: Record<string, string> = {
  mail: '邮件',
  feishu: '飞书',
  deposit: '定金',
  wechat: '微信',
};
const known = Object.keys(names);
const start = known.includes(tool) ? tool : '';
---
<main class="bench" id="bench" data-tool={start} data-state="idle">
  <section class="panel" id="start" aria-label="Mimi">
    <header class="hd">
      <span class="face-wrap">
        <img class="face" src="/mimi/avatar-72.webp" alt="" width="72" height="72"/>
        <span class="face-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
      <p class="who">Mimi</p>
      <p class="status"><i aria-hidden="true"></i><span id="bench-status">{start ? names[start] : 'Mimi'}</span><span class="demo" id="bench-demo" hidden>未接通</span></p>
    </header>

    <div class="work">
      <h1>你好，我是 Mimi。</h1>
      <div class="log" id="bench-log" role="log" aria-live="polite" aria-relevant="additions">
        <div class="msg bot"><p>你好，我是 Mimi。</p></div>

        <form class="card" id="pane-mail" action={mailto} method="post" enctype="text/plain" hidden={start !== 'mail'}>
          <div class="fields">
            <label>称呼<input name="称呼" autocomplete="name" required/></label>
            <label>品牌·单位<input name="品牌·单位" autocomplete="organization"/></label>
            <label>邮箱<input name="邮箱" type="email" autocomplete="email" inputmode="email" required/></label>
            <label>方向
              <select name="方向">
                <option value="" selected></option>
                {needs.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label class="wide">简述<textarea name="简述" rows="4"></textarea></label>
          </div>
          <div class="send">
            <button class="solid" type="submit">发送</button>
            <a class="quiet" href={mailto}>{email}</a>
          </div>
        </form>

        <div class="card" id="feishu" hidden={start !== 'feishu'}>
          <button class="mark" type="button" data-zoom="/mimi/feishu-qr.png" data-cap="终树的飞书名片">
            <img src="/mimi/feishu-qr.png" alt="终树的飞书名片" width="431" height="568"/>
          </button>
        </div>

        <div class="card" id="pane-deposit" hidden={start !== 'deposit'}>
          <div class="tiers" role="group" aria-label="定金">
            {tiers.map(([id, amount, name]) => (
              <button type="button" data-tier={id} data-amount={amount} data-name={name} aria-pressed="false">
                <b>{amount}</b>
                <small>{name}</small>
              </button>
            ))}
          </div>
          <div class="pay" id="pay" hidden>
            <button class="mark" type="button" data-zoom="/consult/pay-qr.png" data-cap="收款码">
              <img src="/consult/pay-qr.png" alt="收款码" width="691" height="691"/>
            </button>
            <div>
              <p class="pay-name" id="pay-name"></p>
              <p class="after">付后 · <a href="#mail">邮件</a>或<a href="#feishu">飞书</a></p>
            </div>
          </div>
        </div>

        <div class="card" id="wechat" hidden={start !== 'wechat'}>
          <p class="soon">还没有。</p>
        </div>
      </div>

      <div class="dock">
        <div class="chips" role="toolbar">
          <button type="button" data-tool="mail" aria-pressed={start === 'mail' ? 'true' : 'false'}>邮件</button>
          <button type="button" data-tool="feishu" aria-pressed={start === 'feishu' ? 'true' : 'false'}>飞书</button>
          <button type="button" data-tool="deposit" aria-pressed={start === 'deposit' ? 'true' : 'false'}>定金</button>
          <button type="button" data-tool="wechat" aria-pressed={start === 'wechat' ? 'true' : 'false'}>微信<span class="badge">待</span></button>
        </div>
        <form class="say" id="bench-say">
          <label class="sr" for="bench-input">跟 Mimi 说</label>
          <textarea id="bench-input" name="q" rows="1" maxlength="400" enterkeyhint="send"></textarea>
          <button type="submit">发送</button>
        </form>
      </div>
      <noscript><p class="noscript"><a href={mailto}>{email}</a></p></noscript>
    </div>
  </section>
</main>

<div class="light" id="bench-light" hidden>
  <img id="bench-light-img" alt="" width="691" height="691"/>
  <button type="button" id="bench-light-x">关闭</button>
</div>

<script>
  import { linkify, requestReply } from '../scripts/mimi-core.js';

  const root = document.getElementById('bench');
  const log = document.getElementById('bench-log');
  const say = document.getElementById('bench-say');
  const input = document.getElementById('bench-input');
  const form = document.getElementById('pane-mail');
  if (root && log && say && input && form) {
    const studio = 'lily1326685527@gmail.com';
    const names = { mail: '邮件', feishu: '飞书', deposit: '定金', wechat: '微信' };
    const buttons = [...root.querySelectorAll('button[data-tool]')];
    const status = document.getElementById('bench-status');
    const demoNote = document.getElementById('bench-demo');
    const sendBtn = say.querySelector('button');
    const panes = {
      mail: form,
      feishu: document.getElementById('feishu'),
      deposit: document.getElementById('pane-deposit'),
      wechat: document.getElementById('wechat'),
    };
    const pay = document.getElementById('pay');
    const payName = document.getElementById('pay-name');
    const light = document.getElementById('bench-light');
    const lightImg = document.getElementById('bench-light-img');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const turns = [];
    let demo = false;
    let busy = false;
    let typer = 0;

    function hashTool() {
      const h = location.hash.replace('#', '');
      if (h === 'mail' || h === 'feishu' || h === 'deposit' || h === 'wechat') return h;
      if (h === 'start') return '';
      return null;
    }
    function reveal(name, pushHash) {
      const el = panes[name];
      if (!el) return;
      const wasHidden = el.hidden;
      el.hidden = false;
      if (wasHidden) log.append(el);
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.tool === name ? 'true' : 'false'));
      if (status) status.textContent = names[name];
      root.dataset.tool = name;
      if (pushHash) {
        const next = '#' + name;
        if (location.hash !== next) history.replaceState(null, '', next);
      }
      if (wasHidden || pushHash) el.scrollIntoView({ block: 'nearest' });
    }
    buttons.forEach((b) => b.addEventListener('click', () => reveal(b.dataset.tool, true)));

    root.querySelectorAll('[data-tier]').forEach((b) => {
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-tier]').forEach((n) => n.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        if (pay) pay.hidden = false;
        if (payName) payName.textContent = b.dataset.amount + ' ' + b.dataset.name;
        pay?.scrollIntoView({ block: 'nearest' });
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('称呼') || '').trim();
      const org = String(data.get('品牌·单位') || '').trim();
      const from = String(data.get('邮箱') || '').trim();
      const need = String(data.get('方向') || '').trim();
      const brief = String(data.get('简述') || '').trim();
      const subject = need ? '合作 · ' + need : '合作';
      const body = [
        '称呼：' + name,
        '品牌·单位：' + (org || '—'),
        '邮箱：' + from,
        '方向：' + (need || '—'),
        '',
        brief,
      ].join('\n');
      location.href = 'mailto:' + studio + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });

    function closeLight() {
      if (!light) return;
      light.hidden = true;
      lightImg?.removeAttribute('src');
    }
    root.querySelectorAll('[data-zoom]').forEach((b) => {
      b.addEventListener('click', () => {
        if (!light || !lightImg) return;
        lightImg.src = b.dataset.zoom;
        lightImg.alt = b.dataset.cap || '';
        light.hidden = false;
        document.getElementById('bench-light-x')?.focus();
      });
    });
    document.getElementById('bench-light-x')?.addEventListener('click', closeLight);
    light?.addEventListener('click', (e) => { if (e.target === light) closeLight(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && light && !light.hidden) closeLight(); });

    function setState(next) {
      root.dataset.state = next;
      if (sendBtn) sendBtn.disabled = busy;
    }
    function pin() {
      log.scrollTop = log.scrollHeight;
    }
    function fitInput() {
      input.style.height = '44px';
      input.style.height = Math.min(120, input.scrollHeight) + 'px';
    }
    let waitEl = null;
    let offlineNoted = false;
    function showWait() {
      waitEl?.remove();
      waitEl = document.createElement('div');
      waitEl.className = 'msg bot is-wait';
      waitEl.setAttribute('role', 'status');
      const p = document.createElement('p');
      p.className = 'dots';
      p.setAttribute('aria-label', 'Mimi');
      for (let i = 0; i < 3; i += 1) p.append(document.createElement('i'));
      waitEl.append(p);
      log.append(waitEl);
      pin();
    }
    function clearWait() {
      waitEl?.remove();
      waitEl = null;
    }
    function finishText(p, text, done) {
      p.replaceChildren();
      if (text) linkify(p, text);
      pin();
      if (done) done();
    }
    function typewrite(p, text, done) {
      window.clearInterval(typer);
      if (reduce || !text) {
        finishText(p, text, done);
        return;
      }
      const shown = text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
      let i = 0;
      const step = shown.length > 70 ? 2 : 1;
      typer = window.setInterval(() => {
        i = Math.min(shown.length, i + step);
        p.textContent = shown.slice(0, i);
        pin();
        if (i >= shown.length) {
          window.clearInterval(typer);
          finishText(p, text, done);
        }
      }, 18);
    }
    function append(role, text, typed = true, done) {
      const item = document.createElement('div');
      item.className = `msg ${role === 'user' ? 'user' : 'bot'}`;
      const p = document.createElement('p');
      item.append(p);
      log.append(item);
      if (role === 'user') p.textContent = text;
      else if (typed) typewrite(p, text, done);
      else finishText(p, text, done);
      pin();
      return item;
    }
    function settle() {
      busy = false;
      setState('idle');
    }
    function noteOffline() {
      demo = true;
      if (demoNote) demoNote.hidden = false;
      if (offlineNoted) return;
      offlineNoted = true;
      append('bot', '未接通。', false);
    }
    function showFail(text) {
      clearWait();
      const item = document.createElement('div');
      item.className = 'msg bot is-fail';
      const p = document.createElement('p');
      p.textContent = text;
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'retry';
      retry.textContent = '重试';
      item.append(p, retry);
      log.append(item);
      pin();
      retry.addEventListener('click', () => {
        item.remove();
        const last = [...turns].reverse().find((t) => t.role === 'user');
        settle();
        if (last) ask(last.content, true);
      });
      settle();
      setState('error');
    }

    async function ask(text, retrying = false) {
      const q = String(text || '').trim().slice(0, 400);
      if (!q || busy) return;
      busy = true;
      window.clearInterval(typer);
      if (!retrying) {
        append('user', q);
        turns.push({ role: 'user', content: q });
        input.value = '';
        fitInput();
      }
      setState('thinking');
      showWait();
      const t0 = performance.now();
      let bubble = null;
      const result = await requestReply({
        messages: turns,
        demo,
        onDelta(shown) {
          if (!bubble) {
            clearWait();
            setState('answering');
            const item = document.createElement('div');
            item.className = 'msg bot';
            bubble = document.createElement('p');
            item.append(bubble);
            log.append(item);
          }
          bubble.textContent = shown;
          pin();
        },
      });
      if (result.threw && bubble?.parentElement) {
        bubble.parentElement.remove();
        bubble = null;
      }
      if (result.demo) {
        const hold = 280 - (performance.now() - t0);
        if (hold > 0) await new Promise((r) => setTimeout(r, hold));
        clearWait();
        noteOffline();
        settle();
        return;
      }
      const { reply, showCoop, failed } = result;
      const streamed = result.threw ? false : result.streamed;
      const after = () => {
        if (showCoop) reveal('feishu', false);
        settle();
      };
      if (failed) {
        if (bubble?.parentElement) bubble.parentElement.remove();
        showFail(/歇/.test(reply) ? '稍后再问。' : '没发出去。');
        return;
      }
      if (!streamed) {
        const hold = (reduce ? 280 : 520) - (performance.now() - t0);
        if (hold > 0) await new Promise((r) => setTimeout(r, hold));
        clearWait();
      }
      if (streamed && bubble) finishText(bubble, reply, after);
      else {
        clearWait();
        setState('answering');
        append('bot', reply, true, after);
      }
      turns.push({ role: 'assistant', content: reply });
    }

    say.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.shiftKey || e.isComposing || e.keyCode === 229) return;
      e.preventDefault();
      say.requestSubmit();
    });
    input.addEventListener('input', fitInput);

    const fromHash = hashTool();
    const initial = fromHash === null ? (root.dataset.tool || '') : fromHash;
    if (initial) reveal(initial, false);
    window.addEventListener('hashchange', () => {
      const h = hashTool();
      if (h) reveal(h, false);
      else if (h === '') input.focus();
    });
  }
</script>

<style>
  .bench {
    width: min(960px, calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    padding: 12px 0;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
  }
  .hd {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 16px;
    border-bottom: 1px solid var(--ink);
  }
  .face-wrap {
    position: relative;
    width: 28px;
    height: 28px;
    flex: none;
    border: 0;
    border-radius: 50%;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
  }
  .face {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    box-shadow: none;
  }
  .face-dots {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 1px;
    transform: translateX(-50%);
    gap: 2px;
    padding: 2px 3px;
    background: rgba(26, 26, 28, 0.78);
  }
  .bench[data-state="thinking"] .face-dots { display: flex; }
  .face-dots i {
    width: 3px;
    height: 3px;
    background: #fff;
    animation: bench-dot 1s infinite;
  }
  .face-dots i:nth-child(2) { animation-delay: 0.15s; }
  .face-dots i:nth-child(3) { animation-delay: 0.3s; }
  .who {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .status {
    margin: 0 0 0 auto;
    font-size: 12px;
    letter-spacing: 0.14em;
  }
  .status i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--ink);
    vertical-align: 1px;
  }
  .bench[data-state="thinking"] .status i {
    animation: bench-pulse 0.9s steps(2, end) infinite;
  }
  .demo { margin-left: 10px; color: var(--muted); letter-spacing: 0.08em; }
  .work h1 {
    margin: 0;
    padding: 16px 18px 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips button,
  .tiers button,
  .solid,
  .say button,
  .light button {
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--sans);
    cursor: pointer;
  }
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .badge {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .chips button:hover,
  .chips button[aria-pressed="true"],
  .tiers button:hover,
  .tiers button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .chips button:hover .badge,
  .chips button[aria-pressed="true"] .badge { color: #fff; }
  .work {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    background: #fff;
  }
  .log {
    flex: 1;
    min-height: 0;
    overflow: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px 12px;
  }
  .dock {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--ink);
    background: #fff;
  }
  .card {
    align-self: stretch;
    width: 100%;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    padding: 14px;
  }
  .say {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .say textarea {
    flex: 1;
    width: auto;
    min-width: 0;
    height: 44px;
    min-height: 44px;
    max-height: 120px;
    margin: 0;
    padding: 10px 12px;
    resize: none;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
  }
  .say button {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.14em;
  }
  .say button:disabled { opacity: 0.45; cursor: default; }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
  }
  .wide { grid-column: 1 / -1; }
  label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    margin-top: 6px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .say textarea { width: auto; margin-top: 0; }
  .say .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .fields input,
  select { height: 44px; padding: 0 12px; }
  select {
    appearance: none;
    padding-right: 32px;
    background-image: linear-gradient(45deg, transparent 50%, #1a1a1c 50%), linear-gradient(135deg, #1a1a1c 50%, transparent 50%);
    background-position: calc(100% - 18px) 19px, calc(100% - 12px) 19px;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }
  select:has(option[value=""]:checked) { color: var(--muted); }
  textarea { min-height: 96px; padding: 10px 12px; resize: vertical; }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 16px;
  }
  .solid {
    min-height: 44px;
    padding: 0 22px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.14em;
  }
  .solid:hover,
  .say button:hover { opacity: 0.82; }
  .quiet,
  .noscript a {
    color: var(--muted);
    font-family: var(--en), var(--sans);
    font-size: 13px;
    letter-spacing: 0;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .quiet:hover,
  .noscript a:hover { border-bottom-color: var(--muted); }
  .noscript { margin: 0; padding: 0 16px 16px; }
  .soon,
  .after,
  .pay-name { margin: 0; }
  .after { margin-top: 10px; font-size: 14px; letter-spacing: 0.04em; }
  .after a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .tiers { display: flex; flex-wrap: wrap; gap: 8px; }
  .tiers button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 5.6rem;
    padding: 8px 10px 9px;
    text-align: left;
  }
  .tiers button b {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tiers button small { font-size: 12px; letter-spacing: 0.04em; }
  .mark {
    display: block;
