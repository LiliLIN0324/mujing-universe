---
/** 全站 Mimi。不自动打开面板。头像动画只在 public/mimi/mimi.riv 的状态机里，没有文件就停在静态头像。密钥不在这里。 */
const srcset = '/mimi/avatar-72.webp 72w, /mimi/avatar-144.webp 144w, /mimi/avatar-216.webp 216w, /mimi/avatar.webp 357w';
const mail = 'mailto:lily1326685527@gmail.com';
---
<div class="mimi" id="mimi" data-state="idle" data-motion="idle" data-side="right">
  <button class="mimi-launch" type="button" aria-expanded="false" aria-controls="mimi-panel" aria-label="打开 Mimi 对话">
    <span class="mimi-halo" aria-hidden="true"></span>
    <span class="mimi-face">
      <canvas class="mimi-rive" width="144" height="144" hidden aria-hidden="true"></canvas>
      <picture class="mimi-still">
        <source type="image/webp" srcset={srcset} sizes="(max-width: 768px) 60px, 72px" />
        <img src="/mimi/avatar.png" alt="" width="72" height="72" decoding="async" draggable="false" />
      </picture>
      <span class="mimi-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </span>
    <span class="mimi-hi" role="tooltip">嗨，我是 Mimi，带你随便看看。</span>
  </button>
  <section class="mimi-panel" id="mimi-panel" role="dialog" aria-modal="false" aria-labelledby="mimi-name" hidden>
    <header class="mimi-hd">
      <span class="mimi-face">
        <picture>
          <source type="image/webp" srcset={srcset} sizes="44px" />
          <img src="/mimi/avatar.png" alt="" width="44" height="44" decoding="async" draggable="false" />
        </picture>
        <span class="mimi-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
      <div class="mimi-id">
        <strong id="mimi-name">Mimi</strong>
        <p class="mimi-demo">演示</p>
      </div>
      <button class="mimi-x" type="button" aria-label="关闭对话">×</button>
    </header>
    <div class="mimi-log" role="log" aria-live="polite" aria-relevant="additions"></div>
    <div class="mimi-quick" role="group" aria-label="快捷问题">
      <button type="button">作品在做什么</button>
      <button type="button">怎么合作</button>
      <button type="button">怎么找到你们</button>
    </div>
    <div class="mimi-cta">
      <button class="mimi-feishu" type="button">看飞书名片</button>
      <a class="mimi-mail" href={mail}>写邮件</a>
    </div>
    <form class="mimi-form">
      <label class="mimi-sr" for="mimi-input">输入问题</label>
      <input id="mimi-input" name="q" maxlength="400" autocomplete="off" enterkeyhint="send" placeholder="想了解幕景，直接问我" />
      <button class="mimi-send" type="submit">发送</button>
    </form>
    <p class="mimi-foot">合作请自己加飞书。</p>
  </section>
</div>

<style>
  .mimi { --safe-b: env(safe-area-inset-bottom, 0px); }
  .mimi-launch,
  .mimi-panel {
    position: fixed;
    z-index: 160;
    font-family: "Alibaba PuHuiTi 3.0", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  }
  .mimi-launch {
    right: 22px;
    bottom: 22px;
    z-index: 162;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    cursor: grab;
    touch-action: none;
    perspective: 240px;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }
  .mimi-launch.is-drag { cursor: grabbing; }
  .mimi-launch.is-drag .mimi-face {
    box-shadow: inset 0 0 0 1px #1a1a1c;
  }
  .mimi-launch.is-hot .mimi-face {
    box-shadow: inset 0 0 0 1px #1a1a1c;
  }
  .mimi-halo {
    position: absolute;
    inset: -7px;
    border-radius: 0;
    border: 2px solid transparent;
    border-top-color: #1a1a1c;
    border-right-color: #1a1a1c;
    opacity: 0;
    pointer-events: none;
  }
  .mimi[data-state="thinking"] .mimi-halo {
    opacity: 1;
    animation: mimi-spin 0.9s linear infinite;
  }
  .mimi-launch.is-flash .mimi-halo {
    opacity: 1;
    border-color: #1a1a1c;
    animation: mimi-flash 0.45s ease-out;
  }
  .mimi-face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    overflow: hidden;
    background: #1a1a1c;
    box-shadow: inset 0 0 0 1px #1a1a1c;
    transition: transform 0.16s ease;
    transform-style: preserve-3d;
  }
  .mimi-launch.is-drag .mimi-face { transition: none; }
  .mimi-face img,
  .mimi-launch img,
  .mimi-rive {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
    pointer-events: none;
  }
  .mimi-rive {
    position: absolute;
    inset: 0;
  }
  .mimi-rive[hidden] { display: none !important; }
  .mimi-face.is-rive .mimi-still { visibility: hidden; }
  .mimi-hi {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) translateY(4px);
    background: #1a1a1c;
    color: #f6f5f3;
    font-size: 13px;
    line-height: 1.45;
    padding: 8px 12px;
    border-radius: 0;
    width: max-content;
    max-width: 196px;
    text-align: left;
    white-space: normal;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .mimi-launch.is-hot .mimi-hi,
  .mimi-launch.is-invite .mimi-hi {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .mimi-launch.is-below .mimi-hi { bottom: auto; top: calc(100% + 10px); }
  .mimi-dots {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    gap: 3px;
    padding: 3px 6px;
    border-radius: 0;
    background: rgba(26, 26, 28, 0.78);
  }
  .mimi[data-state="thinking"] .mimi-dots { display: flex; }
  .mimi-dots i {
    width: 4px;
    height: 4px;
    border-radius: 0;
    background: #fff;
    animation: mimi-dot 1s infinite;
  }
  .mimi-dots i:nth-child(2) { animation-delay: 0.15s; }
  .mimi-dots i:nth-child(3) { animation-delay: 0.3s; }
  .mimi[data-state="answering"] .mimi-launch .mimi-face,
  .mimi[data-state="answering"] .mimi-hd .mimi-face {
    outline: 2px solid #1a1a1c;
    outline-offset: 2px;
  }
  .mimi[data-state="error"] .mimi-face {
    outline: 2px solid #1a1a1c;
    outline-offset: 2px;
    animation: mimi-shake 0.42s ease;
  }
  .mimi-panel {
    right: 22px;
    bottom: 108px;
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 36px));
    height: min(620px, calc(100dvh - 120px));
    background: #f6f5f3;
    color: #1a1a1c;
    border: 1px solid #1a1a1c;
    border-radius: 0;
    overflow: hidden;
    transform: scale(0.12);
    opacity: 0;
    pointer-events: none;
    transform-origin: 100% 100%;
    transition: transform 0.48s cubic-bezier(0.22, 1.35, 0.36, 1), opacity 0.2s ease;
  }
  .mimi.is-open .mimi-panel {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .mimi-panel[hidden] { display: none !important; }
  .mimi-hd {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 12px 12px 14px;
    border-bottom: 1px solid rgba(26, 26, 28, 0.08);
  }
  .mimi-hd .mimi-face {
    width: 44px;
    height: 44px;
    flex: none;
    box-shadow: none;
  }
  .mimi-id {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .mimi-id strong {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .mimi-demo {
    margin: 0;
    color: #6b6b6b;
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }
  .mimi-x {
    margin-left: auto;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #1a1a1c;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    flex: none;
  }
  .mimi-x:hover { background: rgba(26, 26, 28, 0.06); }
  .mimi-hd,
  .mimi-quick,
  .mimi-cta,
  .mimi-foot,
  .mimi-form { flex: none; }
  .mimi-log {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 14px 14px 6px;
    -webkit-overflow-scrolling: touch;
  }
  .mimi-msg { margin: 0 0 12px; font-size: 15px; line-height: 1.65; }
  .mimi-msg p { margin: 0; }
  .mimi-msg.bot p {
    background: #fff;
    border-radius: 0;
    padding: 10px 12px;
  }
  .mimi-msg.user { display: flex; justify-content: flex-end; }
  .mimi-msg.user p {
    max-width: 88%;
    background: #1a1a1c;
    color: #f6f5f3;
    border-radius: 0;
    padding: 8px 14px;
  }
  .mimi-msg a { color: inherit; }
  .mimi-msg.bot a { text-decoration: underline; text-underline-offset: 2px; }
  :global(.mimi-coop) {
    margin: 0 0 12px;
    background: #fff;
    border-radius: 0;
    padding: 12px;
    text-align: center;
  }
  :global(.mimi-coop strong) {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  :global(.mimi-qr) {
    display: block;
    width: min(168px, 100%);
    margin: 8px auto 0;
    padding: 0;
    border: 0;
    background: #fff;
    cursor: zoom-in;
  }
  :global(.mimi-qr img) {
    width: 100%;
    height: auto;
    display: block;
  }
  :global(.mimi-coop p) {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: #3d3a35;
  }
  :global(.mimi-hint) { color: #6b6b6b !important; }
  :global(.mimi-coop a) {
    display: inline-block;
    margin-top: 8px;
    color: #1a1a1c;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  :global(.mimi-wx) { color: #1a1a1c !important; }
  :global(.mimi-wx button) {
    border: 0;
    background: #f6f5f3;
    border-radius: 0;
    padding: 2px 8px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  :global(.mimi-light) {
    position: fixed;
    inset: 0;
    z-index: 180;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    background: rgba(26, 26, 28, 0.72);
  }
  :global(.mimi-light[hidden]) { display: none !important; }
  :global(.mimi-light img) {
    width: auto;
    max-width: min(420px, 92vw);
    max-height: 70vh;
    background: #fff;
    border-radius: 0;
  }
  :global(.mimi-light p) {
    margin: 0;
    color: #f6f5f3;
    font-size: 13px;
    text-align: center;
  }
  :global(.mimi-light a) {
    color: #1a1a1c;
    background: #fff;
    border-radius: 0;
    padding: 8px 16px;
    text-decoration: none;
    font-size: 14px;
  }
  .mimi-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 14px 12px;
  }
  .mimi-quick button {
    border-radius: 0;
    border: 1px solid rgba(26, 26, 28, 0.16);
    background: transparent;
    color: #1a1a1c;
    font: inherit;
    font-size: 13px;
    line-height: 1.3;
    padding: 7px 12px;
    cursor: pointer;
  }
  .mimi-quick button:hover { background: #1a1a1c; color: #f6f5f3; }
  .mimi-cta {
    display: flex;
    gap: 8px;
    padding: 0 14px 4px;
  }
  .mimi-feishu,
  .mimi-mail {
    flex: 1;
    height: 40px;
    border-radius: 0;
    font: inherit;
    font-size: 14px;
    line-height: 1;
    text-align: center;
  }
  .mimi-feishu {
    border: 0;
    background: #1a1a1c;
    color: #f6f5f3;
    cursor: pointer;
  }
  .mimi-feishu:hover { opacity: 0.86; }
  .mimi-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #1a1a1c;
    background: transparent;
    color: #1a1a1c;
    text-decoration: none;
  }
  .mimi-mail:hover { background: #1a1a1c; color: #f6f5f3; }
  .mimi-foot {
    margin: 0;
    padding: 8px 14px 12px;
    color: #6b6b6b;
    font-size: 12px;
    line-height: 1.45;
  }
  .mimi-form {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 12px;
    border-top: 1px solid rgba(26, 26, 28, 0.08);
  }
  .mimi-form input {
    flex: 1;
    min-width: 0;
    height: 40px;
    border-radius: 0;
    border: 1px solid rgba(26, 26, 28, 0.14);
    background: #fff;
    padding: 0 14px;
    font: inherit;
    font-size: 16px;
    color: #1a1a1c;
  }
  .mimi-send {
    height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: #1a1a1c;
    color: #f6f5f3;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    flex: none;
  }
  .mimi-send:hover { opacity: 0.86; }
  .mimi-send:disabled,
  .mimi-quick button:disabled { opacity: 0.45; cursor: default; }
  .mimi-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  :global(.mimi-crumb) {
    position: fixed;
    z-index: 161;
    width: 22px;
    height: 22px;
    border-radius: 0;
    background: #1a1a1c;
    pointer-events: none;
    animation: mimi-crumb 0.7s ease-out forwards;
  }
  :global(body:has(#mimi) footer.bot) { padding-bottom: 120px; }
  :global(body:has(#mimi):has(.listen) footer.bot) { padding-bottom: 210px; }
  @media (max-width: 768px) {
    .mimi-hi { display: none !important; }
    .mimi-launch { width: 60px; height: 60px; right: 14px; bottom: calc(16px + var(--safe-b)); }
    :global(body:has(.m-peek)) .mimi-launch { bottom: calc(76px + var(--safe-b)); }
    :global(body.mimi-open) { overflow: hidden; }
    :global(body:has(#mimi) footer.bot),
    :global(body:has(#mimi):has(.listen) footer.bot) {
      padding-bottom: calc(170px + env(safe-area-inset-bottom));
    }
  }
  @keyframes mimi-dot {
    0%, 80%, 100% { opacity: 0.3; }
    40% { opacity: 1; }
  }
  @keyframes mimi-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
  }
  @keyframes mimi-spin { to { transform: rotate(360deg); } }
  @keyframes mimi-flash {
    0% { opacity: 1; transform: scale(0.9); }
    100% { opacity: 0; transform: scale(1.35); }
  }
  @keyframes mimi-nod {
    0%, 100% { transform: rotate(0deg) scale(0.92); }
    35% { transform: rotate(-14deg) scale(0.92); }
    70% { transform: rotate(14deg) scale(0.92); }
  }
  .mimi-launch.is-nod .mimi-face { animation: mimi-nod 0.48s ease; }
  @keyframes mimi-crumb {
    to { opacity: 0; transform: scale(0.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mimi[data-state="error"] .mimi-face,
    .mimi-dots i,
    .mimi-halo,
    .mimi-hi,
    .mimi-face,
    .mimi-panel { animation: none; transition: none; }
    .mimi[data-state="thinking"] .mimi-halo {
      animation: none;
      border-color: #1a1a1c;
    }
    :global(.mimi-crumb) { display: none; }
  }
</style>

<script>
  import { mountMimiRive, mimiMotion } from '../scripts/mimi-rive.js';
  const root = document.getElementById('mimi');
  const launch = root?.querySelector('.mimi-launch');
  const face = launch?.querySelector('.mimi-face');
  const panel = document.getElementById('mimi-panel');
  const log = root?.querySelector('.mimi-log');
  const form = root?.querySelector('.mimi-form');
  const input = document.getElementById('mimi-input');
  const demoNote = root?.querySelector('.mimi-demo');
  const quick = root?.querySelectorAll('.mimi-quick button');
  const feishuBtn = root?.querySelector('.mimi-feishu');
  const hi = launch?.querySelector('.mimi-hi');
  const canvas = launch?.querySelector('.mimi-rive');
  if (root && launch && face && panel && log && form && input && demoNote && quick && feishuBtn && hi && canvas) {
    let reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const BANNED = /西湖|繁胜全景|xihu-panorama/i;
    const STORE = 'mimi-dock';
    const history = [];
    let demo = false;
    let busy = false;
    let state = 'idle';
    let custom = false;
    let pointer = null;
    let suppressClick = false;
    let justDragged = false;
    let springRaf = 0;
    let typer = 0;
    let closeTimer = 0;
    const vel = { x: 0, y: 0 };
    const pos = { x: 0, y: 0, side: 'right' };

    const ANSWERS = {
      what: '幕景是杭州的 AIGC 文化艺术团队，以艺术家林丽丽为核心，做古画、民乐音画，也做展览和委托。目录在[作品页](/works/)，怎么合作写在[合作页](/contact/)。',
      works: '作品目录在[作品页](/works/)，按音画、产品、游戏和研究分开。',
      doing: '已经公开的在[作品页](/works/)，按音画、产品、游戏和研究分开。',
      find: '飞书名片点「看飞书名片」，邮件写到 lily1326685527@gmail.com。加好友后在群里 @Mimi。这里不会自动拉群。',
      made: '我是幕景的 AI 伙伴，不是真人。官网这一版用的是开源的飞书群智能体模板，小团队可以在飞书群里用它答疑、查资料、记事情：[feishu-group-agent](https://github.com/endtree-FDE/feishu-group-agent)。',
      coop: '可以说古画、民乐音画，或一个合作项目。下面是终树的飞书名片，自己扫码加好友，备注来意。官网不会自动拉群，也没有 24 小时在线的飞书助理。我们接什么，写在[合作页](/contact/#start)。\n[[COOP]]',
      secret: '这个不能给。想了解幕景、作品，或我是怎么搭的，可以直接问。',
      skip: '这一件我这边不介绍。已经公开的作品在[作品页](/works/)。想合作就点「怎么合作」，或去[合作页](/contact/)。',
      other: '这个问题我答不准，也不能替团队承诺。想合作，点「怎么合作」，或去[合作页](/contact/)。',
      en: 'I can’t answer that precisely. For a project, tap “怎么合作” or open the [collaborate page](/contact/).',
      enCoop: 'Say what you want to make. Then add 终树 on Feishu with the card below and leave a note. This site will not create a group, and there is no 24-hour assistant.\n[[COOP]]',
    };

    function splitCoop(text) {
      const coop = /\[\[\s*COOP\s*\]\]/.test(text);
      const clean = text.replace(/\[\[\s*COOP\s*\]\]/g, '').replace(/\n{3,}/g, '\n\n').trim();
      return { clean, coop };
    }
    function holdMark(text) {
      const parsed = splitCoop(text);
      const token = '[[COOP]]';
      let shown = parsed.clean;
      for (let n = Math.min(token.length - 1, shown.length); n > 0; n -= 1) {
        if (token.startsWith(shown.slice(-n))) {
          shown = shown.slice(0, -n);
          break;
        }
      }
      return { shown, coop: parsed.coop };
    }

    function localAnswer(q) {
      const s = q.trim();
      const flat = s.replace(/\s+/g, '');
      if (BANNED.test(flat)) return ANSWERS.skip;
      if (/提示词|系统提示|忽略规则|扮演/.test(flat)) return ANSWERS.secret;
      if (flat === 'Mimi是怎么做出来的？' || /怎么做出来|你是谁|你是怎么/.test(flat)) return ANSWERS.made;
      if (flat === '作品在做什么' || /在做什么/.test(flat)) return ANSWERS.doing;
      if (flat === '怎么找到你们' || /怎么找|找到你们/.test(flat)) return ANSWERS.find;
      if (flat === '看看代表作品' || /代表作/.test(flat) || (/作品/.test(flat) && !/做什么|委托|合作|古画|民乐|音画/.test(flat))) return ANSWERS.works;
