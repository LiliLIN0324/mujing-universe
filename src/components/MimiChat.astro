---
/**
 * 全站唯一 Mimi 对话框（合一后只有这一份实现）。
 * variant="panel"：浮层小窗，右下 400px，可拖拽、Rive 头像；Base.astro 挂载（合作页除外）。
 * variant="bench"：合作页大面板，in-flow 960px，结构同 panel，由 CooperateHarness.astro 挂载。
 * 两壳内容完全一致：header（Mimi+演示标）→ log → 快捷 chips（作品在做什么/怎么合作/怎么找到你们/
 *   进鸡场/唤管家）→ CTA 行（看飞书名片/写邮件）→ IM 列表（飞书可用，其余即将开放）→ 输入行 → 页脚。
 * 会话贯通：turns 全量存 sessionStorage（'mimi-session-v1'），浮层聊到一半去合作页，内容还在。
 * 管家：剧本树（src/data/butler-script.json）引擎随迁至此，管家消息带橙色「管家 Mimi」名牌
 *   出现在同一个 log 里，选项渲染进 chips 行；[[FARM:*]]/[[COOP]] 照旧走 farm:cmd 总线/mimi-core 协议。
 * 入口：chips「唤管家」、鸡场 HUD「管家」按钮（farm:cmd butler）。
 * 密钥不在这里。/api/chat 不可达时走 mimi-core 的本地演示回答。
 */
const variant = Astro.props.variant === 'bench' ? 'bench' : 'panel';
const isBench = variant === 'bench';
const uid = isBench ? 'mimi-bench' : 'mimi';
const srcset = '/mimi/avatar-72.webp 72w, /mimi/avatar-144.webp 144w, /mimi/avatar-216.webp 216w, /mimi/avatar.webp 357w';
const email = 'lily1326685527@gmail.com';
---
<div class:list={['mimi', { 'mimi--bench': isBench }]} id={uid} data-variant={variant} data-state="idle" data-motion="idle" data-side="right">
  {!isBench && (
    <button class="mimi-launch" type="button" aria-expanded="false" aria-controls={`${uid}-panel`} aria-label="打开 Mimi 对话">
      <span class="mimi-halo" aria-hidden="true"></span>
      <span class="mimi-face">
        <span class="mimi-ground" aria-hidden="true"></span>
        <canvas class="mimi-rive" width="144" height="144" hidden aria-hidden="true"></canvas>
        <picture class="mimi-still">
          <source type="image/webp" srcset={srcset} sizes="(max-width: 768px) 60px, 72px" />
          <img src="/mimi/avatar.png" alt="" width="72" height="72" decoding="async" draggable="false" />
        </picture>
        <span class="mimi-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
      <span class="mimi-hi" role="tooltip">嗨，我是 Mimi，带你随便看看。</span>
    </button>
  )}
  <section class="mimi-panel" id={`${uid}-panel`} role="dialog" aria-modal="false" aria-labelledby={`${uid}-name`} hidden={isBench ? undefined : true}>
    <header class="mimi-hd">
      <span class="mimi-face">
        <span class="mimi-ground" aria-hidden="true"></span>
        <picture>
          <source type="image/webp" srcset={srcset} sizes="44px" />
          <img src="/mimi/avatar.png" alt="" width="44" height="44" decoding="async" draggable="false" />
        </picture>
        <span class="mimi-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
      <div class="mimi-id">
        <strong id={`${uid}-name`}>Mimi</strong>
        <p class="mimi-demo">演示</p>
      </div>
      {!isBench && <button class="mimi-x" type="button" aria-label="关闭对话">×</button>}
    </header>
    <div class="mimi-log" role="log" aria-live="polite" aria-relevant="additions"></div>
    <div class="mimi-quick" role="group" aria-label="快捷问题">
      <button type="button">作品在做什么</button>
      <button type="button">怎么合作</button>
      <button type="button">怎么找到你们</button>
      <button class="mimi-farmbtn" type="button">进鸡场</button>
      <button class="mimi-butlerbtn" type="button">唤管家</button>
    </div>
    <div class="mimi-cta">
      <button class="mimi-feishu" type="button">看飞书名片</button>
      <button class="mimi-mail" type="button">写邮件</button>
    </div>
    <form class="mimi-form">
      <label class="mimi-sr" for={`${uid}-input`}>输入问题</label>
      <input class="mimi-input" id={`${uid}-input`} name="q" maxlength="400" autocomplete="off" enterkeyhint="send" placeholder="想了解幕景，直接问我" />
      <button class="mimi-send" type="submit">发送</button>
    </form>
  </section>
</div>

<style>
  .mimi { --safe-b: env(safe-area-inset-bottom, 0px); }
  .mimi-launch,
  .mimi-panel {
    position: fixed;
    z-index: 160;
    font-family: "Alibaba PuHuiTi 3.0", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  }
  .mimi-launch {
    right: 22px;
    bottom: 22px;
    z-index: 162;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    outline: none;
    box-shadow: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
    touch-action: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }
  .mimi-launch.is-drag { cursor: grabbing; }
  .mimi-launch:focus,
  .mimi-launch:focus-visible {
    outline: none;
  }
  .mimi-halo {
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: #1a1a1c;
    border-right-color: #1a1a1c;
    opacity: 0;
    pointer-events: none;
  }
  .mimi[data-state="thinking"] .mimi-halo {
    opacity: 1;
    animation: mimi-spin 0.9s linear infinite;
  }
  .mimi-launch.is-flash .mimi-halo {
    opacity: 1;
    border-color: #1a1a1c;
    animation: mimi-flash 0.45s ease-out;
  }
  .mimi-face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    overflow: visible;
    background: transparent;
    box-shadow: none;
    outline: none;
  }
  .mimi-launch.is-drag .mimi-face { transition: none; }
  /* 画布不缩放、不裁切。橙色圆外的白底在 mimi-rive.js 里按橙边清掉。
     静态图的白角只处理图片自己，缺的圆顶用同色圆补。 */
  .mimi-ground {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #ff690a;
    pointer-events: none;
  }
  .mimi-face.is-rive .mimi-ground { visibility: hidden; }
  .mimi-face picture {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 50%;
  }
  .mimi-face picture img {
    position: absolute;
    left: 0;
    top: 3.48%;
    width: 100%;
    height: 100%;
  }
  .mimi-face img,
  .mimi-launch img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    display: block;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
    pointer-events: none;
  }
  .mimi-rive {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    border-radius: 0;
    background: transparent;
    object-fit: fill;
    display: block;
    pointer-events: none;
    user-select: none;
  }
  .mimi-rive[hidden] { display: none !important; }
  .mimi-face.is-rive .mimi-still { visibility: hidden; }
  .mimi-hi {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) translateY(4px);
    background: #1a1a1c;
    color: #f6f5f3;
    font-size: 13px;
    line-height: 1.45;
    padding: 8px 12px;
    border-radius: 0;
    width: max-content;
    max-width: 196px;
    text-align: left;
    white-space: normal;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .mimi-launch.is-hot .mimi-hi,
  .mimi-launch.is-invite .mimi-hi {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .mimi-launch.is-below .mimi-hi { bottom: auto; top: calc(100% + 10px); }
  .mimi-dots {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    gap: 3px;
    padding: 3px 6px;
    border-radius: 0;
    background: rgba(26, 26, 28, 0.78);
  }
  .mimi[data-state="thinking"] .mimi-dots { display: flex; }
  .mimi-dots i {
    width: 4px;
    height: 4px;
    border-radius: 0;
    background: #fff;
    animation: mimi-dot 1s infinite;
  }
  .mimi-dots i:nth-child(2) { animation-delay: 0.15s; }
  .mimi-dots i:nth-child(3) { animation-delay: 0.3s; }
  .mimi[data-state="error"] .mimi-face {
    animation: mimi-shake 0.42s ease;
  }
  .mimi-panel {
    right: 22px;
    bottom: 108px;
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 36px));
    height: min(620px, calc(100dvh - 120px));
    background: #f6f5f3;
    color: #1a1a1c;
    border: 1px solid #1a1a1c;
    border-radius: 0;
    overflow: hidden;
    transform: scale(0.12);
    opacity: 0;
    pointer-events: none;
    transform-origin: 100% 100%;
    transition: transform 0.48s cubic-bezier(0.22, 1.35, 0.36, 1), opacity 0.2s ease;
  }
  .mimi.is-open .mimi-panel {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .mimi-panel[hidden] { display: none !important; }
  .mimi-hd {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 12px 12px 14px;
    border-bottom: 1px solid rgba(26, 26, 28, 0.08);
  }
  .mimi-hd .mimi-face {
    width: 44px;
    height: 44px;
    flex: none;
    box-shadow: none;
  }
  .mimi-id {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .mimi-id strong {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .mimi-demo {
    margin: 0;
    color: #6b6b6b;
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }
  .mimi-x {
    margin-left: auto;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #1a1a1c;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    flex: none;
  }
  .mimi-x:hover { background: rgba(26, 26, 28, 0.06); }
  .mimi-hd,
  .mimi-quick,
  .mimi-cta,
  .mimi-ims,
  .mimi-foot,
  .mimi-form { flex: none; }
  .mimi-log {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 14px 14px 6px;
    -webkit-overflow-scrolling: touch;
  }
  .mimi-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 14px 12px;
  }
  .mimi-quick button {
    border-radius: 0;
    border: 1px solid rgba(26, 26, 28, 0.16);
    background: transparent;
    color: #1a1a1c;
    font: inherit;
    font-size: 13px;
    line-height: 1.3;
    padding: 7px 12px;
    cursor: pointer;
  }
  .mimi-quick button:hover { background: #1a1a1c; color: #f6f5f3; }
  .mimi-quick .mimi-farmbtn:hover { background: #ff690a; border-color: #ff690a; color: #f6f5f3; }
  .mimi-cta {
    display: flex;
    gap: 8px;
    padding: 0 14px 4px;
  }
  .mimi-feishu,
  .mimi-mail {
    flex: 1;
    height: 40px;
    border-radius: 0;
    font: inherit;
    font-size: 14px;
    line-height: 1;
    text-align: center;
  }
  .mimi-feishu {
    border: 0;
    background: #1a1a1c;
    color: #f6f5f3;
    cursor: pointer;
  }
  .mimi-feishu:hover { opacity: 0.86; }
  .mimi-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #1a1a1c;
    background: transparent;
    color: #1a1a1c;
    text-decoration: none;
    cursor: pointer;
  }
  .mimi-mail:hover { background: #1a1a1c; color: #f6f5f3; }
  .mimi-ims {
    display: flex;
    flex-direction: column;
    margin: 8px 14px 0;
    border: 1px solid rgba(26, 26, 28, 0.16);
  }
  .mimi-ims button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 0;
    border-top: 1px solid rgba(26, 26, 28, 0.08);
    background: transparent;
    color: #1a1a1c;
    font: inherit;
    font-size: 13px;
    line-height: 1;
    text-align: left;
    cursor: pointer;
  }
  .mimi-ims > :first-child { border-top: 0; }
  .mimi-ims button:not(:disabled):hover,
  .mimi-ims button.is-on {
    background: #1a1a1c;
    color: #f6f5f3;
  }
  .mimi-ims button:disabled {
    color: #9a9a9a;
    cursor: not-allowed;
  }
  .mimi-ims button span {
    color: #9a9a9a;
    font-size: 12px;
  }
  .mimi-foot {
    margin: 0;
    padding: 8px 14px 12px;
    color: #6b6b6b;
    font-size: 12px;
    line-height: 1.45;
  }
  .mimi-form {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 12px;
    border-top: 1px solid rgba(26, 26, 28, 0.08);
  }
  .mimi-form input {
    flex: 1;
    min-width: 0;
    height: 40px;
    border-radius: 0;
    border: 1px solid rgba(26, 26, 28, 0.14);
    background: #fff;
    padding: 0 14px;
    font: inherit;
    font-size: 16px;
    color: #1a1a1c;
  }
  .mimi-send {
    height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: #1a1a1c;
    color: #f6f5f3;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    flex: none;
  }
  .mimi-send:hover { opacity: 0.86; }
  .mimi-send:disabled,
  .mimi-quick button:disabled { opacity: 0.45; cursor: default; }
  .mimi-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== bench 壳：in-flow 大面板，结构同 panel，只是尺寸放大 ===== */
  .mimi--bench {
    position: static;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
  }
  .mimi--bench .mimi-panel {
    position: relative;
    right: auto;
    bottom: auto;
    z-index: auto;
    width: 100%;
    height: auto;
    min-height: 0;
    flex: 1;
    transform: none;
    opacity: 1;
    pointer-events: auto;
    transition: none;
  }
  .mimi--bench .mimi-x { display: none; }
  .mimi--bench .mimi-hd { padding: 18px 22px 14px; }
  .mimi--bench .mimi-log { padding: 20px 22px 10px; }
  .mimi--bench .mimi-quick { padding: 6px 22px 14px; }
  .mimi--bench .mimi-cta { padding: 0 22px 6px; }
  .mimi--bench .mimi-ims { margin: 10px 22px 0; }
  .mimi--bench .mimi-form { padding: 14px 22px; }
  .mimi--bench .mimi-foot { padding: 8px 22px 14px; }

  /* ===== 运行时创建的 DOM（消息/卡片/管家件/toast）拿不到 scoped 属性，一律 :global ===== */
  :global(.mimi-msg) { margin: 0 0 12px; font-size: 15px; line-height: 1.65; }
  :global(.mimi-msg p) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  :global(.mimi-msg.bot p) {
    background: #fff;
    border-radius: 0;
    padding: 10px 12px;
  }
  :global(.mimi-msg.user) { display: flex; justify-content: flex-end; }
  :global(.mimi-msg.user p) {
    max-width: 88%;
    background: #1a1a1c;
    color: #f6f5f3;
    border-radius: 0;
    padding: 8px 14px;
  }
  :global(.mimi-msg a) { color: inherit; }
  :global(.mimi-msg.bot a) { text-decoration: underline; text-underline-offset: 2px; }
  :global(.mimi--bench .mimi-msg) { font-size: 16px; }

  /* 管家消息：橙色名牌前缀，卡片底色区分 */
  :global(.mimi-msg.is-butler .mimi-plate) {
    display: inline-block;
    margin: 0 0 5px;
    background: #ff690a;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    padding: 2px 8px;
    border: 1px solid #1a1a1c;
  }
  :global(.mimi-msg.is-butler p) { background: #fffdf4; }

  /* 管家选项（渲染进 chips 行）：hover 翻橙，条件不满足置灰 */
  :global(button.mimi-butlerchip) {
    border: 1px solid rgba(26, 26, 28, 0.16);
    border-radius: 0;
    background: transparent;
    color: #1a1a1c;
    font: inherit;
    font-size: 13px;
    line-height: 1.3;
    padding: 7px 12px;
    cursor: pointer;
  }
  :global(button.mimi-butlerchip:hover:not(:disabled)) { background: #ff690a; border-color: #ff690a; color: #fff; }
  :global(button.mimi-butlerchip:focus-visible) { outline: 2px solid #ff690a; outline-offset: 2px; }
  :global(button.mimi-butlerchip:disabled) { color: #9a9a9a; border-color: rgba(26, 26, 28, 0.24); background: transparent; cursor: not-allowed; }
  :global(button.mimi-butlerchip i) { font-style: normal; font-size: 11px; margin-left: 4px; opacity: 0.7; }

  /* 飞书名片卡（log 内） */
  :global(.mimi-coop) {
    margin: 0 0 12px;
    background: #fff;
    border-radius: 0;
    padding: 12px;
    text-align: center;
  }
  :global(.mimi-coop strong) {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  :global(.mimi-qr) {
    display: block;
    width: min(168px, 100%);
    margin: 8px auto 0;
    padding: 0;
    border: 0;
    background: #fff;
    cursor: zoom-in;
  }
  :global(.mimi-qr img) {
    width: 100%;
    height: auto;
    display: block;
  }
  :global(.mimi-coop p) {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: #3d3a35;
  }
  :global(.mimi-hint) { color: #6b6b6b !important; }
  :global(.mimi-coop a) {
    display: inline-block;
    margin-top: 8px;
    color: #1a1a1c;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  :global(.mimi-wx) { color: #1a1a1c !important; }
  :global(.mimi-wx button) {
    border: 0;
    background: #f6f5f3;
    border-radius: 0;
    padding: 2px 8px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  /* 邮件表单卡（log 内，两壳通用） */
  :global(.mimi-mailcard) {
    display: block;
    margin: 0 0 12px;
    background: #fff;
    border-radius: 0;
    padding: 12px;
    text-align: left;
  }
  :global(.mimi-mailcard strong) {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  :global(.mimi-mailcard .mimi-fields) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 14px;
  }
  :global(.mimi-mailcard label) {
    display: block;
    color: #6b6b6b;
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  :global(.mimi-mailcard input),
  :global(.mimi-mailcard select),
  :global(.mimi-mailcard textarea) {
    display: block;
    width: 100%;
    margin-top: 6px;
    border: 1px solid rgba(26, 26, 28, 0.3);
    border-radius: 0;
    background: #f6f5f3;
    color: #1a1a1c;
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    padding: 8px 10px;
  }
  :global(.mimi-mailcard select) {
    appearance: none;
    height: 42px;
    padding-right: 30px;
    background-image: linear-gradient(45deg, transparent 50%, #1a1a1c 50%), linear-gradient(135deg, #1a1a1c 50%, transparent 50%);
    background-position: calc(100% - 16px) 18px, calc(100% - 10px) 18px;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }
  :global(.mimi-mailcard .wide) { grid-column: 1 / -1; }
  :global(.mimi-mailcard textarea) { min-height: 88px; resize: vertical; }
  :global(.mimi-mailcard .mimi-mailsend) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 12px;
  }
  :global(.mimi-mailcard .mimi-mailsend button) {
    height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: 0;
    background: #1a1a1c;
    color: #f6f5f3;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  :global(.mimi-mailcard .mimi-mailsend button:hover) { opacity: 0.86; }
  :global(.mimi-mailcard .mimi-mailsend a) {
    color: #1a1a1c;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 560px) {
    :global(.mimi-mailcard .mimi-fields) { grid-template-columns: 1fr; }
    :global(.mimi-mailcard .wide) { grid-column: auto; }
  }

  /* 微信卡（log 内） */
  :global(.mimi-wxcard) {
    margin: 0 0 12px;
    background: #fff;
    border-radius: 0;
    padding: 12px;
  }
  :global(.mimi-wxcard strong) {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  :global(.mimi-wxcard p) {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: #3d3a35;
  }

  /* 二维码放大灯箱 */
  :global(.mimi-light) {
    position: fixed;
    inset: 0;
    z-index: 180;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    background: rgba(26, 26, 28, 0.72);
  }
  :global(.mimi-light[hidden]) { display: none !important; }
  :global(.mimi-light img) {
    width: auto;
    max-width: min(420px, 92vw);
    max-height: 70vh;
    background: #fff;
    border-radius: 0;
  }
  :global(.mimi-light p) {
    margin: 0;
    color: #f6f5f3;
    font-size: 13px;
    text-align: center;
  }
  :global(.mimi-light a) {
    color: #1a1a1c;
    background: #fff;
    border-radius: 0;
    padding: 8px 16px;
    text-decoration: none;
    font-size: 14px;
  }

  /* 鸡场主动开口的小告示（farm:say，对话框收着时用） */
  :global(.mimi-toast) {
    position: fixed;
    left: 14px;
    bottom: 60px;
    z-index: 150;
    max-width: min(420px, calc(100vw - 28px));
    background: #fffdf4;
    border: 1px solid #1a1a1c;
    padding: 8px 12px;
    font-size: 13px;
    line-height: 1.5;
    font-family: "Alibaba PuHuiTi 3.0", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  }
  :global(.mimi-toast[hidden]) { display: none !important; }

  :global(.mimi-crumb) {
    position: fixed;
    z-index: 161;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #ff690a;
    opacity: 0.82;
    pointer-events: none;
    animation: mimi-crumb 0.7s ease-out forwards;
  }
  :global(body:has(#mimi) footer.bot) { padding-bottom: 120px; }
  :global(body:has(#mimi):has(.listen) footer.bot) { padding-bottom: 210px; }
  @media (max-width: 768px) {
    .mimi-hi { display: none !important; }
    .mimi-launch { width: 60px; height: 60px; right: 14px; bottom: calc(16px + var(--safe-b)); }
    :global(body:has(.m-peek)) .mimi-launch { bottom: calc(76px + var(--safe-b)); }
    :global(body.mimi-open) { overflow: hidden; }
    :global(body:has(#mimi) footer.bot),
    :global(body:has(#mimi):has(.listen) footer.bot) {
      padding-bottom: calc(170px + env(safe-area-inset-bottom));
    }
  }
  @keyframes mimi-dot {
    0%, 80%, 100% { opacity: 0.3; }
    40% { opacity: 1; }
  }
  @keyframes mimi-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
  }
  @keyframes mimi-spin { to { transform: rotate(360deg); } }
  @keyframes mimi-flash {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes mimi-crumb {
    from { opacity: 0.82; transform: scale(1); }
    to { opacity: 0; transform: scale(0.3); }
  }
  
  /* ===== 夜间模式适配（对齐 global.css html.dark 制式：--bg/#131316、--paper/#242429、--ink/#EDEBE7）===== */
  html.dark .mimi-launch { box-shadow: none; }
  html.dark .mimi-launch .mimi-face { background: #242429; box-shadow: inset 0 0 0 1px #EDEBE7; }
  html.dark .mimi-halo { border-top-color: #EDEBE7; border-right-color: #EDEBE7; }
  html.dark .mimi-hi { background: #EDEBE7; color: #131316; }
