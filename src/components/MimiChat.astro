  html.dark .mimi-hd { border-bottom-color: #EDEBE71F; }
  html.dark .mimi-hd .mimi-face { background: #242429; box-shadow: inset 0 0 0 1px #EDEBE733; }
  html.dark .mimi-demo { color: #A8A49D; }
  html.dark .mimi-x { color: #EDEBE7; }
  html.dark .mimi-x:hover { background: #EDEBE71A; }
  html.dark .mimi-msg.bot p { background: #242429; color: #EDEBE7; }
  html.dark .mimi-msg.bot p a { color: #EDEBE7; text-decoration: underline; }
  html.dark .mimi-msg.user p { background: #EDEBE7; color: #131316; }
  html.dark .mimi-plate { background: #ff690a; color: #fff; }
  html.dark .mimi-quick button { color: #EDEBE7; border-color: #EDEBE71A; }
  html.dark .mimi-quick button:hover { background: #EDEBE7; color: #131316; }
  html.dark .mimi-quick .mimi-farmbtn:hover { background: #ff690a; border-color: #ff690a; color: #fff; }
  html.dark .mimi-feishu { background: #EDEBE7; color: #131316; }
  html.dark .mimi-mail { color: #EDEBE7; border-color: #EDEBE71A; }
  html.dark .mimi-mail:hover { background: #EDEBE7; color: #131316; }
  html.dark .mimi-form input { background: #242429; color: #EDEBE7; border-color: #EDEBE71A; }
  html.dark .mimi-form input::placeholder { color: #9C978F; }
  html.dark .mimi-form .mimi-send { background: #EDEBE7; color: #131316; }
  html.dark .mimi-form .mimi-send:hover { background: #ff690a; color: #fff; }
  html.dark .mimi-foot { color: #9C978F; }
  html.dark .mimi-note { background: #242429; color: #EDEBE7; border-color: #EDEBE733; }
  html.dark .mimi-coop { background: #242429; border-color: #EDEBE733; }
  html.dark .mimi-coop p { color: #C9C5BE; }
  html.dark .mimi-coop a { color: #EDEBE7; }
  html.dark .mimi-dots i { background: #9C978F; }

  @media (prefers-reduced-motion: reduce) {
    .mimi[data-state="error"] .mimi-face,
    .mimi-dots i,
    .mimi-halo,
    .mimi-hi,
    .mimi-face,
    .mimi-panel { animation: none; transition: none; }
    .mimi[data-state="thinking"] .mimi-halo {
      animation: none;
      border-color: #1a1a1c;
    }
    :global(.mimi-crumb) { display: none; }
  }
</style>

<script>
  import { linkify, requestReply } from '../scripts/mimi-core.js';
  import { mountMimiRive, mimiMotion } from '../scripts/mimi-rive.js';
  import butlerScript from '../data/butler-script.json';

  const root = document.getElementById('mimi') || document.getElementById('mimi-bench');
  if (root && !root.dataset.mimiInit) {
    root.dataset.mimiInit = '1';

    const bench = root.dataset.variant === 'bench';
    const launch = root.querySelector('.mimi-launch');
    const face = launch?.querySelector('.mimi-face');
    const panel = root.querySelector('.mimi-panel');
    const log = root.querySelector('.mimi-log');
    const form = root.querySelector('.mimi-form');
    const input = root.querySelector('.mimi-form input');
    const sendBtn = form?.querySelector('.mimi-send');
    const quickBox = root.querySelector('.mimi-quick');
    const normalChips = quickBox ? [...quickBox.querySelectorAll('button')] : [];
    const farmChip = root.querySelector('.mimi-farmbtn');
    const butlerChip = root.querySelector('.mimi-butlerbtn');
    const feishuBtn = root.querySelector('.mimi-feishu');
    const mailBtn = root.querySelector('.mimi-mail');
    const imFeishu = root.querySelector('.mimi-im-feishu');
    const closeBtn = root.querySelector('.mimi-x');
    const canvas = launch?.querySelector('.mimi-rive');
    const hi = launch?.querySelector('.mimi-hi');

    let reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EMAIL = 'lily1326685527@gmail.com';
    const GREETING = '这卷西湖还在画。想听近况，或留下合作意向，都可以跟我说一句。';
    const COOP_LINE = '可以说古画、民乐音画，或一个合作项目。说完我把飞书名片放出来，你自己加好友。官网不会自动拉群。我们接什么在[合作页](/contact/#start)。';
    const DEFAULT_PLACEHOLDER = '想了解幕景，直接问我';
    const SESSION_KEY = 'mimi-session-v1';

    /* ===== 会话（两壳贯通）：turns 全量存 sessionStorage，同一 key，浮层与合作页共用 ===== */
    let session = { demo: false, entries: [] };
    try {
      const raw = JSON.parse(sessionStorage.getItem(SESSION_KEY) || '');
      if (raw && Array.isArray(raw.entries)) {
        const ok = raw.entries.filter((e) => {
          if (!e || typeof e.r !== 'string') return false;
          if (e.r === 'user' || e.r === 'bot' || e.r === 'butler') return typeof e.t === 'string' && e.t.length > 0;
          if (e.r === 'card') return e.k === 'coop' || e.k === 'mail' || e.k === 'wechat';
          return false;
        });
        session = { demo: !!raw.demo, entries: ok.slice(-80) };
      }
    } catch { /* 首次进入或隐私模式 */ }
    let demo = !!session.demo;
    let busy = false;
    let state = 'idle';
    let typer = 0;
    let closeTimer = 0;
    let justDragged = false;

    function persist() {
      try { sessionStorage.setItem(SESSION_KEY, JSON.stringify(session)); } catch { /* 隐私模式 */ }
    }
    function record(entry) {
      session.entries.push(entry);
      if (session.entries.length > 80) session.entries = session.entries.slice(-80);
      persist();
    }
    /* 普通聊的上下文：只要 user/bot 文本；管家自由聊的轮次（b:1）不混进普通聊天 */
    function chatHistory() {
      const list = [];
      for (const e of session.entries) {
        if (e.r === 'bot') list.push({ role: 'assistant', content: e.t });
        else if (e.r === 'user' && !e.b) list.push({ role: 'user', content: e.t });
      }
      return list;
    }

    /* ===== 状态与控件联动 ===== */
    let butlerTyping = false;  // 正在播管家台词
    let butlerPending = false; // 管家自由聊等回复
    function syncControls() {
      const lock = state === 'thinking' || butlerTyping || butlerPending;
      if (sendBtn) sendBtn.disabled = lock;
      if (!quickBox) return;
      for (const b of quickBox.querySelectorAll('button')) {
        if (lock) { b.disabled = true; continue; }
        if (!butler && !b.classList.contains('mimi-butlerchip')) b.disabled = false;
      }
    }
    function setState(next) {
      state = next;
      root.dataset.state = next;
      syncControls();
    }

    /* ===== 消息（log 内） ===== */
    function finishText(p, text, done) {
      p.replaceChildren();
      if (text) linkify(p, text);
      if (state === 'answering') setState('idle');
      if (done) done();
    }
    function typewrite(p, text, done) {
      window.clearInterval(typer);
      if (reduce || !text) {
        finishText(p, text, done);
        return;
      }
      const shown = text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
      let i = 0;
      const step = shown.length > 70 ? 2 : 1;
      typer = window.setInterval(() => {
        i = Math.min(shown.length, i + step);
        p.textContent = shown.slice(0, i);
        log.scrollTop = log.scrollHeight;
        if (i >= shown.length) {
          window.clearInterval(typer);
          finishText(p, text, done);
        }
      }, 18);
    }
    function append(role, text, typed = true, done) {
      const item = document.createElement('div');
      item.className = `mimi-msg ${role === 'user' ? 'user' : 'bot'}`;
      const p = document.createElement('p');
      item.append(p);
      log.append(item);
      if (role === 'user') p.textContent = text;
      else if (typed) typewrite(p, text, done);
      else finishText(p, text, done);
      log.scrollTop = log.scrollHeight;
      return p;
    }
    function appendButlerEl() {
      const item = document.createElement('div');
      item.className = 'mimi-msg bot is-butler';
      const plate = document.createElement('b');
      plate.className = 'mimi-plate';
      plate.textContent = '管家 Mimi';
      const p = document.createElement('p');
      item.append(plate, p);
      log.append(item);
      log.scrollTop = log.scrollHeight;
      return p;
    }

    /* ===== log 内卡片（两壳通用）：飞书名片 / 邮件表单 / 微信 ===== */
    let light = null;
    function openLight() {
      if (!light) {
        light = document.createElement('div');
        light.className = 'mimi-light';
        light.hidden = true;
        const img = document.createElement('img');
        img.src = '/mimi/feishu-qr.png';
        img.alt = '终树的飞书名片二维码';
        img.draggable = false;
        const hint = document.createElement('p');
        hint.textContent = '手机上长按图片保存';
        const save = document.createElement('a');
        save.href = '/mimi/feishu-qr.png';
        save.download = 'feishu-qr.png';
        save.textContent = '保存图片';
        light.append(img, hint, save);
        light.addEventListener('click', (e) => {
          if (e.target === light) light.hidden = true;
        });
        document.body.append(light);
      }
      light.hidden = false;
    }
    function scrollCard(card) {
      if (card.offsetHeight <= log.clientHeight) log.scrollTop = log.scrollHeight;
      else log.scrollTop += card.getBoundingClientRect().top - log.getBoundingClientRect().top;
    }
    function buildCoopCard() {
      const card = document.createElement('div');
      card.className = 'mimi-coop';
      const title = document.createElement('strong');
      title.textContent = '用飞书聊';
      const zoom = document.createElement('button');
      zoom.type = 'button';
      zoom.className = 'mimi-qr';
      zoom.setAttribute('aria-label', '放大飞书二维码');
      const img = document.createElement('img');
      img.src = '/mimi/feishu-qr.png';
      img.alt = '终树的飞书名片，含头像、名字和二维码';
      img.draggable = false;
      img.width = 431;
      img.height = 568;
      zoom.append(img);
      zoom.addEventListener('click', openLight);
      const note = document.createElement('p');
      note.textContent = '扫码加终树为好友，备注项目。加完在群里 @Mimi。不会自动拉群。';
      const hint = document.createElement('p');
      hint.className = 'mimi-hint';
      hint.textContent = '点按放大。手机上长按图片，或点「保存图片」。';
      const more = document.createElement('a');
      more.href = '/contact/#start';
      more.textContent = '先看我们接什么';
      const save = document.createElement('a');
      save.href = '/mimi/feishu-qr.png';
      save.download = 'feishu-qr.png';
      save.textContent = '保存图片';
      const wx = document.createElement('p');
      wx.className = 'mimi-wx';
      wx.append('微信备用 ');
      const id = document.createElement('button');
      id.type = 'button';
      id.textContent = 'endTree-26';
      id.addEventListener('click', () => {
        id.textContent = '已复制';
        const back = () => window.setTimeout(() => { id.textContent = 'endTree-26'; }, 1200);
        const ta = document.createElement('textarea');
        ta.value = 'endTree-26';
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.append(ta);
        ta.focus();
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
        if (ok) { back(); return; }
        if (navigator.clipboard && window.isSecureContext) {
          const timer = window.setTimeout(back, 500);
          navigator.clipboard.writeText('endTree-26').then(() => {
            window.clearTimeout(timer);
            back();
          }).catch(back);
          return;
        }
        back();
      });
      wx.append(id);
      card.append(title, zoom, note, hint, save, more, wx);
      log.append(card);
      scrollCard(card);
    }
    function buildMailCard() {
      const card = document.createElement('form');
      card.className = 'mimi-mailcard';
      card.innerHTML = `
        <strong>写邮件</strong>
        <div class="mimi-fields">
          <label>称呼<input name="称呼" autocomplete="name" required /></label>
          <label>品牌·单位<input name="品牌·单位" autocomplete="organization" /></label>
          <label>邮箱<input name="邮箱" type="email" autocomplete="email" inputmode="email" required /></label>
          <label>方向
            <select name="方向">
              <option value="" selected></option>
              <option>古画</option>
              <option>民乐音画</option>
              <option>展览 · 委托</option>
            </select>
          </label>
          <label class="wide">简述<textarea name="简述" rows="4"></textarea></label>
        </div>
        <div class="mimi-mailsend">
          <button type="submit">发送</button>
          <a href="mailto:${EMAIL}">${EMAIL}</a>
        </div>`;
      card.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!card.reportValidity()) return;
        const data = new FormData(card);
        const name = String(data.get('称呼') || '').trim();
        const org = String(data.get('品牌·单位') || '').trim();
        const from = String(data.get('邮箱') || '').trim();
        const need = String(data.get('方向') || '').trim();
        const brief = String(data.get('简述') || '').trim();
        const subject = need ? '合作 · ' + need : '合作';
        const body = [
          '称呼：' + name,
          '品牌·单位：' + (org || '—'),
          '邮箱：' + from,
          '方向：' + (need || '—'),
          '',
          brief,
        ].join('\n');
        location.href = 'mailto:' + EMAIL + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
      log.append(card);
      scrollCard(card);
    }
    function buildWechatCard() {
      const card = document.createElement('div');
      card.className = 'mimi-wxcard';
      const title = document.createElement('strong');
      title.textContent = '微信';
      const note = document.createElement('p');
      note.textContent = '还没有。开通后这里会更新，眼下请走飞书或邮件。';
      card.append(title, note);
      log.append(card);
      scrollCard(card);
    }
    function showCoopCard() {
      if (imFeishu) {
        imFeishu.classList.add('is-on');
        imFeishu.setAttribute('aria-pressed', 'true');
      }
      const card = log.querySelector('.mimi-coop');
      if (card) { scrollCard(card); return; }
      buildCoopCard();
      record({ r: 'card', k: 'coop' });
    }
    function showMailCard() {
      const card = log.querySelector('.mimi-mailcard');
      if (card) { scrollCard(card); return; }
      buildMailCard();
      record({ r: 'card', k: 'mail' });
    }
    function showWechatCard() {
      const card = log.querySelector('.mimi-wxcard');
      if (card) { scrollCard(card); return; }
      buildWechatCard();
      record({ r: 'card', k: 'wechat' });
    }

    /* ===== 管家剧本引擎（自 ButlerDialogueBox.astro 并入，剧本树 src/data/butler-script.json） =====
       vars：met_before / trust 走 localStorage，gift_used 走 sessionStorage（每次会话限一颗） */
    const nodes = butlerScript.nodes;
    const VKEY = 'mujing-butler-v1';
    const GIFT_KEY = 'mujing-butler-gift';
    const vars = { met_before: false, gift_used: false, trust: 0, ...butlerScript.vars };
    try { Object.assign(vars, JSON.parse(localStorage.getItem(VKEY) || '')); } catch { /* 首次或隐私模式 */ }
    try { vars.gift_used = sessionStorage.getItem(GIFT_KEY) === '1'; } catch { /* 隐私模式 */ }
    function persistVars() {
      try { localStorage.setItem(VKEY, JSON.stringify({ met_before: !!vars.met_before, trust: vars.trust | 0 })); } catch { /* 隐私模式 */ }
    }

    /* 农场快照：优先收总线广播，页面没挂鸡场组件时退回直读 localStorage（同 schema） */
    let farmSnap = null;
    window.addEventListener('farm:state', (e) => { farmSnap = e.detail; });
    function readFarmFallback() {
      try {
        const s = JSON.parse(localStorage.getItem('mujing-farm-v1') || '');
        if (!s || typeof s !== 'object' || s.v !== 1) return null;
        const breeds = {};
        const pagesMap = {};
        let here = 0;
        const hereKey = document.body.dataset.page || 'home';
        for (const c of s.chickens || []) {
          breeds[c.breed] = (breeds[c.breed] || 0) + 1;
          pagesMap[c.page] = (pagesMap[c.page] || 0) + 1;
          if (c.page === hereKey) here += 1;
        }
        let found = 0;
        for (const k in s.dex || {}) if ((s.dex[k] | 0) > 0) found += 1;
        return { eggs: s.eggs | 0, chickens: s.hatched | 0, breeds, pagesMap, here, elsewhere: (s.chickens || []).length - here, dex_left: 7 - found };
      } catch { return null; }
    }
    const snap = () => farmSnap || readFarmFallback();

    /* 鸡场问题的本地兜底：只在演示态（无 API key/断网）使用；线上主路径走 /api/chat，
       农场账已注入 SYSTEM（AI Native）。问题正则刻意收窄，避免误接普通咨询。 */
    const FARM_CN = { home: '首页', works: '作品页', about: '关于页', news: '动态页', contact: '合作页' };
    const FARM_Q = /我的.{0,6}鸡|小鸡|鸡场|鸡都?在|鸡群|出鸡|孵化|图鉴|蛋.{0,8}(哪|多少|几颗|几只)/;
    function farmAnswer(q) {
      if (!FARM_Q.test(q)) return null;
      const s = snap();
      if (!s) return null;
      const where = Object.entries(s.pagesMap || {}).filter(([, n]) => n > 0)
        .map(([p, n]) => `${FARM_CN[p] || p} ${n} 只`);
      const lines = [`东家清点：鸡 ${s.chickens} 只。`];
      lines.push(where.length ? `${where.join('，')}；还有 ${Math.max(0, s.eggs - s.chickens)} 颗蛋没孵。` : '都在鸡篮里待着，还没放出本页。');
      lines.push(s.dex_left > 0 ? `图鉴还差 ${s.dex_left} 个品种，点空白处多下几颗蛋就有了。` : '图鉴已经集齐，就等东家来领证书。');
      return lines.join('');
    }

    /* 取值与条件（tags 语法见 butler-script.json meta.grammar） */
    function value(key) {
      if (key in vars) return vars[key];
      const s = snap();
      if (s) {
        if (key === 'pages') return s.elsewhere;
        if (key in s.breeds) return s.breeds[key];
        if (key in s.pagesMap) return s.pagesMap[key];
        if (key === 'chickens' || key === 'eggs' || key === 'dex_left' || key === 'here') return s[key];
      }
      return 0;
    }
    function cond(expr) {
      const m = /^(!?)([a-z_]+)(?:(>=|<=|>|<|=)(-?\d+))?$/.exec(String(expr).trim());
      if (!m) return true;
      const v = Number(value(m[2]));
      if (m[3]) {
        const n = Number(m[4]);
        if (m[3] === '>') return v > n;
        if (m[3] === '<') return v < n;
        if (m[3] === '>=') return v >= n;
        if (m[3] === '<=') return v <= n;
        return v === n;
      }
      const b = m[2] === 'met_before' || m[2] === 'gift_used' ? !!value(m[2]) : Number(value(m[2])) > 0;
      return m[1] ? !b : b;
    }
    function applyTags(tags) {
      for (const tag of tags || []) {
        if (!tag.startsWith('set:')) continue;
        const m = /^set:([a-z_]+)=([+-]?\w+)$/.exec(tag);
        if (!m) continue;
        const [, k, raw] = m;
        if (raw === 'true') vars[k] = true;
        else if (raw === 'false') vars[k] = false;
        else if (raw.startsWith('+')) vars[k] = (Number(vars[k]) || 0) + Number(raw.slice(1));
        else vars[k] = Number(raw) || 0;
        if (k === 'gift_used') { try { sessionStorage.setItem(GIFT_KEY, '1'); } catch { /* 隐私模式 */ } }
      }
      persistVars();
    }

    /* 插值：{key} 换成快照里的数或短语 */
    const PAGE_NAMES = { home: '首页', works: '作品页', about: '关于页', news: '动态页', contact: '合作页' };
    function fill(t) {
      const s = snap();
      return String(t).replace(/\{([a-z_]+)\}/g, (_, key) => {
        if (key === 'pages' && s) {
          const items = Object.entries(s.pagesMap)
            .filter(([p]) => p !== (document.body.dataset.page || 'home'))
            .map(([p, n]) => `${PAGE_NAMES[p] || p} ${n} 只`);
          return items.length ? items.join('、') : '都在本页待着';
        }
        const v = value(key);
        return String(v);
      });
    }

    /* 标记解释器：[[FARM:*]] / [[COOP]] 不进正文，转总线命令（与后端扣留同一协议） */
    const MARK = /\[\[\s*(FARM:[a-z:|]+|COOP)\s*\]\]/g;
    const VALID = /^(gift:egg|goto:(home|works|about|news|contact)|map|concert:(twinkle|ode|birthday|greensleeves)|coop)$/
    function stripMarks(t) {
      const cmds = [];
      const shown = String(t).replace(MARK, (_, m) => {
        const cmd = m === 'COOP' ? 'coop' : m.slice(5);
        if (VALID.test(cmd)) cmds.push(cmd);
        return '';
      });
      return { shown: shown.replace(/\s{2,}/g, ' ').trim(), cmds };
    }
    function emitButlerCmd(cmd) {
      if (cmd === 'coop') {
        /* 就在同一个 log 里放名片，不再跳别处 */
        showCoopCard();
        return;
      }
      window.dispatchEvent(new CustomEvent('farm:cmd', { detail: { type: cmd } }));
    }

    /* 管家打字机：40-70ms/字，标点停顿 */
    const BUTLER_BASE = 46;
    const BUTLER_PAUSE = { '，': 140, '、': 140, '：': 160, '；': 160, '。': 220, '？': 220, '～': 200 };
    let butlerTimer = 0;
    function butlerType(text, done) {
      window.clearTimeout(butlerTimer);
      const p = appendButlerEl();
      butlerTyping = true;
      syncControls();
      /* 打字期间隐去 markdown 链接语法，收尾时与普通消息一致地 linkify */
      const shown = String(text || '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
      const finish = () => {
        p.replaceChildren();
        if (text) linkify(p, text);
        butlerTyping = false;
        syncControls();
        if (done) done();
      };
      if (reduce || !shown) {
        finish();
        return;
      }
      let i = 0;
      const step = () => {
        i += 1;
        p.textContent = shown.slice(0, i);
        log.scrollTop = log.scrollHeight;
        if (i >= shown.length) {
          finish();
          return;
        }
        const ch = shown[i - 1];
        butlerTimer = window.setTimeout(step, BUTLER_PAUSE[ch] || BUTLER_BASE + Math.random() * 12);
      };
      step();
    }

    /* 剧本引擎：扁平节点字典，显式 next；管家消息逐行进同一个 log，选项进 chips 行 */
    let butler = null;
    let llmTurns = [];
    function enterButler() {
      if (butler) { openDialog(); return; }
      butler = { node: null, queue: [], llmNode: null };
      llmTurns = [];
      if (input) input.placeholder = '想问管家什么，直接说';
      openDialog();
      gotoNode(butlerScript.meta.root);
    }
    function exitButler() {
      window.clearTimeout(butlerTimer);
      butler = null;
      llmTurns = [];
      butlerTyping = false;
      butlerPending = false;
      if (input) input.placeholder = DEFAULT_PLACEHOLDER;
      if (quickBox) quickBox.replaceChildren(...normalChips);
      syncControls();
    }
    function gotoNode(id, atChoices = false) {
      if (!butler) return;
      if (id === '__close') { exitButler(); return; }
      const node = nodes[id];
      if (!node) return;
      butler.node = node;
      if (node.llm) {
        butler.llmNode = node;
        runLlmIntro(node);
        return;
      }
      if (atChoices) { showChoices(node); return; }
      butler.queue = (node.lines || []).filter((line) => (line.tags || []).every((t) => !t.startsWith('if:') || cond(t.slice(3))));
      nextLine();
    }
    function nextLine() {
      if (!butler) return;
      const line = butler.queue.shift();
      if (line === undefined) {
        if (butler.node?.choices) showChoices(butler.node);
        else if (butler.node?.next) gotoNode(butler.node.next);
        return;
      }
      applyTags(line.tags);
      const { shown, cmds } = stripMarks(fill(line.text));
      record({ r: 'butler', t: shown });
      butlerType(shown, () => {
        cmds.forEach(emitButlerCmd); // 标记在台词讲完时生效，动画和话音同步
        nextLine();
      });
    }
    function showChoices(node) {
      if (!quickBox) return;
      butlerTyping = false;
      quickBox.replaceChildren();
      for (const c of node.choices || []) {
        const ok = !c.if || cond(c.if);
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'mimi-butlerchip';
        b.textContent = c.label;
        b.disabled = !ok; // 条件不满足：置灰不可点（如今天的蛋已领过）
        if (!ok) {
          const note = document.createElement('i');
          note.textContent = '已办过';
          b.append(note);
        } else {
          b.addEventListener('click', () => gotoNode(c.next));
        }
        quickBox.append(b);
      }
    }
    function runLlmIntro(node) {
      const intro = (node.lines || [])[0];
      if (intro) {
        applyTags(intro.tags);
        const { shown, cmds } = stripMarks(fill(intro.text));
        record({ r: 'butler', t: shown });
        butlerType(shown, () => cmds.forEach(emitButlerCmd));
      }
    }
    /* 管家自由聊：接现有 /api/chat，农场状态随 payload 上送（mimi-core 透传 farm） */
    /* 管家模式的本地启发式（仅 API 不可达时的兜底；线上走 /api/chat 的管家人格） */
    const BUTLER_CN = { home: '首页', works: '作品页', about: '关于页', news: '动态页', contact: '合作页' };
    const BUTLER_SONGS = [
      { key: 'greensleeves', re: /绿袖子|greensleeves/i, title: '绿袖子' },
      { key: 'twinkle', re: /小星星|一闪一闪/, title: '小星星' },
      { key: 'ode', re: /欢乐颂|贝多芬/, title: '欢乐颂' },
      { key: 'birthday', re: /生日|祝.*(生日)/, title: '生日快乐' },
    ];
    function butlerLocal(q) {
      if (/随便|随你|你定|都行|看你/.test(q)) {
        const pick = ['works', 'about', 'news'][Math.floor(Math.random() * 3)];
        return { text: `那我说了算啦——去${BUTLER_CN[pick]}逛逛，替我向那边的鸡问好。`, cmd: `goto:${pick}` };
      }
      const song = BUTLER_SONGS.find((s) => s.re.test(q));
      if (song && /来首|来一|弹|唱|听|演奏|曲|音乐|concert/i.test(q + '曲')) {
        return { text: `《${song.title}》，预备——琴键升起来，客串的鸡也都到位了。`, cmd: `concert:${song.key}` };
      }
      if (/曲|琴|弹|音乐|演奏|唱/.test(q)) {
        return { text: '会的曲子有四首：《小星星》《欢乐颂》《生日快乐》《绿袖子》。说「来首绿袖子」就行～', cmd: null };
      }
      const m = q.match(/作品|关于|动态|新闻|合作/);
      if (m && /去|逛|放|到|飞/.test(q)) {
        const map = { 作品: 'works', 关于: 'about', 动态: 'news', 新闻: 'news', 合作: 'contact' };
        const page = map[m[0]];
        return { text: `好嘞，这就派几只去${BUTLER_CN[page]}，你到那儿点收。`, cmd: `goto:${page}` };
      }
      const place = q.replace(/[去逛放到飞。？?！!，,\s]/g, '').slice(0, 8);
      return { text: place ? `${place}？地图上没这一站。圈舍就这几处——作品页、关于页、动态页，要不你随便挑？` : '这句我先记下啦。能办的：报数、送蛋、放鸡去别的页面、要地图、来首曲子～' };
    }

    async function butlerAsk(q) {
      if (!butler || butlerPending || butlerTyping) return;
      const text = String(q || '').trim().slice(0, 400);
      if (!text) return;
      append('user', text);
      record({ r: 'user', t: text, b: 1 });
      input.value = '';
      llmTurns.push({ role: 'user', content: text });
      butlerPending = true;
      setState('thinking');
      let bubble = null;
      const result = await requestReply({
        messages: llmTurns.slice(-8),
        demo: false,
        farm: snap(),
        butler: true,
        onDelta(shown) {
          if (!bubble) {
            setState('answering');
            const item = document.createElement('div');
            item.className = 'mimi-msg bot is-butler';
            const plate = document.createElement('b');
            plate.className = 'mimi-plate';
            plate.textContent = '管家 Mimi';
            bubble = document.createElement('p');
            item.append(plate, bubble);
            log.append(item);
          }
          bubble.textContent = shown;
          log.scrollTop = log.scrollHeight;
        },
      });
      butlerPending = false;
      let reply = result.reply || '这个问题我答不准，我不猜。';
      let cmdsOverride = null;
      if (result.demo || result.failed) {
        const fb = butlerLocal(text);
        if (fb) { reply = fb.text; if (fb.cmd) cmdsOverride = [fb.cmd]; }
      }
      const { shown, cmds: foundCmds } = stripMarks(reply);
      const cmds = cmdsOverride || foundCmds;
      llmTurns.push({ role: 'assistant', content: shown });
      const backId = (butler.llmNode && butler.llmNode.back) || 'hub';
      const back = () => {
        setState('idle');
        gotoNode(backId, true); // 回话题轮盘，不重播 hub 开场白
      };
      if (result.streamed && bubble) {
        record({ r: 'butler', t: shown });
        finishText(bubble, shown, () => {
          cmds.forEach(emitButlerCmd);
          back();
        });
      } else {
        if (bubble?.parentElement) bubble.parentElement.remove();
        setState('answering');
        record({ r: 'butler', t: shown });
        butlerType(shown, () => {
          cmds.forEach(emitButlerCmd);
          back();
        });
      }
    }

    /* ===== 普通聊：同一输入行，同一 log ===== */
    async function ask(text) {
      const q = String(text || '').trim().slice(0, 400);
      if (!q || busy || butler) return;
      busy = true;
      window.clearInterval(typer);
      append('user', q);
      record({ r: 'user', t: q });
      input.value = '';
      setState('thinking');
      const t0 = performance.now();
      /* 演示态兜底：鸡场问题用本地账本直接答（线上 API 可用时永远不走这里） */
      if (demo) {
        const fa = farmAnswer(q);
        if (fa) {
          await new Promise((r) => setTimeout(r, reduce ? 80 : 420));
          append('bot', fa, true);
          record({ r: 'bot', t: fa });
          busy = false;
          setState('idle');
          return;
        }
      }
      let bubble = null;
      const result = await requestReply({
        messages: chatHistory(),
        demo,
        onDelta(shown) {
          if (!bubble) {
            setState('answering');
            const item = document.createElement('div');
            item.className = 'mimi-msg bot';
            bubble = document.createElement('p');
            item.append(bubble);
            log.append(item);
          }
          bubble.textContent = shown;
          log.scrollTop = log.scrollHeight;
        },
      });
      if (result.demo && !demo) {
        demo = true;
        session.demo = true;
        persist();
      }
      let streamed = result.streamed;
      if (result.threw && bubble?.parentElement) {
        bubble.parentElement.remove();
        bubble = null;
        streamed = false;
      }
      const { reply, showCoop, failed } = result;
      const after = () => { if (showCoop) showCoopCard(); };
      if (failed) {
        setState('error');
        if (bubble) bubble.textContent = reply;
        else append('bot', reply, false);
        busy = false;
        window.setTimeout(() => { if (state === 'error') setState('idle'); }, reduce ? 0 : 700);
        return;
      }
      if (!streamed && !reduce) {
        const wait = 360 - (performance.now() - t0);
        if (wait > 0) await new Promise((r) => setTimeout(r, wait));
      }
      if (streamed && bubble) {
        record({ r: 'bot', t: reply });
        finishText(bubble, reply, after);
      } else {
        setState('answering');
        append('bot', reply, true, after);
        record({ r: 'bot', t: reply });
      }
      busy = false;
    }

    /* ===== 开合：bench 常开（in-flow），panel 浮层开合 ===== */
    let motion = { hover: false, open: false, attention: false };
    let rig = null;
    function applyMotion() {
      root.dataset.motion = mimiMotion(motion);
      if (!rig) return;
      rig.setHover(motion.hover);
      rig.setOpen(motion.open);
    }
    function openDialog() {
      if (bench) {
        log.scrollTop = log.scrollHeight;
        return;
      }
      window.clearTimeout(closeTimer);
      motion.open = true;
      applyMotion();
      panel.hidden = false;
      placePanel();
      root.classList.remove('is-open');
      requestAnimationFrame(() => {
        panel.getBoundingClientRect();
        requestAnimationFrame(() => root.classList.add('is-open'));
      });
      launch.setAttribute('aria-expanded', 'true');
      if (window.innerWidth <= 768) document.body.classList.add('mimi-open');
      if (window.innerWidth > 768) input.focus();
      else closeBtn?.focus();
    }
    function hidePanel() {
      panel.hidden = true;
      window.clearTimeout(closeTimer);
    }
    function closeDialog() {
      if (bench) return;
      window.clearTimeout(closeTimer);
      motion.open = false;
      applyMotion();
      root.classList.remove('is-open');
      launch.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('mimi-open');
      if (reduce) hidePanel();
      else closeTimer = window.setTimeout(hidePanel, 520);
      launch.focus();
    }
    function toggleDialog() {
      if (root.classList.contains('is-open')) closeDialog();
      else openDialog();
    }

    function primeCoop() {
      if (coopPrimed) return;
      coopPrimed = true;
      input.placeholder = '例如：想做一场民乐音画';
      append('bot', COOP_LINE, false);
      record({ r: 'bot', t: COOP_LINE });
    }
    let coopPrimed = false;

    /* ===== 浮层专属：拖拽、Rive、定位（bench 跳过） ===== */
    const STORE = 'mimi-dock';
    let pointer = null;
    let suppressClick = false;
    let springRaf = 0;
    let custom = false;
    const vel = { x: 0, y: 0 };
    const pos = { x: 0, y: 0, side: 'right' };
    let placeBubble = () => {};

    function btnSize() { return window.innerWidth <= 768 ? 60 : 72; }
    function edge() { return window.innerWidth <= 768 ? 14 : 22; }
    function view() {
      const vv = window.visualViewport;
      if (!vv) return { x: 0, y: 0, w: window.innerWidth, h: window.innerHeight };
      return { x: vv.offsetLeft, y: vv.offsetTop, w: vv.width, h: vv.height };
    }
    function clamp(x, y) {
      const v = view();
      const s = btnSize();
      const m = 8;
      return {
        x: Math.min(Math.max(v.x + m, x), v.x + v.w - s - m),
        y: Math.min(Math.max(v.y + m, y), v.y + v.h - s - m),
      };
    }
    function safeBottom() {
      const n = parseFloat(getComputedStyle(root).getPropertyValue('--safe-b'));
      return Number.isFinite(n) ? n : 0;
    }
    function defaultPos() {
      const s = btnSize();
      const v = view();
      const m = edge();
      const safe = safeBottom();
      let lift = m + safe;
      if (window.innerWidth <= 768) {
        const peek = document.querySelector('.m-peek');
        const peekOn = !!peek && peek.getClientRects().length > 0;
        lift = (peekOn ? 76 : 16) + safe;
      }
      let y = v.y + v.h - lift - s;
      const x = v.x + v.w - m - s;
      if (window.innerWidth > 768) {
        const listen = document.querySelector('.listen');
        if (listen) {
          const r = listen.getBoundingClientRect();
          const hit = r.width > 0 && r.right > x - 12 && r.left < x + s + 12 && r.bottom > y - 8 && r.top < y + s;
          if (hit) y = r.top - s - 16;
        }
      }
      const c = clamp(x, y);
      return { x: c.x, y: c.y, side: 'right' };
    }
    function readStore() {
      try {
        const data = JSON.parse(localStorage.getItem(STORE) || '');
        if (!data) return null;
        if (typeof data.x === 'number' && typeof data.y === 'number') return data;
        if ((data.side === 'left' || data.side === 'right') && typeof data.y === 'number') return data;
        return null;
      } catch { return null; }
    }
    function save() {
      try { localStorage.setItem(STORE, JSON.stringify({ x: pos.x, y: pos.y })); } catch { /* private mode */ }
    }
    function setSide() {
      const v = view();
      pos.side = pos.x + btnSize() / 2 < v.x + v.w / 2 ? 'left' : 'right';
    }
    function paint() {
      launch.style.left = `${pos.x}px`;
      launch.style.top = `${pos.y}px`;
      launch.style.right = 'auto';
      launch.style.bottom = 'auto';
      root.dataset.side = pos.side;
      if (!panel.hidden) placePanel();
    }
    function topLimit() {
      const v = view();
      let top = v.y + 8;
      if (window.innerWidth <= 768) {
        const header = document.querySelector('header.top');
        if (header) {
          const r = header.getBoundingClientRect();
          if (r.width > 0 && r.bottom > top) top = r.bottom + 8;
        }
      }
      return top;
    }
    function placePanel() {
      const v = view();
      const s = btnSize();
      const margin = 8;
      const gap = 12;
      const minTop = topLimit();
      const maxW = Math.min(400, v.w - margin * 2);
      const maxH = Math.min(740, Math.max(240, v.y + v.h - margin - minTop));
      const cx = pos.x + s / 2;
      const roomL = cx - v.x;
      const roomR = v.x + v.w - cx;
      let left = roomR >= roomL ? pos.x + s + gap : pos.x - gap - maxW;
      left = Math.min(Math.max(v.x + margin, left), v.x + v.w - margin - maxW);
      let top = pos.y - gap - maxH;
      if (top < minTop) top = pos.y + s + gap;
      if (top + maxH > v.y + v.h - margin) top = Math.max(minTop, v.y + v.h - margin - maxH);
      if (top < minTop) top = minTop;
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
      panel.style.width = `${maxW}px`;
      panel.style.height = `${maxH}px`;
      panel.style.transformOrigin = `${cx - left}px ${pos.y + s / 2 - top}px`;
    }
    function dockFromStore() {
      const saved = readStore();
      custom = !!saved;
      if (!saved) {
        const d = defaultPos();
        pos.x = d.x; pos.y = d.y; pos.side = d.side;
        return;
      }
      if (typeof saved.x === 'number') {
        const c = clamp(saved.x, saved.y);
        pos.x = c.x; pos.y = c.y;
      } else {
        const s = btnSize();
        const v = view();
        const m = edge();
        const x = saved.side === 'left' ? v.x + m : v.x + v.w - m - s;
        const c = clamp(x, saved.y);
        pos.x = c.x; pos.y = c.y;
      }
      setSide();
    }
    function springTo(tx, ty) {
      cancelAnimationFrame(springRaf);
      vel.x = vel.y = 0;
      try { localStorage.setItem(STORE, JSON.stringify({ x: tx, y: ty })); } catch { /* private mode */ }
      if (reduce) {
        pos.x = tx; pos.y = ty;
        setSide(); paint();
        return;
      }
      let last = performance.now();
      const step = (now) => {
        const dt = Math.min(0.032, (now - last) / 1000);
        last = now;
        vel.x += (220 * (tx - pos.x) - 16 * vel.x) * dt;
        vel.y += (220 * (ty - pos.y) - 16 * vel.y) * dt;
        pos.x += vel.x * dt;
        pos.y += vel.y * dt;
        setSide();
        paint();
        if (Math.hypot(tx - pos.x, ty - pos.y) < 0.6 && Math.hypot(vel.x, vel.y) < 14) {
          pos.x = tx; pos.y = ty; vel.x = vel.y = 0;
          setSide(); paint();
          return;
        }
        springRaf = requestAnimationFrame(step);
      };
      springRaf = requestAnimationFrame(step);
    }
    function releasePlace() {
      const v = view();
      const s = btnSize();
      const m = edge();
      const c = clamp(pos.x, pos.y);
      let x = c.x;
      let y = c.y;
      const distL = x - v.x;
      const distR = v.x + v.w - (x + s);
      const distT = y - v.y;
      const distB = v.y + v.h - (y + s);
      if (Math.min(distL, distR) < 80) x = distL <= distR ? v.x + m : v.x + v.w - m - s;
      if (Math.min(distT, distB) < 80) y = distT <= distB ? v.y + m : v.y + v.h - m - s;
      const next = clamp(x, y);
      pos.side = next.x + s / 2 < v.x + v.w / 2 ? 'left' : 'right';
      if (Math.hypot(next.x - pos.x, next.y - pos.y) > 1) springTo(next.x, next.y);
      else {
        pos.x = next.x; pos.y = next.y;
        setSide(); paint(); save();
      }
    }

    if (!bench && launch && face && panel && log && form && input && quickBox && hi && canvas) {
      dockFromStore();
      paint();

      let attentionTimer = 0;
      let glanceQueued = false;
      function pulseAttention() {
        if (reduce) return;
        motion.attention = true;
        applyMotion();
        if (rig) rig.attention();
        else glanceQueued = true;
        window.clearTimeout(attentionTimer);
        attentionTimer = window.setTimeout(() => {
          motion.attention = false;
          applyMotion();
        }, 900);
      }
      function watchWorks(el) {
        if (reduce || !el || !el.getClientRects().length) return;
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight || 1;
        if (rect.top < vh * 0.7 && rect.bottom > vh * 0.3) return;
        const io = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          pulseAttention();
          io.disconnect();
        }, { threshold: 0.45 });
        io.observe(el);
      }
      if (!reduce) {
        window.setTimeout(pulseAttention, 1500);
        watchWorks(document.getElementById('picks'));
        watchWorks(document.getElementById('fs-stage'));
        watchWorks(document.querySelector('.wf-top'));
      }
      mountMimiRive(canvas, reduce).then((next) => {
        if (!next || reduce) {
          next?.cleanup();
          return;
        }
        rig = next;
        applyMotion();
        if (glanceQueued || motion.attention) {
          rig.attention();
          glanceQueued = false;
        }
      });
      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => rig?.resize());
        ro.observe(face);
      }
      matchMedia('(prefers-reduced-motion: reduce)').addEventListener?.('change', (e) => {
        reduce = e.matches;
        if (!reduce) return;
        window.clearTimeout(attentionTimer);
        rig?.cleanup();
        rig = null;
        motion.attention = false;
        motion.hover = false;
        applyMotion();
      });

      placeBubble = () => {
        hi.style.marginLeft = '0px';
        const r = hi.getBoundingClientRect();
        if (r.left < 8) hi.style.marginLeft = `${Math.round(8 - r.left)}px`;
        else if (r.right > window.innerWidth - 8) hi.style.marginLeft = `${Math.round(window.innerWidth - 8 - r.right)}px`;
        launch.classList.toggle('is-below', launch.getBoundingClientRect().top < 52);
      };
      const fineHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
      launch.addEventListener('pointerenter', (e) => {
        if (!fineHover || e.pointerType !== 'mouse') return;
        launch.classList.add('is-hot');
        motion.hover = true;
        applyMotion();
        placeBubble();
      });
      launch.addEventListener('pointerleave', () => {
        launch.classList.remove('is-hot');
        motion.hover = false;
        applyMotion();
      });

      let lastCrumb = 0;
      function crumb(x, y, vx, vy) {
        if (reduce) return;
        const now = performance.now();
        if (now - lastCrumb < 16) return;
        lastCrumb = now;
        const speed = Math.hypot(vx, vy) || 1;
        const ux = vx / speed;
        const uy = vy / speed;
        [10, 28].forEach((back, i) => {
          const el = document.createElement('i');
          el.className = 'mimi-crumb';
          const size = i === 0 ? 22 : 14;
          el.style.width = `${size}px`;
          el.style.height = `${size}px`;
          el.style.left = `${x - ux * back - size / 2}px`;
          el.style.top = `${y - uy * back - size / 2}px`;
          document.body.append(el);
          el.addEventListener('animationend', () => el.remove());
        });
      }
      function bounceBack() {
        launch.classList.remove('is-press');
        if (reduce) return;
        launch.classList.add('is-flash');
        window.setTimeout(() => launch.classList.remove('is-flash'), 460);
      }

      launch.addEventListener('dragstart', (e) => e.preventDefault());
      launch.addEventListener('pointerdown', (e) => {
        if (e.button != null && e.button !== 0) return;
        if (e.cancelable) e.preventDefault();
        cancelAnimationFrame(springRaf);
        launch.setPointerCapture?.(e.pointerId);
        pointer = {
          id: e.pointerId,
          type: e.pointerType,
          x: e.clientX,
          y: e.clientY,
          ox: pos.x,
          oy: pos.y,
          lx: e.clientX,
          ly: e.clientY,
          lt: performance.now(),
          moved: false,
          held: false,
          holdTimer: 0,
        };
        if (e.pointerType === 'touch') {
          launch.classList.add('is-press');
          pointer.holdTimer = window.setTimeout(() => {
            if (!pointer || pointer.moved) return;
            pointer.held = true;
            placeBubble();
          }, 300);
        }
      });
      launch.addEventListener('pointermove', (e) => {
        if (!pointer || e.pointerId !== pointer.id) return;
        const dx = e.clientX - pointer.x;
        const dy = e.clientY - pointer.y;
        if (!pointer.moved && Math.hypot(dx, dy) > 6) {
          pointer.moved = true;
          window.clearTimeout(pointer.holdTimer);
          launch.classList.add('is-drag');
          launch.classList.remove('is-hot', 'is-press', 'is-nod');
          motion.hover = false;
          applyMotion();
          try { if (navigator.vibrate) navigator.vibrate(10); } catch { /* 桌面浏览器没有振动 */ }
        }
        if (!pointer.moved) return;
        if (e.cancelable) e.preventDefault();
        const now = performance.now();
        const dt = Math.max(16, now - pointer.lt);
        const vx = (e.clientX - pointer.lx) / dt;
        const vy = (e.clientY - pointer.ly) / dt;
        pointer.lx = e.clientX; pointer.ly = e.clientY; pointer.lt = now;
        const c = clamp(pointer.ox + dx, pointer.oy + dy);
        pos.x = c.x; pos.y = c.y;
        setSide();
        paint();
        crumb(pos.x + btnSize() / 2, pos.y + btnSize() / 2, vx, vy);
      });
      function endPointer(e) {
        if (!pointer || (e && e.pointerId !== pointer.id)) return;
        const moved = pointer.moved;
        const held = pointer.held;
        const kind = pointer.type;
        window.clearTimeout(pointer.holdTimer);
        pointer = null;
        launch.classList.remove('is-drag', 'is-press');
        if (moved) {
          suppressClick = true;
          justDragged = true;
          custom = true;
          launch.classList.remove('is-hot', 'is-nod');
          releasePlace();
          window.setTimeout(() => { suppressClick = false; justDragged = false; }, 400);
          return;
        }
        if (held && kind === 'touch') {
          suppressClick = true;
          bounceBack();
          window.setTimeout(() => launch.classList.remove('is-hot', 'is-nod'), 700);
          window.setTimeout(() => { suppressClick = false; }, 400);
          return;
        }
        if (kind === 'touch') bounceBack();
        suppressClick = true;
        toggleDialog();
        window.setTimeout(() => { suppressClick = false; }, 400);
      }
      launch.addEventListener('pointerup', endPointer);
      launch.addEventListener('pointercancel', endPointer);
      launch.addEventListener('click', (e) => {
        if (suppressClick) {
          suppressClick = false;
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        toggleDialog();
      });

      const refit = () => {
        cancelAnimationFrame(springRaf);
        if (!custom) {
          const d = defaultPos();
          pos.x = d.x; pos.y = d.y; pos.side = d.side;
        } else {
          const c = clamp(pos.x, pos.y);
          pos.x = c.x; pos.y = c.y;
          setSide();
          save();
        }
        paint();
        rig?.resize();
        document.body.classList.toggle('mimi-open', root.classList.contains('is-open') && window.innerWidth <= 768);
      };
      window.addEventListener('resize', refit);
      window.addEventListener('load', () => { if (!custom) refit(); });
      if (document.fonts) document.fonts.ready.then(() => { if (!custom) refit(); });
      const vv = window.visualViewport;
      if (vv) {
        const keepInView = () => {
          const c = clamp(pos.x, pos.y);
          if (c.x !== pos.x || c.y !== pos.y) {
            pos.x = c.x; pos.y = c.y;
            setSide();
            if (custom) save();
          }
          paint();
        };
        vv.addEventListener('resize', keepInView);
        vv.addEventListener('scroll', keepInView);
      }
    }

    /* ===== 总线与入口 ===== */
    /* 鸡场 HUD「管家」按钮 → farm:cmd butler → 唯一对话框切管家模式 */
    window.addEventListener('farm:cmd', (e) => {
      if (e.detail?.type === 'butler') enterButler();
    });
    let toastEl = null;
    let toastTimer = 0;
    function toast(text) {
      if (!toastEl) {
        toastEl = document.createElement('div');
        toastEl.className = 'mimi-toast';
        toastEl.setAttribute('role', 'status');
        document.body.append(toastEl);
      }
      toastEl.textContent = text;
      toastEl.hidden = false;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toastEl.hidden = true; }, 4200);
    }
    /* farm:say：对话框开着就在 log 里以管家名义播，收着用小告示 */
    window.addEventListener('farm:say', (e) => {
      const t = String(e.detail?.text || '');
      if (!t) return;
      const open = bench || root.classList.contains('is-open');
      if (open && !butlerTyping) {
        record({ r: 'butler', t });
        butlerType(t);
      } else {
        toast(t);
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      if (butler) butlerAsk(q);
      else ask(q);
    });
    for (const b of normalChips) {
      if (b === farmChip || b === butlerChip) continue;
      b.addEventListener('click', () => ask(b.textContent || ''));
    }
    feishuBtn?.addEventListener('click', showCoopCard);
    imFeishu?.addEventListener('click', showCoopCard);
    mailBtn?.addEventListener('click', showMailCard);
    /* 进鸡场：广播 farm:toggle（ChickenFarm 监听，开着=收起/关着=打开），浮层收起让位 */
    farmChip?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('farm:toggle'));
      if (!bench) closeDialog();
    });
    butlerChip?.addEventListener('click', enterButler);
    closeBtn?.addEventListener('click', closeDialog);

    document.addEventListener('mimi:open', (e) => {
      openDialog();
      if (e.detail?.intent === 'coop') primeCoop();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (light && !light.hidden) { light.hidden = true; return; }
      if (!bench && root.classList.contains('is-open')) closeDialog();
    });
    document.addEventListener('click', (e) => {
      if (bench) return;
      if (justDragged) { justDragged = false; return; }
      if (light && light.contains(e.target)) return;
      if (e.target instanceof Element && e.target.closest('[data-mimi-open]')) return;
      if (!root.classList.contains('is-open') || root.contains(e.target)) return;
      closeDialog();
    });
    root.addEventListener('touchstart', (e) => e.stopPropagation(), { passive: true });

    /* #feishu / #mail / #wechat / #start 落地：开对话框并放对应卡片（页脚社交链接指向这里） */
    function applyHash() {
      const h = location.hash.replace('#', '');
      if (h === 'feishu') { openDialog(); showCoopCard(); }
      else if (h === 'mail') { openDialog(); showMailCard(); }
      else if (h === 'wechat') { openDialog(); showWechatCard(); }
      else if (h === 'start') { openDialog(); primeCoop(); }
    }
    window.addEventListener('hashchange', applyHash);

    /* ===== 恢复会话：有历史就不重播开场白 ===== */
    if (session.entries.length) {
      for (const e of session.entries) {
        if (e.r === 'user') append('user', e.t, false);
        else if (e.r === 'bot') append('bot', e.t, false);
        else if (e.r === 'butler') {
          const p = appendButlerEl();
          p.replaceChildren();
          linkify(p, e.t);
        }
        else if (e.r === 'card' && e.k === 'coop') buildCoopCard();
        else if (e.r === 'card' && e.k === 'mail') buildMailCard();
        else if (e.r === 'card' && e.k === 'wechat') buildWechatCard();
      }
    } else {
      append('bot', GREETING, false);
      record({ r: 'bot', t: GREETING });
    }
    log.scrollTop = log.scrollHeight;
    if (location.hash) applyHash();
  }
</script>
