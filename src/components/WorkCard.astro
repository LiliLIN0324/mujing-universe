---
const { w } = Astro.props;
const img = w.images[0] || w.icon;
---
<a class="wc reveal" href={`/works/${w.slug}/`} data-line={w.line} data-year={w.yearNum}>
  <div class="wc-img">
    <img data-r2 loading="lazy" src={img} alt="" referrerpolicy="no-referrer"/>
    {w.status === '进行中' && <span class="badge">进行中</span>}
  </div>
  <h3>{w.title}</h3>
  <p class="wc-meta">{w.line} · {w.yearNum || w.year || '—'}</p>
</a>
<style>
.wc {
  display: block;
  color: inherit;
  text-decoration: none;
}
.wc-img {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--bg2);
}
.wc-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.badge {
  position: absolute;
  left: 12px;
  top: 12px;
  background: var(--paper);
  color: var(--ink);
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 500;
  padding: 4px 10px;
}
.wc h3 {
  margin: 16px 0 4px;
  font-size: 19px;
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.35;
}
.wc-meta {
  margin: 0;
  color: var(--muted);
  font-family: var(--en), var(--sans);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.02em;
}
</style>
