---
const { w } = Astro.props;
const img = w.images[0] || w.icon;
---
<a class="wc reveal" href={`/works/${w.slug}/`} data-line={w.line} data-year={w.yearNum}>
  <div class="wc-img">
    <img data-r2 loading="lazy" src={img} alt={w.title} referrerpolicy="no-referrer"/>
    {w.status === '进行中' && <span class="badge">进行中</span>}
    <div class="wc-shade">
      <h3>{w.title}</h3>
      <p class="wc-tags">{w.line} · {w.yearNum || w.year || '—'}</p>
    </div>
  </div>
</a>
<style>
.wc {
  text-decoration: none;
  display: block;
  color: inherit;
  border-radius: 20px;
  transition: transform 0.35s ease;
}
.wc:hover { transform: translateY(-6px); }
.wc-img {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: 20px;
  background: #1a1a1a;
}
.wc-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}
.wc:hover .wc-img img { transform: scale(1.03); }
.badge {
  position: absolute;
  left: 14px;
  top: 14px;
  z-index: 2;
  background: var(--cinnabar);
  color: #fff;
  border-radius: 999px;
  font-size: 0.75rem;
  padding: 4px 10px;
}
.wc-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 56px 18px 16px;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
}
.wc h3 {
  margin: 0;
  color: #fff;
  font-family: var(--sans);
  font-size: 1.05rem;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.35;
}
.wc-tags {
  margin: 4px 0 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.82rem;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
</style>
