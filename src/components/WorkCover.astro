---
/** /works/ 16:9 封面。有核对过的视频时叠一层静音预览，没有就只留静图或排版封面。 */
import { WORKS_COVER, coverClip, splitTitle, titleWidth } from '../lib';
const { w, eager = false } = Astro.props;
const c = WORKS_COVER[w.slug];
const clip = coverClip(w.slug);
const [main, sub0] = splitTitle(w.title);
const sub = sub0 || w.category || '';
const style = c ? [`object-position:${c.pos || '50% 50%'}`, c.scale ? `transform:scale(${c.scale})` : ''].filter(Boolean).join(';') : '';
---
<div class:list={['cv', !c && 'fb', clip && 'has-clip']}>
  <div class="cv-frame">
    {c && <img src={c.src} alt="" style={style} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" referrerpolicy="no-referrer" data-cv-img />}
    {clip && (
      <video class="cv-video" data-src={clip} muted loop playsinline webkit-playsinline preload="none" disablepictureinpicture aria-hidden="true"></video>
    )}
  </div>
  {clip && <button class="cv-play" type="button" aria-pressed="false" aria-label="播放预览">预览</button>}
  <span class="fb-no">{w.no}</span>
  <div class="fb-t"><b class:list={['fb-title', titleWidth(main) > 22 && 'long']}>{main}</b>{sub && <i class="fb-sub">{sub}</i>}</div>
  <span class="fb-meta">{w.line} · {w.yearNum || w.year}</span>
</div>
