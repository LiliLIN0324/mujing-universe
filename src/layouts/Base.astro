---
import '../styles/global.css';
import MimiChat from '../components/MimiChat.astro';
import ChickenFarm from '../components/ChickenFarm.astro';
const {
  title = '幕景宇宙 · 林丽丽艺术工作室',
  description = '幕景宇宙 · 林丽丽艺术工作室。以艺术家林丽丽为核心的 AIGC 文化艺术工作室，浙江杭州。',
  image = '/ring/0.jpg',
  active = '',
  home = false,
  navClass = '',
} = Astro.props;
const links = [['/works/', '作品'], ['/artist/', '艺术家'], ['/studio/', '工作室'], ['/contact/', '合作']];
// Every page uses the homepage 'Scendance Space' bar (header.top.top--home). `home` pages (homepage, work detail)
// keep the auto-hide/overlay behaviour; all other pages add 'top--page': always visible, in flow, on the paper colour.
const pageNav = navClass.split(' ').filter((c) => c && c !== 'top--unified').join(' ');
const foot = [['/works/', '作品'], ['/artist/', '艺术家'], ['/studio/', '工作室'], ['/contact/', '合作']];
const canonical = Astro.site ? new URL(Astro.url.pathname + Astro.url.search, Astro.site).href : '';
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
// 鸡场接线（farm-dev 临时，一键回滚 = 删掉这几行 + 模板里 farm-egg / 两个组件标签 + global.css 的 .farm-egg 段）：
// 站点是纯静态构建，构建期看不到 query，所以组件在非 /contact/ 页常驻输出、由组件脚本自查 ?farm=1 决定是否启用。
const farmPath = Astro.url.pathname;
const isContact = farmPath.startsWith('/contact');
const page = isContact ? 'contact' : farmPath.startsWith('/works') ? 'works' : farmPath.startsWith('/about') ? 'about' : farmPath.startsWith('/news') ? 'news' : 'home';
const farmHref = `${farmPath}?farm=1`; // 蛋按钮的无 JS 兜底；已开鸡场时由页脚脚本纠正为关闭
---
<html lang="zh-CN">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#FFFFFF"/>
  <script is:inline>
  // Apply the saved (or system) theme before first paint, so night mode never flashes.
  (function () {
    try {
      var t = localStorage.getItem('mj-theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', '#131316');
      }
    } catch (e) {}
  })();
  </script>
  <meta name="referrer" content="no-referrer"/>
  <meta name="format-detection" content="telephone=no"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="preload" href="/fonts/AlibabaPuHuiTi-3-55-Regular.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/CormorantSC-600-wordmark.woff2" as="font" type="font/woff2" crossorigin/>
  {canonical && <link rel="canonical" href={canonical}/>}
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="zh_CN"/>
  <meta property="og:site_name" content="幕景宇宙"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  {canonical && <meta property="og:url" content={canonical}/>}
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1920"/>
  <meta property="og:image:height" content="1080"/>
  <meta property="og:image:alt" content="幕景宇宙"/>
  <meta name="twitter:card" content="summary_large_image"/>
</head>
<body>
<a class="skip" href="#content">跳到主要内容</a>
{home ? (
<header class:list={["top top--home", navClass]} id="home-nav" data-autohide>
  <a class="wordmark" href="/" translate="no">幕景宇宙</a>
  <button class="menu-btn" id="home-menu-btn" type="button" aria-label="菜单" aria-expanded="false" aria-controls="home-menu"><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
  <nav id="home-menu">
    {links.map(([h, t]) => <a href={h} class={active === h ? 'on' : undefined}>{t}</a>)}
  </nav>
</header>
) : (
<header class:list={["top top--home top--page", pageNav]} id="home-nav">
  <a class="wordmark" href="/" translate="no">幕景宇宙</a>
  <button class="menu-btn" id="home-menu-btn" type="button" aria-label="菜单" aria-expanded="false" aria-controls="home-menu"><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
  <nav id="home-menu">
    {links.map(([h, t]) => <a href={h} class={active === h ? 'on' : undefined}>{t}</a>)}
  </nav>
</header>
)}
<div id="content">
<slot/>
</div>
<ChickenFarm page={page} />
<footer class="bot">
  <div>
    <strong>幕景宇宙 Mujing Universe</strong>
    <p>以艺术家林丽丽为核心的 AIGC 文化艺术工作室 · 浙江杭州</p>
    <p class="cap">© 2026 幕景宇宙</p>
  </div>
  <div>
    <span class="cap">站点</span>
    {foot.map(([h, t]) => <a href={h}>{t}</a>)}
  </div>
  <div>
    <span class="cap">说明</span>
    <p>作品图像用于工作室公开展示。商业使用与展览授权，请经合作页联系经纪人。</p>
  </div>
  {!isContact && (
    <a class="farm-egg" href={farmHref} aria-label="打开鸡场" title="幕景鸡场">
      <svg viewBox="0 0 60 72" aria-hidden="true"><path fill="currentColor" d="M30 4C44 4 54 24 54 42C54 58 43.5 68 30 68C16.5 68 6 58 6 42C6 24 16 4 30 4Z"/></svg>
    </a>
  )}
</footer>
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const io = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}), { threshold: .12 });
document.querySelectorAll('.reveal').forEach(el => {
  if (!reduce && el.parentElement) {
    const sibs = [...el.parentElement.children].filter(n => n.classList?.contains('reveal'));
    const idx = sibs.indexOf(el);
    if (idx > 0) el.style.transitionDelay = `${Math.min(idx, 6) * 80}ms`;
  }
  io.observe(el);
});
// Mobile (≤768px) home menu: the two-line button toggles the existing nav as a dropdown.
const menuBtn = document.getElementById('home-menu-btn');
const homeNav = document.getElementById('home-nav');
if (menuBtn && homeNav) {
  const setOpen = (open) => {
    homeNav.classList.toggle('is-menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  };
  menuBtn.addEventListener('click', () => setOpen(!homeNav.classList.contains('is-menu-open')));
  homeNav.querySelectorAll('#home-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => { if (!homeNav.contains(e.target)) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  matchMedia('(max-width: 768px)').addEventListener?.('change', (e) => { if (!e.matches) setOpen(false); });
}
document.querySelectorAll('img[data-r2]').forEach(img => img.addEventListener('error', () => {
  img.closest('[data-hide-on-err]')?.remove() ?? img.remove();
}));
// 鸡场蛋按钮：静态构建看不到 query，客户端把 href/标签纠正（?farm=1 时点一下回干净地址）。
const eggBtn = document.querySelector('a.farm-egg');
if (eggBtn && new URLSearchParams(location.search).get('farm') === '1') {
  eggBtn.setAttribute('href', location.pathname);
}
// 三入口一致（浮层 chips / 合作页 chips / 页脚蛋）：蛋 = 开↔收，同一 farm:toggle；
// 收起后 ChickenFarm 移除 body.farm-on，全站 cursor 恢复。标签随状态同步。
if (eggBtn) {
  eggBtn.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('farm:toggle'));
  });
  const syncEgg = () => eggBtn.setAttribute('aria-label', document.body.classList.contains('farm-on') ? '关闭鸡场' : '打开鸡场');
  new MutationObserver(syncEgg).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  syncEgg();
}
</script>
{!isContact && <MimiChat />}
</body>
</html>
