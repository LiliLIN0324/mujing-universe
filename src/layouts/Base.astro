---
import '../styles/global.css';
import MimiChat from '../components/MimiChat.astro';
import wordMarkSvg from '/public/brand/wordmark.svg?raw';
import ChickenFarm from '../components/ChickenFarm.astro';
const {
  title = '幕景宇宙 · 林丽丽艺术工作室',
  description = '幕景宇宙 · 林丽丽艺术工作室。以艺术家林丽丽为核心的 AIGC 文化艺术工作室，浙江杭州。',
  image = '/ring/0.jpg',
  active = '',
  home = false,
  navClass = '',
} = Astro.props;
const links = [['/works/', '作品'], ['/artist/', '艺术家'], ['/studio/', '工作室'], ['/contact/', '合作']];
// Every page uses the homepage 'Scendance Space' bar (header.top.top--home). `home` pages (homepage, work detail)
// keep the auto-hide/overlay behaviour; all other pages add 'top--page': always visible, in flow, on the paper colour.
const pageNav = navClass.split(' ').filter((c) => c && c !== 'top--unified').join(' ');
const foot = [['/works/', '作品'], ['/artist/', '艺术家'], ['/studio/', '工作室'], ['/contact/', '合作']];
const canonical = Astro.site ? new URL(Astro.url.pathname + Astro.url.search, Astro.site).href : '';
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
// 鸡场接线（farm-dev 临时，一键回滚 = 删掉这几行 + 模板里 farm-egg / 两个组件标签 + global.css 的 .farm-egg 段）：
// 站点是纯静态构建，构建期看不到 query，所以组件在非 /contact/ 页常驻输出、由组件脚本自查 ?farm=1 决定是否启用。
const farmPath = Astro.url.pathname;
const isContact = farmPath.startsWith('/contact');
const page = isContact ? 'contact' : farmPath.startsWith('/works') ? 'works' : farmPath.startsWith('/about') ? 'about' : farmPath.startsWith('/news') ? 'news' : 'home';
const farmHref = `${farmPath}?farm=1`; // 蛋按钮的无 JS 兜底；已开鸡场时由页脚脚本纠正为关闭
---
<html lang="zh-CN">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#FFFFFF"/>
  <script is:inline>
  // Apply the saved (or system) theme before first paint, so night mode never flashes.
  (function () {
    try {
      var t = localStorage.getItem('mj-theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', '#131316');
      }
    } catch (e) {}
  })();
  </script>
  <meta name="referrer" content="no-referrer"/>
  <meta name="format-detection" content="telephone=no"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="preload" href="/fonts/AlibabaPuHuiTi-3-55-Regular.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/CormorantSC-600-wordmark.woff2" as="font" type="font/woff2" crossorigin/>
  {canonical && <link rel="canonical" href={canonical}/>}
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="zh_CN"/>
  <meta property="og:site_name" content="幕景宇宙"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  {canonical && <meta property="og:url" content={canonical}/>}
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1920"/>
  <meta property="og:image:height" content="1080"/>
  <meta property="og:image:alt" content="幕景宇宙"/>
  <meta name="twitter:card" content="summary_large_image"/>
</head>
<body>
<a class="skip" href="#content">跳到主要内容</a>
{home ? (
<header class:list={["top top--home", navClass]} id="home-nav" data-autohide>
  <a class="wordmark" href="/" aria-label="幕景宇宙"><Fragment set:html={wordMarkSvg} /></a>
  <button class="menu-btn" id="home-menu-btn" type="button" aria-label="菜单" aria-expanded="false" aria-controls="home-menu"><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
  <nav id="home-menu">
    {links.map(([h, t]) => <a href={h} class={active === h ? 'on' : undefined}>{t}</a>)}
  </nav>
</header>
) : (
<header class:list={["top top--home top--page", pageNav]} id="home-nav">
  <a class="wordmark" href="/" aria-label="幕景宇宙"><Fragment set:html={wordMarkSvg} /></a>
  <button class="menu-btn" id="home-menu-btn" type="button" aria-label="菜单" aria-expanded="false" aria-controls="home-menu"><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
  <nav id="home-menu">
    {links.map(([h, t]) => <a href={h} class={active === h ? 'on' : undefined}>{t}</a>)}
  </nav>
</header>
)}
<div id="content">
<slot/>
</div>
<ChickenFarm page={page} />
<footer class="bot">
  <div>
    <strong>幕景宇宙 Mujing Universe</strong>
    <p>以艺术家林丽丽为核心的 AIGC 文化艺术工作室 · 浙江杭州</p>
    <p class="cap">© 2026 幕景宇宙</p>
  </div>
  <div>
    <span class="cap">站点</span>
    {foot.map(([h, t]) => <a href={h}>{t}</a>)}
  </div>
  <div>
    <span class="cap">说明</span>
    <p>作品图像用于工作室公开展示。商业使用与展览授权，请经合作页联系经纪人。</p>
  </div>
    <nav class="social" aria-label="社交">
    <a href="/contact/#feishu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3.6a8 8 0 0 0-8 8c0 1.5.4 2.9 1.1 4.1L4.2 20.2l4.4-1.2A8 8 0 1 0 12 3.6zm-2.6 7.1h5.2a.9.9 0 0 1 0 1.8H9.4a.9.9 0 0 1 0-1.8zm0 3.1h3.4a.9.9 0 0 1 0 1.8H9.4a.9.9 0 0 1 0-1.8z"/></svg>
      <span>飞书</span>
    </a>
    <a href="/contact/#wechat">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.2 3.5C5.7 3.5 2.8 5.9 2.8 8.9c0 1.7.9 3.2 2.4 4.2l-.6 2.2 2.4-1.2c.7.2 1.4.3 2.2.3.3 0 .6 0 .8-.1-.2-.5-.3-1.1-.3-1.6 0-3.3 3-5.9 6.7-5.9.3 0 .5 0 .8.1C16 5 12.8 3.5 9.2 3.5zM7.2 7a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm4.2 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM16.3 8.2c-3.2 0-5.8 2.3-5.8 5.1s2.6 5.1 5.8 5.1c.6 0 1.2-.1 1.7-.3l2.1 1-.5-1.8c1.2-.8 2-2.1 2-3.5 0-2.8-2.6-5.6-5.8-5.6h.5zm-1.8 2.7a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7zm3.6 0a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7z"/></svg>
      <span>微信</span>
    </a>
    <a href="https://github.com/LiliLIN0324" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.9 9.6.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7 1 .7 2.1v3c0 .3.2.6.7.5A10.2 10.2 0 0 0 22 12.2C22 6.6 17.5 2 12 2z"/></svg>
      <span>GitHub</span>
    </a>
    <a href="https://linkedin.com/in/lililin0324" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45z"/></svg>
      <span>LinkedIn</span>
    </a>
    <a href="https://www.instagram.com/lililin_portfolio/" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85 0 3.2-.01 3.58-.07 4.85-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85 0-3.2.01-3.58.07-4.85.15-3.23 1.66-4.77 4.92-4.92 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.78 2.7 21.36.27 17 .07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
      <span>Instagram</span>
    </a>
  </nav>
  {!isContact && (
    <a class="farm-egg" href={farmHref} aria-label="打开鸡场" title="幕景鸡场">
      <svg viewBox="0 0 60 72" aria-hidden="true"><path fill="currentColor" d="M30 4C44 4 54 24 54 42C54 58 43.5 68 30 68C16.5 68 6 58 6 42C6 24 16 4 30 4Z"/></svg>
    </a>
  )}
  <p class="copy">© 2026 幕景宇宙</p>
  {!isContact && (
    <a class="farm-egg" href={farmHref} aria-label="打开鸡场" title="幕景鸡场">
      <svg viewBox="0 0 60 72" aria-hidden="true"><path fill="currentColor" d="M30 4C44 4 54 24 54 42C54 58 43.5 68 30 68C16.5 68 6 58 6 42C6 24 16 4 30 4Z"/></svg>
    </a>
  )}
</footer>
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const io = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}), { threshold: .12 });
document.querySelectorAll('.reveal').forEach(el => {
  if (!reduce && el.parentElement) {
    const sibs = [...el.parentElement.children].filter(n => n.classList?.contains('reveal'));
    const idx = sibs.indexOf(el);
    if (idx > 0) el.style.transitionDelay = `${Math.min(idx, 6) * 80}ms`;
  }
  io.observe(el);
});
// Mobile (≤768px) home menu: the two-line button toggles the existing nav as a dropdown.
const menuBtn = document.getElementById('home-menu-btn');
const homeNav = document.getElementById('home-nav');
if (menuBtn && homeNav) {
  const setOpen = (open) => {
    homeNav.classList.toggle('is-menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  };
  menuBtn.addEventListener('click', () => setOpen(!homeNav.classList.contains('is-menu-open')));
  homeNav.querySelectorAll('#home-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => { if (!homeNav.contains(e.target)) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  matchMedia('(max-width: 768px)').addEventListener?.('change', (e) => { if (!e.matches) setOpen(false); });
}
document.querySelectorAll('img[data-r2]').forEach(img => img.addEventListener('error', () => {
  img.closest('[data-hide-on-err]')?.remove() ?? img.remove();
}));
// 鸡场蛋按钮：静态构建看不到 query，客户端把 href/标签纠正（?farm=1 时点一下回干净地址）。
const eggBtn = document.querySelector('a.farm-egg');
if (eggBtn && new URLSearchParams(location.search).get('farm') === '1') {
  eggBtn.setAttribute('href', location.pathname);
}
// 三入口一致（浮层 chips / 合作页 chips / 页脚蛋）：蛋 = 开↔收，同一 farm:toggle；
// 收起后 ChickenFarm 移除 body.farm-on，全站 cursor 恢复。标签随状态同步。
if (eggBtn) {
  eggBtn.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('farm:toggle'));
  });
  const syncEgg = () => eggBtn.setAttribute('aria-label', document.body.classList.contains('farm-on') ? '关闭鸡场' : '打开鸡场');
  new MutationObserver(syncEgg).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  syncEgg();
}
</script>
{!isContact && <MimiChat />}
</body>
</html>
