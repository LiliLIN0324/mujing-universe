---
import Base from '../layouts/Base.astro';
---
<Base title="页面不存在 · 幕景宇宙">
<main class="narrow miss">
  <div class="math-hull" data-hull="pointer" aria-label="墨点随指针收成凸包">
    <div class="math-hull-stage"><canvas aria-hidden="true"></canvas></div>
    <p class="hull-poem">迷路也会聚成形状</p>
  </div>
  <p class="kicker cap">404</p>
  <h1>这个页面不存在</h1>
  <p>链接可能写错了，或这一页已经挪走。</p>
  <p class="acts"><a class="btn solid" href="/">回首页</a> <a class="btn" href="/works/">看作品</a></p>
</main>
<style>
.miss { padding-top: 36px; text-align: center; }
.miss h1 { margin: 0 auto 12px; }
.acts { margin-top: 22px; }
.acts .btn { margin: 6px; }
.math-hull { margin: 0; }
.math-hull-stage {
  height: 260px;
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
  touch-action: pan-y;
}
.math-hull-stage canvas { width: 100%; height: 100%; display: block; }
.hull-poem {
  margin: 16px 0 32px;
  font-family: "Alibaba PuHuiTi 3.0", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", system-ui, sans-serif;
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: #1A1A1C;
  opacity: calc(0.34 + 0.66 * var(--hull, 0));
}
@media (max-width: 768px) {
  .miss { padding-top: 20px; }
  .math-hull-stage { height: 200px; }
  .hull-poem { margin: 12px 0 24px; font-size: 14px; letter-spacing: 0.12em; }
}
@media (prefers-reduced-motion: reduce) {
  .hull-poem { opacity: 1; }
}
</style>
<script>
import { mountConvexHull } from '../scripts/convex-hull.js';
mountConvexHull();
</script>
</Base>
