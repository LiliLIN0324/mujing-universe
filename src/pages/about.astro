---
import Base from '../layouts/Base.astro';
import Cooperate from '../components/Cooperate.astro';
import portraits from '../data/portraits.json';
const pickJs = `(function(){var L=${JSON.stringify(portraits)},im=document.getElementById('apimg');if(!im||!L.length)return;var P=im.parentNode;P.classList.add('has-photo');var u=L[Math.floor(Math.random()*L.length)],f=0;im.onload=function(){im.classList.add('on')};im.onerror=function(){im.remove();P.classList.remove('has-photo');};im.src=u;})();`;
const studioIntro = '幕景宇宙是一家位于杭州的AI Native工作室，以人工智能为核心，借助对于文化、设计与空间的理解，创作解决当下真实问题的产品、游戏与智能体，让我们生活的城市更美好。';
---
<Base title="关于 · 幕景宇宙" description={studioIntro} active="/about/" navClass="top--unified">
<main class="wrap about-page">

<div class="studio-intro reveal">
  <h1>AI Native 工作室</h1>
  <p class="lead">{studioIntro}</p>
</div>

<div class="members">

  <div class="member reveal">
    <div class="member-photo portrait">
      <img id="apimg" class="pimg" alt="林丽丽 肖像" width="900" height="1200" decoding="async" fetchpriority="high"/>
      <script is:inline set:html={pickJs}></script>
      <span class="serif">林<br/>丽<br/>丽</span>
    </div>
    <div class="member-info">
      <p class="kicker cap">艺术家 · 创作</p>
      <h2>林丽丽 <small>Lili Lin</small></h2>
      <p>幕景宇宙 Mujing Universe 创始人，华中科技大学建筑学优秀毕业生、首尔大学城市规划全奖硕士毕业生。本科期间担任华中科技大学启明学院 Pivot Studio 产品设计组组长，参与过北大深圳创业项目的产品设计与开发；此后跟随华科校友创业团队，深度参与多个生成式 AI 产品从 0 到 1 的设计、开发协作与迭代，实践涵盖 AI 图像生成、营销视频生成及交互式创作工具，并拥有大型互联网游戏公司实习经历和游戏项目奖项。</p>
      <p>她的实践横跨人工智能、产品设计、城市研究与数字艺术，兼具 AI 应用探索、创作工作流设计与跨学科研究经验。研究成果曾在多个国际学术会议展示，包括 AAAI 城市规划人工智能研讨会；持续探索生成式 AI 与智能体技术在创作及真实场景中的应用。</p>
      <p>目前，她创立幕景宇宙，以 AI 为创作媒介与技术基础，探索艺术表达、文化叙事、数字产品与交互体验的边界，尝试在技术能力与独立审美之间建立自己的创作语言。</p>
    </div>
  </div>

  <div class="member reveal">
    <div class="member-photo portrait has-photo">
      <img class="pimg on" src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/team/ding.jpg" alt="丁科智 肖像" width="900" height="1200" decoding="async" loading="lazy"/>
    </div>
    <div class="member-info">
      <p class="kicker cap">AI Native 经纪人</p>
      <h2>丁科智 <small>endTree</small></h2>
      <p>25岁，笔名终树，浙江音乐学院艺术与文化管理高等研究院在读研究生，高中起担任文学社社长，18岁后致力于戏剧艺术的制作与管理，24岁决心研究AI Agent在艺术与文化领域的应用，曾以单人团队入围GOAI世界人工智能开源大赛新智基座赛道复赛（全球前4%），参与黑客松主题包括FDE、空间智能、具身智能等赛道。</p>
    </div>
  </div>

  <div class="member reveal">
    <div class="member-photo portrait has-photo">
      <img class="pimg on" src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/team/wu.jpg" alt="吴耀好 肖像" width="900" height="1200" decoding="async" loading="lazy"/>
    </div>
    <div class="member-info">
      <p class="kicker cap">AI 研究员</p>
      <h2>吴耀好 <small>Wu Yaohao</small></h2>
      <p>浙江大学计算机硕士，研究方向为多智能体系统与 AI for Science。研究成果发表于 ACM CCS（<span class="nb">CCF-A</span>）、IEEE BIBM（<span class="nb">CCF-B</span>）等国际高水平会议，获软件著作权 2 项；曾获全国大学生数学建模竞赛国家一等奖、浙客松（Hackathon）二等奖。擅长将多智能体协作机制与科学计算结合，推动 AI 方法在真实科研场景中的落地，兼具顶会科研能力与从 0 到 1 的工程实现力。</p>
    </div>
  </div>

  <div class="member reveal">
    <div class="member-photo portrait has-photo">
      <img class="pimg on" src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/team/han.jpg" alt="韩志州 肖像" width="900" height="1200" decoding="async" loading="lazy"/>
    </div>
    <div class="member-info">
      <p class="kicker cap">商业与资源</p>
      <h2>韩志州 <small>Han Zhizhou</small></h2>
      <p>连续创业者，浙江大学英语专业本科毕业，梨树时代、梨树科技创始人，梨树资本发起人。曾任职于浙江大学出版社、复旦大学出版社及投融资机构，后创办轻食品牌与商业摄影公司，拥有出版、投融资及企业经营等跨领域经验。现聚焦人工智能、人力资源与精品财务顾问业务，擅长战略规划、商业价值梳理、品牌内容策划及资源整合。</p>
    </div>
  </div>

</div>

<section class="endcap reveal">
  <a class="btn" href="/works/">浏览作品 →</a>
  <Cooperate />
</section>

</main>
<style>
.about-page { padding-top: 80px; }

.studio-intro { margin-bottom: 64px; }
.studio-intro h1 { font-size: clamp(40px, 5vw, 56px); font-weight: 600; letter-spacing: -0.04em; line-height: 1.15; margin: 0 0 20px; }
.lead { font-size: 1.05rem; color: var(--ink2); line-height: 1.8; max-width: 40em; }

.members { display: flex; flex-direction: column; }

.member {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  column-gap: 48px;
  align-items: start;
  padding: 52px 0;
  border-top: 1px solid var(--rule);
}
.member:first-child { border-top: 0; padding-top: 0; }
.member:last-child { padding-bottom: 0; }

.portrait {
  aspect-ratio: 3 / 4;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 26px 22px;
}
.pimg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0;
        transition: opacity 0.4s ease, transform 0.8s var(--ease-out); }
.pimg.on { opacity: 1; }
/* The photo settles from a slight over-crop as its row enters, inside the clipped frame. */
html.js .member .pimg { transform: scale(1.06); }
html.js .member.in .pimg { transform: none; }
.portrait.has-photo .serif { display: none; }
.portrait .serif { position: relative; z-index: 2; font-size: clamp(2.4rem, 3.5vw, 3.2rem); line-height: 1.15; letter-spacing: 0.18em; color: var(--ink2); }

.member-info { max-width: 54em; }
.member-info .kicker { margin: 0 0 14px; }
.member-info h2 { font-size: clamp(30px, 3vw, 38px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 22px; }
.member-info h2 small {
  display: inline-block;
  margin-left: 10px;
  font-family: var(--en), var(--sans);
  font-weight: 400;
  font-size: 0.85rem;
  letter-spacing: 0;
  color: var(--ink2);
}
.member-info p { font-size: 1rem; color: var(--ink2); line-height: 1.78; margin: 0 0 14px; }
.member-info p:last-child { margin-bottom: 0; }
.member-info a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }
.member-info a:hover { opacity: 0.7; }
.member-info .nb { white-space: nowrap; }

.endcap { text-align: left; margin-top: 64px; }
.endcap .btn { margin: 6px 6px 6px 0; }

@media (prefers-reduced-motion: reduce) {
  .pimg { transition: opacity 0.4s ease; }
  html.js .member .pimg { transform: none; }
}

@media (max-width: 1100px) {
  .member { grid-template-columns: 220px minmax(0, 1fr); column-gap: 32px; }
}

@media (max-width: 1000px) {
  .member { grid-template-columns: 190px minmax(0, 1fr); column-gap: 26px; }
}

@media (max-width: 860px) {
  .studio-intro { margin-bottom: 40px; }
  .member { grid-template-columns: 1fr; gap: 22px; padding: 38px 0; }
  .member:first-child { padding-top: 0; }
  .portrait { width: 210px; }
  .member-info h2 { font-size: 26px; margin-bottom: 16px; }
}
</style>
</Base>
