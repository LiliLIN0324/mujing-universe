---
import Base from '../layouts/Base.astro'; import Cooperate from '../components/Cooperate.astro'; import artist from '../data/artist.json'; import { allWorks, LINES } from '../lib'; import portraits from '../data/portraits.json';
const ws = await allWorks();
const skills=['城市气候与韧性','AI 辅助城市规划','机器学习与数据分析','空间统计与 GIS','React / Next.js','TypeScript','WebGL / Three.js','UI 设计系统'];
// One random portrait per page load, picked by an inline script right after the <img> is parsed (before first paint).
// The vertical name is only shown as a fallback when no photo loads (has-photo is dropped on final error).
// In dev, a missing R2 object falls back to the gitignored local copy in public/_preview-portraits/.
const pickJs=`(function(){var L=${JSON.stringify(portraits)},D=${import.meta.env.DEV?1:0},im=document.getElementById('apimg');if(!im||!L.length)return;var P=im.parentNode;P.classList.add('has-photo');var u=L[Math.floor(Math.random()*L.length)],f=0;im.onload=function(){im.classList.add('on')};im.onerror=function(){if(D&&!f){f=1;im.src='/_preview-portraits/'+u.split('/').pop();}else{im.remove();P.classList.remove('has-photo');}};im.src=u;})();`;
const cities=new Set(artist.talks.map(t=>t.location.split(',')[0]));
---
<Base title="艺术家 林丽丽 · 幕景宇宙" active="/artist/" navClass="top--unified">
<section class="wrap ahero">
<svg class="bonnet" data-bonnet viewBox="-2.05 -1.72 4.1 3.44" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <path data-curve="a" fill="none" stroke="#1A1A1C" stroke-opacity="0.38" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
  <path data-curve="b" fill="none" stroke="#1A1A1C" stroke-opacity="0.24" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
</svg>
<div class="portrait"><img id="apimg" class="pimg" alt="林丽丽 肖像" width="900" height="1200" decoding="async" fetchpriority="high" /><script is:inline set:html={pickJs}></script><span class="serif">林<br/>丽<br/>丽</span></div>
<div><p class="kicker cap">Artist · 主理人</p><h1>林丽丽 <small>Lili Lin</small></h1>
<p class="lead">首尔大学规划与 AI 硕士，建筑学出身。用设计和代码，把城市、AI 与三维做成可看、可交互的作品。</p>
<p class="links"><a href="https://www.instagram.com/lililin_portfolio/" target="_blank" rel="noopener noreferrer">Instagram</a><span aria-hidden="true">·</span><a href="https://lililin0324.github.io/" target="_blank" rel="noopener noreferrer">个人站</a><span aria-hidden="true">·</span><a href="https://github.com/LiliLIN0324" target="_blank" rel="noopener noreferrer">GitHub</a></p>
<div class="stats">{[[ws.length,'件已收录作品'],[artist.talks.length,'场国际会议报告'],[cities.size,'座城市'],[artist.awards.reduce((n,a)=>n+a.items.length,0),'项荣誉与奖项']].map(([n,l])=><div><span class="serif">{n}</span><span class="cap">{l}</span></div>)}</div></div></section>

<section class="wrap two reveal"><div><p class="kicker cap">Education · 教育</p>
<ul class="list"><li><span class="serif">首尔大学</span><span>城市与区域规划（硕士）</span></li><li><span class="serif">华中科技大学</span><span>建筑学（本科）</span></li></ul></div>
<div><p class="kicker cap">Practice · 能力</p><p class="tags">{skills.map(s=><span>{s}</span>)}</p><p class="cap">创作线：{LINES.join(' · ')}</p></div></section>

<section class="wrap sheet reveal"><p class="kicker cap">Talks · 国际会议报告 {artist.talks.length}</p>
<table class="talks"><tbody>{artist.talks.slice().sort((a,b)=>b.date.slice(-4).localeCompare(a.date.slice(-4))).map((t,i)=><tr><td class="mono">{String(i+1).padStart(2,'0')}</td><td><span class="serif">{t.title}</span><br/><span class="cap">{t.event}</span></td><td>{t.location}</td><td class="mono">{t.date}</td><td><span class={`fmt ${t.format}`}>{t.format==='Oral'?'口头报告':'海报'}</span></td></tr>)}</tbody></table></section>

<section class="wrap reveal"><p class="kicker cap">Awards · 荣誉与奖项</p><div class="awards">
{artist.awards.map(a=><div><h3>{a.category.split(' · ')[0]}</h3><ul>{a.items.slice().sort((x,y)=>+y.year-+x.year).map(it=><li><span class="mono">{it.year}</span>{it.name}</li>)}</ul></div>)}</div></section>
<section class="narrow endcap reveal"><a class="btn" href="/works/">浏览作品 →</a><Cooperate /></section>
<style>
.ahero { display: grid; grid-template-columns: minmax(240px, 340px) 1fr; gap: 5vw; padding-top: 20px; align-items: start; position: relative; }
.bonnet {
  position: absolute;
  right: -9%;
  top: -10%;
  width: min(520px, 48%);
  height: auto;
  aspect-ratio: 4.1 / 3.44;
  z-index: 0;
  pointer-events: none;
  overflow: visible;
}
.ahero > :not(.bonnet) { position: relative; z-index: 1; }
.portrait {
  aspect-ratio: 3 / 4;
  background: var(--paper);
  border: 0;
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28px 24px;
  position: relative;
  overflow: hidden;
}
.pimg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.35s ease; }
.pimg.on { opacity: 1; }
.portrait.has-photo .serif { display: none; }
.portrait .serif { position: relative; z-index: 2; font-size: clamp(2.8rem, 4vw, 3.8rem); line-height: 1.15; letter-spacing: 0.18em; color: var(--ivory); }
h1 { font-size: clamp(36px, 4vw, 48px); margin: 0; font-weight: 600; letter-spacing: -0.03em; }
h1 small {
  display: inline-block;
  margin-left: 10px;
  font-family: var(--en), var(--sans);
  font-style: normal;
  font-weight: 500;
  font-size: 1.15rem;
  letter-spacing: 0;
  color: var(--ink2);
}
.lead { font-family: var(--sans); font-weight: 400; font-size: 1.12rem; color: var(--ink); }
.quote {
  font-family: var(--sans);
  color: var(--ink2);
  border-left: 1px solid var(--rule);
  padding-left: 16px;
}
.quote .cap { display: block; margin-top: 8px; }
.links { display: flex; align-items: baseline; gap: 12px; margin: 4px 0 0.8em; font-family: var(--en), var(--sans); font-size: 0.85rem; letter-spacing: 0.06em; color: var(--muted); }
.links a { color: var(--ink2); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 1px; }
.links a:hover { color: var(--ink); border-bottom-color: currentColor; }
.stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); margin-top: 28px; }
.stats div { padding: 16px 12px 0 0; display: flex; flex-direction: column; gap: 4px; }
.stats .serif { font-size: clamp(2rem, 3vw, 2.6rem); color: var(--ivory); line-height: 1; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; margin-top: 110px; }
.list { list-style: none; padding: 0; margin: 0; }
.list li { display: grid; grid-template-columns: 9em 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ivory-2); }
.tags span {
  display: inline-block;
  border: 1px solid var(--line);
  padding: 4px 12px;
  margin: 0 8px 8px 0;
  font-size: 0.9rem;
  background: var(--elev);
  color: var(--ivory-2);
}
section.reveal, section.sheet { margin-top: 100px; }
.talks { width: 100%; border-collapse: collapse; }
.talks td { padding: 16px 10px 16px 0; border-bottom: 1px solid var(--line); vertical-align: top; color: var(--ivory-2); }
.talks .serif { color: var(--ivory); }
.fmt {
  font-family: var(--en), var(--sans);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  padding: 3px 8px;
  border: 0;
  border-radius: 999px;
  background: var(--bg2);
  color: var(--ink2);
  white-space: nowrap;
}
.fmt.Oral { background: var(--ivory); color: var(--bg); border-color: var(--ivory); }
.awards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
.awards h3 { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; font-size: 1.15rem; letter-spacing: 0.08em; }
.awards ul { list-style: none; padding: 0; margin: 0; }
.awards li { display: grid; grid-template-columns: 3.6em 1fr; gap: 8px; padding: 8px 0; font-size: 0.92rem; color: var(--ivory-2); border-bottom: 1px solid var(--line); }
.endcap { text-align: center; margin-top: 88px; }
.endcap .btn { margin: 6px; }
@media (max-width: 860px) {
  .ahero, .two, .awards { grid-template-columns: 1fr; }
  .ahero { padding-top: 14px; }
  .bonnet {
    position: relative;
    right: auto;
    top: auto;
    width: 100%;
    height: 132px;
    margin: 0 0 8px;
    grid-row: 1;
    aspect-ratio: auto;
  }
  .portrait { grid-row: 2; }
  .ahero > div:last-child { grid-row: 3; }
  .portrait { max-width: 420px; }
  .stats { grid-template-columns: 1fr 1fr; }
  .list li { grid-template-columns: 1fr; gap: 2px; }
  .talks td:nth-child(3) { display: none; }
  .sheet { overflow-x: auto; }
}
</style>
<script>
  import { mountBonnet } from '../scripts/bonnet-pair.js';
  mountBonnet();
</script>
</Base>
