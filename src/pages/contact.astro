---
import Base from '../layouts/Base.astro';
const email = 'lily1326685527@gmail.com';
const mailto = `mailto:${email}`;
const kinds = [
  ['古画', '古画'],
  ['民乐音画', '民乐音画'],
  ['展览 · 委托', '展览委托'],
] as const;
---
<Base title="合作 · 幕景宇宙" description="林丽丽、丁科智。写邮件。" active="/contact/">
<main class="coop">
  <header class="coop-top">
    <h1>合作</h1>
    <p class="line">林丽丽、丁科智。</p>
  </header>

  <section class="primary">
    <a class="cta" href={mailto}>写邮件</a>
    <a class="addr" href={mailto}>{email}</a>
    <p class="kinds">
      <span>范围</span>
      {kinds.map(([label, subject]) => (
        <a href={`${mailto}?subject=${encodeURIComponent(subject)}`}>{label}</a>
      ))}
    </p>
  </section>

  <section class="secondary" aria-label="其他联系">
    <div class="row" id="feishu">
      <h2>飞书</h2>
      <details id="feishu-card">
        <summary>看名片</summary>
        <img src="/mimi/feishu-qr.png" alt="终树的飞书名片" width="431" height="568"/>
      </details>
    </div>
    <div class="row" id="wechat">
      <h2>微信</h2>
      <div class="fact">
        <p class="wx" id="wx-id">endTree-26</p>
        <button class="ghost" type="button" id="copy-wx">复制</button>
      </div>
    </div>
    <div class="row" id="start">
      <h2>Mimi</h2>
      <div class="fact">
        <button class="ghost" type="button" id="ask-mimi" data-mimi-open>问一句</button>
        <p class="aside">不会自动拉群。</p>
      </div>
    </div>
  </section>
</main>
<script is:inline>
  if (location.hash === '#feishu') document.getElementById('feishu-card')?.setAttribute('open', '');
  document.getElementById('ask-mimi')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('mimi:open', { detail: { intent: 'coop' } }));
  });
  const copy = document.getElementById('copy-wx');
  function copyId() {
    const id = 'endTree-26';
    const ta = document.createElement('textarea');
    ta.value = id;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.top = '0';
    ta.style.left = '0';
    ta.style.opacity = '0';
    document.body.append(ta);
    ta.focus();
    ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    ta.remove();
    return ok;
  }
  copy?.addEventListener('click', () => {
    const prev = '复制';
    copy.textContent = '已复制';
    let settled = false;
    const finish = (ok) => {
      if (settled) return;
      settled = true;
      copy.textContent = ok ? '已复制' : '请长按微信号复制';
      window.setTimeout(() => { copy.textContent = prev; }, 1600);
    };
    if (copyId()) { finish(true); return; }
    if (navigator.clipboard && window.isSecureContext) {
      const timer = window.setTimeout(() => finish(false), 500);
      navigator.clipboard.writeText('endTree-26').then(() => {
        window.clearTimeout(timer);
        finish(true);
      }).catch(() => {
        window.clearTimeout(timer);
        finish(false);
      });
      return;
    }
    finish(false);
  });
</script>
<style>
  .coop {
    width: min(var(--page-max-width), calc(100% - 2 * var(--page-gutter)));
    margin: 0 auto;
    padding: 36px 0 80px;
  }
  .coop h1 {
    margin: 0;
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .line {
    margin: 16px 0 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .primary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--ink);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--ink);
    color: var(--bg);
    padding: 14px 22px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
  }
  .cta:hover { opacity: 0.82; }
  .addr {
    font-family: var(--en), var(--sans);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 22px;
    width: 100%;
    margin: 10px 0 0;
  }
  .kinds span {
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .kinds a {
    color: var(--ink);
    font-size: 16px;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .kinds a:hover { border-bottom-color: var(--ink); }
  .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 88px;
  }
  .row h2 {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .fact { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .fact p { margin: 0; }
  .wx {
    margin: 0;
    font-family: var(--en), var(--sans);
    font-size: 18px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .aside { margin: 0; color: var(--ink2); font-size: 14px; }
  .ghost {
    border: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    padding: 6px 12px;
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1;
    cursor: pointer;
  }
  .ghost:hover { opacity: 0.82; }
  details summary {
    display: inline-block;
    font-size: 16px;
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
  }
  details summary::-webkit-details-marker { display: none; }
  details summary:hover { border-bottom: 1px solid var(--ink); }
  details img {
    display: block;
    width: 180px;
    height: auto;
    margin-top: 14px;
    border-radius: 0;
    background: #fff;
  }
  @media (max-width: 720px) {
    .coop { width: calc(100% - 2 * var(--page-gutter)); padding-top: 28px; }
    .coop h1 { font-size: 48px; }
    .line { font-size: 20px; }
    .addr { font-size: 18px; }
    .row { grid-template-columns: 1fr; gap: 8px; padding: 14px 0; }
  }
</style>
</Base>
