---
import Base from '../layouts/Base.astro';
const lines = ['古画', '民乐音画', '展览 · 委托'];
---
<Base title="合作 · 幕景宇宙" description="合作。飞书、微信、邮件。" active="/contact/">
<main class="coop">
  <header class="coop-top">
    <p class="coop-idx">01</p>
    <h1>合作</h1>
  </header>
  <div class="coop-rows">
    <section class="row">
      <h2>范围</h2>
      <ul>
        {lines.map((line) => <li>{line}</li>)}
      </ul>
    </section>
    <section class="row" id="feishu">
      <h2>飞书</h2>
      <div class="fact">
        <img src="/mimi/feishu-qr.png" alt="终树的飞书名片" width="431" height="568"/>
        <p>加终树</p>
      </div>
    </section>
    <section class="row" id="wechat">
      <h2>微信</h2>
      <div class="fact">
        <p class="wx" id="wx-id">endTree-26</p>
        <button class="sq" type="button" id="copy-wx">复制</button>
      </div>
    </section>
    <section class="row">
      <h2>邮件</h2>
      <p class="mail"><a href="mailto:lily1326685527@gmail.com">lily1326685527@gmail.com</a></p>
    </section>
    <section class="row" id="start">
      <h2>Mimi</h2>
      <div class="fact">
        <button class="sq ghost" type="button" id="ask-mimi" data-mimi-open>问一句</button>
        <p class="aside">不会自动拉群。</p>
      </div>
    </section>
  </div>
</main>
<script is:inline>
  document.getElementById('ask-mimi')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('mimi:open', { detail: { intent: 'coop' } }));
  });
  const copy = document.getElementById('copy-wx');
  function copyId() {
    const id = 'endTree-26';
    const ta = document.createElement('textarea');
    ta.value = id;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.top = '0';
    ta.style.left = '0';
    ta.style.opacity = '0';
    document.body.append(ta);
    ta.focus();
    ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    ta.remove();
    return ok;
  }
  copy?.addEventListener('click', () => {
    const prev = '复制';
    copy.textContent = '已复制';
    let settled = false;
    const finish = (ok) => {
      if (settled) return;
      settled = true;
      copy.textContent = ok ? '已复制' : '请长按微信号复制';
      window.setTimeout(() => { copy.textContent = prev; }, 1600);
    };
    if (copyId()) { finish(true); return; }
    if (navigator.clipboard && window.isSecureContext) {
      const timer = window.setTimeout(() => finish(false), 500);
      navigator.clipboard.writeText('endTree-26').then(() => {
        window.clearTimeout(timer);
        finish(true);
      }).catch(() => {
        window.clearTimeout(timer);
        finish(false);
      });
      return;
    }
    finish(false);
  });
</script>
<style>
  .coop {
    width: min(960px, calc(100% - 80px));
    margin: 0 auto;
    padding: 36px 0 72px;
  }
  .coop-top {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ink);
  }
  .coop-idx {
    margin: 0;
    font-family: var(--en), var(--sans);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .coop h1 {
    margin: 0;
    font-size: clamp(56px, 8vw, 88px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }
  .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 88px;
  }
  .row h2 {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }
  .row ul { list-style: none; margin: 0; padding: 0; }
  .row li {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.03em;
  }
  .fact { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
  .fact p { margin: 0; }
  .row img {
    display: block;
    width: 148px;
    height: auto;
    border-radius: 0;
    background: #fff;
  }
  .wx {
    margin: 0;
    font-family: var(--en), var(--sans);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .mail { margin: 0; font-size: 22px; letter-spacing: -0.03em; }
  .mail a { text-decoration: none; border-bottom: 1px solid var(--ink); }
  .aside { margin: 0; color: var(--ink2); font-size: 15px; }
  .sq {
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--ink);
    color: var(--bg);
    padding: 8px 14px;
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.08em;
    line-height: 1;
    cursor: pointer;
  }
  .sq.ghost { background: transparent; color: var(--ink); }
  .sq:hover { opacity: 0.82; }
  @media (max-width: 720px) {
    .coop { width: calc(100% - 40px); padding-top: 28px; }
    .coop-top, .row { grid-template-columns: 1fr; gap: 8px; }
    .coop h1 { font-size: 48px; }
    .row { padding: 18px 0; }
    .row li, .mail { font-size: 20px; }
    .wx { font-size: 24px; }
  }
</style>
</Base>
