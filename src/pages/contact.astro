---
import Base from '../layouts/Base.astro';
const svc=[['展览与展陈','美术馆、文旅、景区的 AIGC 音画展陈与长卷委托'],['作品委托','品牌、机构的定制 AIGC 视觉与音画作品'],['产品与游戏合作','AIGC 产品设计、游戏与数字场景'],['讲座与工作坊','AI × 空间 / 艺术主题的分享与工作坊']];
---
<Base title="合作与经纪 · 幕景宇宙" active="/contact/"><main class="wrap page">
<p class="kicker cap">Representation · 合作与经纪</p><h1>合作与经纪</h1>
<p class="lead serif">艺术家林丽丽的展览、委托与商务合作，由经纪人丁科智（终树）统一对接。</p>
<div class="svc">{svc.map(([t,d],i)=><div class="reveal"><span class="mono">0{i+1}</span><h3>{t}</h3><p>{d}</p></div>)}</div>
<div class="cards">
 <div class="c main"><span class="cap">经纪 · 商务（首选）</span><h3>丁科智（终树）</h3><p>展览、委托与商务由经纪人统一对接。</p></div>
 <div class="c"><span class="cap">艺术家 · 学术交流</span><h3>林丽丽</h3><p><a href="mailto:lily1326685527@gmail.com">lily1326685527@gmail.com</a></p></div>
 <div class="c"><span class="cap">工作室</span><h3>幕景宇宙</h3><p>浙江 · 杭州</p></div>
</div>
</main>
<style>
.page { padding-top: 80px; }
.page { text-align: center; }
.page h1 { font-size: clamp(36px, 4vw, 48px); margin: 0 auto 16px; font-weight: 600; letter-spacing: -0.03em; }
.lead { font-size: 1.05rem; font-weight: 400; max-width: 36em; margin-left: auto; margin-right: auto; color: var(--ink2); }
.svc { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 56px 0 28px; text-align: left; }
.svc div { padding: 22px 18px 26px; background: var(--paper); border: 0; border-radius: var(--radius); }
.svc h3 { margin: 10px 0 8px; font-size: 1.15rem; letter-spacing: 0.06em; }
.svc p { margin: 0; color: var(--ivory-2); font-size: 0.92rem; }
.cards { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 16px; margin-bottom: 28px; text-align: left; }
.c { background: var(--paper); border: 0; border-radius: var(--radius); padding: 28px 24px; }
.c.main { background: var(--paper); }
.c h3 { font-size: 1.45rem; margin: 8px 0; }
.c p { color: var(--ivory-2); }
.note { margin-top: 8px; }
@media (max-width: 980px) { .svc { grid-template-columns: 1fr 1fr; } .cards { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .svc { grid-template-columns: 1fr; } }
</style></Base>
