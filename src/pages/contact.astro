---
import Base from '../layouts/Base.astro';
const svc=[['展览与展陈','美术馆、文旅、景区的 AIGC 音画展陈与长卷委托'],['作品委托','品牌、机构的定制 AIGC 视觉与音画作品'],['产品与游戏合作','AIGC 产品设计、游戏与数字场景'],['讲座与工作坊','AI × 空间 / 艺术主题的分享与工作坊']];
---
<Base title="合作与经纪 · 幕景宇宙" active="/contact/"><main class="wrap page">
<p class="kicker cap">Representation · 合作与经纪</p><h1>合作与经纪</h1>
<p class="lead serif">艺术家林丽丽的展览、委托与商务合作，由经纪人丁科智（终树）统一对接。</p>
<div class="svc">{svc.map(([t,d],i)=><div class="reveal"><span class="mono">0{i+1}</span><h3>{t}</h3><p>{d}</p></div>)}</div>
<div class="cards">
 <div class="c main"><span class="cap">经纪 · 商务（首选）</span><h3>丁科智（终树）</h3><p>邮箱 <span class="ph">占位</span><br/>微信 <span class="ph">占位</span></p></div>
 <div class="c"><span class="cap">艺术家 · 学术交流</span><h3>林丽丽</h3><p>lily1326685527@gmail.com <span class="cap">（取自个人站，公开前确认）</span></p></div>
 <div class="c"><span class="cap">工作室</span><h3>幕景宇宙</h3><p>浙江 · 杭州 <span class="ph">地址占位</span><br/>主体：OPC 注册中 <span class="ph">占位</span></p></div>
</div>
<p class="cap note">原型阶段不设表单，避免收集个人信息。</p></main>
<style>
.page { padding-top: 80px; }
.page h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); margin: 0 0 16px; font-weight: 500; letter-spacing: 0.08em; }
.lead { font-size: 1.2rem; max-width: 38em; color: var(--ivory-2); }
.svc { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 56px 0 28px; }
.svc div { padding: 22px 18px 26px; background: var(--elev); border: 1px solid var(--line); transition: border-color .35s ease, transform .35s ease; }
.svc div:hover { border-color: rgba(203, 184, 146, 0.4); transform: translateY(-3px); }
.svc h3 { margin: 10px 0 8px; font-size: 1.15rem; letter-spacing: 0.06em; }
.svc p { margin: 0; color: var(--ivory-2); font-size: 0.92rem; }
.cards { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 18px; margin-bottom: 28px; }
.c { background: var(--elev); border: 1px solid var(--line); padding: 28px 24px; }
.c.main { background: linear-gradient(180deg, rgba(203,184,146,.1), rgba(244,240,230,.03)); border-color: rgba(203,184,146,.35); }
.c h3 { font-size: 1.45rem; margin: 8px 0; }
.c p { color: var(--ivory-2); }
.note { margin-top: 8px; }
@media (max-width: 980px) { .svc { grid-template-columns: 1fr 1fr; } .cards { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .svc { grid-template-columns: 1fr; } }
</style></Base>
