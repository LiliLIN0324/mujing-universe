---
import Base from '../layouts/Base.astro';
import { allWorks, pickIntro, workCovers, workFallback } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
const SCROLL_VIDEO = `${R2}/scroll-placeholder.mp4`;
const SCROLL_STILL = `${R2}/01.jpg`;
const picks = ws.map((w) => ({
  slug: w.slug,
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  intro: pickIntro(w),
  stills: workCovers(w),
  fallback: workFallback(w),
}));
const leadPick = picks[0];
const ringWorks = picks.slice(0, 10);
---
<Base active="/">
<section class="hero" id="scroll-hero" aria-label="当代西湖繁胜全景图">
  <img class="hero-still" src={SCROLL_STILL} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
  <video
    id="scroll-video"
    class="hero-video"
    muted
    autoplay
    playsinline
    loop
    preload="auto"
    disablepictureinpicture
    referrerpolicy="no-referrer"
    src={SCROLL_VIDEO}
    data-src={SCROLL_VIDEO}
    aria-hidden="true"
  ></video>
  <div class="hero-overlay">
    <div class="hero-copy">
      <p class="kicker">古画新绘 · 进行中</p>
      <h1>当代西湖繁胜全景图</h1>
      <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成</p>
      <button id="snd" class="btn solid sound" type="button" aria-pressed="false" aria-controls="scroll-video">▶ 聆听图景</button>
    </div>
    <a class="hero-more" href="/works/xihu-panorama/">查看作品</a>
  </div>
</section>

{leadPick && <section class="picks" id="picks" aria-label="精选">
  <div class="picks-sticky">
  <canvas class="pick-canvas" id="pick-canvas" aria-hidden="true"></canvas>
  <div class="picks-layout">
    <div class="picks-copy">
      <h2 class="picks-label">精选</h2>
      <p class="picks-intro" id="pick-intro">{leadPick.intro}</p>
    </div>
    <div class="about__gallery" id="pick-stage">
      <div class="about__gallery__wrapper" id="pick-gallery">
        {ringWorks.map((work, i) => (
          <div class="about__gallery__link" data-i={i}>
            <figure class="about__gallery__media">
              <img
                class="about__gallery__media__image"
                alt={work.title}
                width="1200"
                height="642"
                draggable="false"
                referrerpolicy="no-referrer"
                decoding="async"
                src={work.stills[0]}
                data-fallback={work.fallback}
              />
            </figure>
          </div>
        ))}
      </div>
    </div>
    <div class="pick-list-window">
      <ol class="pick-list" id="pick-list">
        {picks.map((p, i) => (
          <li class="pick-row">
            <span class="row-title">{p.title}</span>
            <span class="row-year">{p.year}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  </div>
  <script type="application/json" id="pick-data" set:html={JSON.stringify(picks).replace(/</g, '\\u003c')}></script>
</section>}

<section class="narrow cta">
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  height: clamp(560px, 82vh, 920px);
  overflow: hidden;
  border-radius: 0;
  background: #141816;
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-video {
  opacity: 0;
  pointer-events: none;
}
.hero::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: min(460px, 42vw);
  height: 46%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top, rgba(8, 10, 9, 0.22), rgba(8, 10, 9, 0));
}
.hero-overlay {
  position: absolute;
  left: clamp(24px, 4vw, 48px);
  right: clamp(24px, 4vw, 48px);
  bottom: clamp(24px, 4vw, 48px);
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  pointer-events: none;
}
.hero-copy,
.hero-more { pointer-events: auto; }
.hero-copy {
  max-width: min(420px, 46vw);
  text-align: left;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
}
.hero-copy .kicker {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.12em;
  opacity: 0.7;
}
.hero-copy h1 {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: clamp(28px, 3.6vw, 44px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.hero-copy .sub {
  margin: 0;
  color: #fff;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  opacity: 0.75;
}
#snd.btn.solid {
  margin-top: 18px;
  background: #fff;
  color: #1A1A1C;
  border-color: #fff;
}
.hero-more {
  flex: none;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  text-decoration: none;
  opacity: 0.85;
  white-space: nowrap;
}
.hero-more:hover { opacity: 1; }
#snd.btn.solid:disabled,
#snd.btn.solid:disabled:hover {
  opacity: 0.45;
  cursor: not-allowed;
}
.picks {
  height: 220vh;
  background: #F6F5F3;
  color: #1A1A1C;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  overflow: visible;
}
.picks-sticky {
  position: sticky;
  top: 0;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(88px, 12vh, 120px) clamp(24px, 4vw, 48px) clamp(48px, 6vh, 72px);
  overflow: visible;
  background: #F6F5F3;
}
.pick-canvas {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: block;
  pointer-events: none;
}
.picks-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(280px, 1.05fr) minmax(280px, 0.95fr);
  column-gap: 48px;
  row-gap: 8px;
  align-items: start;
}
.picks-copy {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  z-index: 1;
  background: #F6F5F3;
}
.picks-label {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.picks-intro {
  width: min(380px, 32vw);
  margin: 0;
  color: #1A1A1C;
  font-family: inherit;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.65;
}
.about__gallery {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
.about__gallery__wrapper,
.about__gallery__link,
.about__gallery__media {
  margin: 0;
}
.about__gallery__media {
  width: 160px;
  height: 214px;
  background: #E6E3DE;
  overflow: hidden;
}
.about__gallery__media__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
  pointer-events: none;
  user-select: none;
}
.pick-list-window {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: stretch;
  height: min(640px, 68vh);
  overflow: hidden;
  border-top: 1px solid rgba(26, 26, 28, 0.1);
  font-family: inherit;
  position: relative;
  z-index: 1;
  background: #F6F5F3;
}
.pick-list {
  list-style: none;
  margin: 0;
  padding: 0;
  will-change: transform;
}
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
  width: 100%;
  height: 48px;
  padding: 0;
  border-bottom: 1px solid rgba(26, 26, 28, 0.1);
  background: transparent;
  color: #1A1A1C;
  font-family: inherit;
  font-weight: 400;
  text-align: left;
  pointer-events: none;
  user-select: none;
}
.row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: inherit;
  line-height: 1.3;
}
.row-year {
  flex: none;
  color: #8A8A8A;
  font-size: 13px;
  font-weight: inherit;
  font-variant-numeric: tabular-nums;
}
.cta { text-align: center; margin-top: 160px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 860px) {
  .picks { height: auto; }
  .pick-canvas { display: none; }
  .picks-sticky { position: relative; top: auto; height: auto; padding-top: 72px; }
  .picks-layout { grid-template-columns: 1fr; row-gap: 28px; }
  .picks-copy { grid-column: 1; grid-row: 1; }
  .about__gallery {
    position: relative;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .about__gallery__media {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
  }
  .picks-intro { width: min(380px, 100%); }
  .pick-list-window { grid-column: 1; grid-row: 3; height: auto; max-height: none; overflow: hidden; }
}
@media (max-width: 760px) {
  .hero { height: clamp(520px, 86vh, 720px); border-radius: 0; }
  .hero-overlay {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .hero-copy { max-width: none; width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-video { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .about__gallery__wrapper,
  .about__gallery__media,
  .pick-list { transition: none; }
}
</style>
<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const listen = document.getElementById('snd');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
let listening = false;

function setVolume(value) {
  try { video.volume = value; } catch (err) { /* iOS keeps volume read-only */ }
}

function failSilent() {
  listening = false;
  hero.classList.remove('is-listening');
  video.muted = true;
  video.defaultMuted = true;
  video.setAttribute('muted', '');
  setVolume(0);
  listen.disabled = false;
  listen.setAttribute('aria-pressed', 'false');
  listen.textContent = '▶ 聆听图景';
}

function setAudible(on) {
  listening = on;
  hero.classList.toggle('is-listening', on);
  if (on) {
    video.muted = false;
    video.defaultMuted = false;
    video.removeAttribute('muted');
    setVolume(1);
    listen.setAttribute('aria-pressed', 'true');
    listen.textContent = '❚❚ 静音';
  } else {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    setVolume(0);
    listen.setAttribute('aria-pressed', 'false');
    listen.textContent = '▶ 聆听图景';
  }
}

function attachSource() {
  const src = video.dataset.src;
  if (!src) return false;
  video.playsInline = true;
  video.autoplay = true;
  video.loop = true;
  video.preload = 'auto';
  if (!listening) {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
  }
  if (video.getAttribute('src') !== src) video.src = src;
  return true;
}

function startVideo() {
  if (!attachSource()) { failSilent(); return; }
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (listening) return;
    if (err && err.name === 'NotAllowedError') return;
    if (video.error) failSilent();
  });
}

video.addEventListener('playing', () => {
  hero.classList.add('is-playing');
});
video.addEventListener('error', () => {
  failSilent();
});
listen.addEventListener('click', () => {
  if (listen.disabled) return;
  if (listening) {
    setAudible(false);
    return;
  }
  if (!attachSource()) { failSilent(); return; }
  setAudible(true);
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (err && err.name === 'AbortError') return;
    setAudible(false);
    if (video.error) failSilent();
  });
});
if (motion.addEventListener) motion.addEventListener('change', () => {
  if (!motion.matches) startVideo();
});
startVideo();
</script>
<script>
import { mountPickRing } from '../scripts/pick-ring.js';
const picksRoot = document.getElementById('picks');
const pickDataEl = document.getElementById('pick-data');
if (picksRoot && pickDataEl) {
  mountPickRing(picksRoot, JSON.parse(pickDataEl.textContent || '[]'));
}
</script>
</Base>
