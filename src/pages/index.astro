---
import Base from '../layouts/Base.astro';
import { allWorks, featuredWorks } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
// scroll.mp4 keeps its AAC track. Autoplay stays muted; 「聆听图景」 unmutes this same video.
const SCROLL_VIDEO = `${R2}/scroll.mp4`;
// 01.jpg matches the video frame (1920×760). still.jpg is a 52:1 panorama;
// object-fit:cover sliced its inscriptions into giant cropped glyphs.
const SCROLL_POSTER = `${R2}/01.jpg`;
const lead = featuredWorks(ws).find((w) => w.slug === 'xihu-panorama') || featuredWorks(ws)[0];
const pickSrc = `${R2}/01.jpg`;
---
<Base active="/">
<section class="hero" id="scroll-hero" aria-label="当代西湖繁胜全景图">
  <img class="hero-still" src={SCROLL_POSTER} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
  <video
    id="scroll-video"
    class="hero-video"
    poster={SCROLL_POSTER}
    muted
    autoplay
    playsinline
    loop
    preload="none"
    disablepictureinpicture
    referrerpolicy="no-referrer"
    data-src={SCROLL_VIDEO}
    aria-hidden="true"
  ></video>
  <div class="hero-overlay">
    <div class="hero-copy">
      <p class="kicker">古画新绘 · 进行中</p>
      <h1>当代西湖繁胜全景图</h1>
      <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成</p>
      <button id="snd" class="btn solid sound" type="button" aria-pressed="false" aria-controls="scroll-video">▶ 聆听图景</button>
    </div>
    <a class="hero-more" href="/works/xihu-panorama/">查看作品</a>
  </div>
</section>

{lead && <section class="picks" id="picks" aria-label="精选">
  <div class="picks-stage">
    <div class="picks-copy">
      <h2><a class="picks-title" href={`/works/${lead.slug}/`}>{lead.title}</a></h2>
      {lead.yearNum ? <p class="picks-year">{lead.yearNum}</p> : null}
    </div>
    <img class="picks-img" src={pickSrc} alt="" width="1920" height="760" referrerpolicy="no-referrer" loading="lazy"/>
    <a class="picks-more" href={`/works/${lead.slug}/`}>查看作品</a>
  </div>
  <a class="picks-all" href="/works/">全部作品</a>
</section>}

<section class="narrow cta">
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  height: clamp(560px, 82vh, 920px);
  overflow: hidden;
  border-radius: 0;
  background: #141816;
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-video {
  /* scroll.mp4 keeps its audio, but its frames carry burned-in captions
     (「132 艘」「篷、桅船」). Those cannot be removed with CSS, so the
     picture stays on 01.jpg and this element only plays sound. */
  opacity: 0;
  pointer-events: none;
}
.hero.is-still .hero-video { display: none; }
.hero::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: min(460px, 42vw);
  height: 46%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top, rgba(8, 10, 9, 0.22), rgba(8, 10, 9, 0));
}
.hero-overlay {
  position: absolute;
  left: clamp(24px, 4vw, 48px);
  right: clamp(24px, 4vw, 48px);
  bottom: clamp(24px, 4vw, 48px);
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  pointer-events: none;
}
.hero-copy,
.hero-more { pointer-events: auto; }
.hero-copy {
  max-width: min(420px, 46vw);
  text-align: left;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
}
.hero-copy .kicker {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.12em;
  opacity: 0.7;
}
.hero-copy h1 {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: clamp(28px, 3.6vw, 44px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.hero-copy .sub {
  margin: 0;
  color: #fff;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  opacity: 0.75;
}
#snd.btn.solid {
  margin-top: 18px;
  background: #fff;
  color: #1A1A1C;
  border-color: #fff;
}
.hero-more {
  flex: none;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  text-decoration: none;
  opacity: 0.85;
  white-space: nowrap;
}
.hero-more:hover { opacity: 1; }
#snd.btn.solid:disabled,
#snd.btn.solid:disabled:hover {
  opacity: 0.45;
  cursor: not-allowed;
}
.picks {
  background: #F6F5F3;
  padding: clamp(108px, 13vh, 156px) 0 clamp(88px, 11vh, 128px);
  overflow: hidden;
}
.picks-stage {
  position: relative;
  width: min(1040px, 70vw);
  margin: 0 auto;
}
.picks-img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 0;
  background: #E6E3DE;
}
.picks-copy {
  position: absolute;
  left: 0;
  top: 50%;
  z-index: 1;
  width: max-content;
  transform: translate(-30%, -50%);
}
.picks-copy h2 { margin: 0; font-weight: inherit; }
.picks-title {
  display: block;
  max-width: 5.05em;
  color: #1A1A1C;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: clamp(32px, 3.2vw, 48px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.12;
  text-decoration: none;
}
.picks-year {
  margin: 12px 0 0;
  color: #8A8A8A;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.04em;
}
.picks-more {
  position: absolute;
  right: 0;
  top: 46%;
  transform: translate(118%, -50%);
  color: #1A1A1C;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  letter-spacing: 0.04em;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
}
.picks-more:hover,
.picks-title:hover { opacity: 0.62; }
.picks-all {
  display: block;
  width: fit-content;
  margin: 52px auto 0;
  color: #9A9A9A;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-decoration: none;
}
.picks-all:hover { color: #1A1A1C; }
.picks-title:focus-visible,
.picks-more:focus-visible,
.picks-all:focus-visible {
  outline: 1px solid var(--ink);
  outline-offset: 4px;
}
.cta { text-align: center; margin-top: 160px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 900px) {
  .picks { padding: 72px 0 64px; overflow: visible; }
  .picks-stage { width: calc(100% - 32px); }
  .picks-copy {
    position: relative;
    top: auto;
    left: auto;
    width: auto;
    max-width: none;
    margin-bottom: 18px;
    padding-right: 5.5em;
    transform: none;
  }
  .picks-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 62%;
  }
  .picks-title { max-width: 8em; font-size: 30px; }
  .picks-more {
    position: absolute;
    right: 0;
    top: 0.2em;
    transform: none;
  }
  .picks-all { margin-top: 28px; }
}
@media (max-width: 760px) {
  .hero { height: clamp(520px, 86vh, 720px); border-radius: 0; }
  .hero-overlay {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .hero-copy { max-width: none; width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-video { display: none; transition: none; }
  .hero.is-listening .hero-video {
    display: block;
    opacity: 0;
  }
}
</style>
<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const listen = document.getElementById('snd');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const still = hero.querySelector('.hero-still');
let stopped = false;
let listening = false;
let unavailable = false;
let suppressError = false;

function setVolume(value) {
  try { video.volume = value; } catch (err) { /* iOS keeps volume read-only */ }
}

function showStill() {
  hero.classList.add('is-still');
  hero.classList.remove('is-playing');
  if (stopped) return;
  stopped = true;
  suppressError = true;
  video.pause();
  video.removeAttribute('src');
  video.load();
}

function markUnavailable() {
  if (unavailable) return;
  unavailable = true;
  listening = false;
  hero.classList.remove('is-listening');
  video.muted = true;
  video.defaultMuted = true;
  video.setAttribute('muted', '');
  setVolume(0);
  listen.disabled = true;
  listen.setAttribute('aria-pressed', 'false');
  listen.textContent = '暂无声音';
  showStill();
}

function setAudible(on) {
  listening = on;
  hero.classList.toggle('is-listening', on);
  if (on) {
    video.muted = false;
    video.defaultMuted = false;
    video.removeAttribute('muted');
    setVolume(1);
    listen.setAttribute('aria-pressed', 'true');
    listen.textContent = '❚❚ 静音';
  } else {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    setVolume(0);
    listen.setAttribute('aria-pressed', 'false');
    if (!unavailable) listen.textContent = '▶ 聆听图景';
  }
}

function attachSource() {
  const src = video.dataset.src;
  if (!src) return false;
  suppressError = false;
  stopped = false;
  hero.classList.remove('is-still');
  video.playsInline = true;
  video.autoplay = true;
  video.loop = true;
  video.preload = 'auto';
  if (!listening) {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
  }
  if (video.getAttribute('src') !== src) video.src = src;
  return true;
}

function startVideo() {
  if (unavailable) return;
  if (motion.matches && !listening) { showStill(); return; }
  if (!attachSource()) { markUnavailable(); return; }
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (listening || unavailable) return;
    if (err && err.name === 'NotAllowedError') showStill();
    else if (video.error) markUnavailable();
  });
}

video.addEventListener('playing', () => {
  if (motion.matches || hero.classList.contains('is-still')) return;
  hero.classList.add('is-playing');
});
video.addEventListener('error', () => {
  if (suppressError || unavailable) return;
  markUnavailable();
});
if (still) still.addEventListener('error', () => { still.hidden = true; });
listen.addEventListener('click', () => {
  if (unavailable || listen.disabled) return;
  if (listening) {
    setAudible(false);
    if (motion.matches) showStill();
    return;
  }
  if (!attachSource()) { markUnavailable(); return; }
  // Unmute inside the click so the gesture unlocks this video's own audio track.
  setAudible(true);
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (unavailable) return;
    if (err && err.name === 'AbortError') return;
    setAudible(false);
    if (video.error) markUnavailable();
  });
});
if (motion.addEventListener) motion.addEventListener('change', () => {
  if (unavailable) return;
  if (motion.matches) {
    hero.classList.remove('is-playing');
    if (!listening) showStill();
    return;
  }
  startVideo();
});
startVideo();
</script>
</Base>
