@media (max-width: 768px) {
  .hero-still { animation: m-drift 40s linear infinite alternate; }
  .hero-plate:has(.listen[aria-pressed="true"]) .m-prog {
    display: flex; align-items: center; gap: 10px; margin-top: 12px;
    color: var(--muted); font-size: 11px; letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums; pointer-events: none;
  }
  .m-prog i { display: block; width: 96px; height: 1px; background: color-mix(in srgb, var(--ink) 18%, transparent); position: relative; }
  .m-prog b { position: absolute; left: 0; top: 0; height: 1px; width: 100%; background: var(--ink); transform-origin: 0 50%; transform: scaleX(var(--prog, 0)); }
  .m-peek {
    position: absolute; left: 0; right: 0; bottom: 0; height: 64px;
    padding: 16px var(--page-gutter) 0; display: flex; justify-content: space-between;
    background: var(--bg); color: var(--faint); font-size: 12px; letter-spacing: 0.2em; text-decoration: none;
  }
  :global(html) { scroll-snap-type: y mandatory; }
  .first-screen, .picks { scroll-snap-align: start; scroll-snap-stop: always; }
  .picks { min-height: 100vh; min-height: 100svh; padding-top: 52px; background: var(--bg); }
}

/* Mobile featured card stack */
.m-feat { display: none; }
@media (max-width: 768px) {
  .picks { height: auto; padding-bottom: 8px; }
  .m-feat {
    /* vw (not %) so --ch stays a length; 76px covers the 3×20px right peeks. */
    --cw: calc(100vw - var(--page-gutter) - 76px); --ch: calc(var(--cw) * 9 / 16);
    display: block; color: var(--ink); font-family: "Noto Sans SC", "Noto Sans CJK SC", sans-serif;
  }
  .m-hd { display: flex; justify-content: space-between; align-items: baseline; padding: 14px var(--page-gutter) 0; line-height: normal; }
  .m-hd b { font-size: 12px; font-weight: 400; color: var(--faint); letter-spacing: 0.2em; }
  .m-hd span { font-size: 12px; color: var(--faint); letter-spacing: 0.12em; font-variant-numeric: tabular-nums; }
  .m-stage { position: relative; height: calc(var(--ch) + 44px); margin-top: 22px; perspective: 900px; touch-action: pan-y; overflow: hidden; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }
  .m-card { position: absolute; left: 0; top: 0; width: var(--cw); height: var(--ch); transform-origin: 100% 50%; border-radius: 0; overflow: hidden; background: var(--bg2); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 16%, transparent); will-change: transform, opacity; backface-visibility: hidden; }
  .m-card:not([style]) { transform: translateX(var(--page-gutter)); }
  .m-card:not([style]) ~ .m-card:not([style]) { opacity: 0; }
  .m-card img { width: 100%; height: 100%; object-fit: cover; display: block; max-width: none; pointer-events: none; }
  .m-card .fs-clip { z-index: 1; backface-visibility: visible; }
  .m-ctrls {
    position: absolute;
    z-index: 2;
    left: 8px;
    bottom: 8px;
    display: flex;
    gap: 8px;
  }
  .m-card[aria-hidden="true"] .m-ctrls { visibility: hidden; }
  .m-card .fs-pin,
  .m-card .m-full {
    position: static;
    width: 44px;
    height: 44px;
    padding: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border: 0;
    border-radius: 0;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
  }
  .m-card .m-full svg { width: 16px; height: 16px; display: block; }
  .m-bar { display: flex; gap: 6px; padding: 0 var(--page-gutter); }
  .m-bar i { flex: 1; height: 2px; background: var(--rule); transition: background 0.25s ease; }
  .m-bar i.on { background: var(--ink); }
  .m-info { padding: 22px var(--page-gutter) 0; }
  .m-title { margin: 0; color: var(--ink); font-family: var(--sans); font-weight: 600; font-size: 28px; line-height: 1.25; letter-spacing: -0.03em; }
  .m-title-link { color: inherit; text-decoration: none; }
  .m-meta { margin-top: 8px; font-size: 12px; color: var(--faint); letter-spacing: 0.08em; }
  .m-body { margin: 12px 0 0; font-size: 14px; line-height: 1.75; color: var(--ink-soft); }
  .m-view { display: inline-block; margin-top: 16px; color: var(--ink); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--ink) 50%, transparent); padding-bottom: 2px; }
  .m-view span { margin-left: 4px; }
  .m-feat [hidden] { display: none !important; }
  .m-list { list-style: none; margin: 22px var(--page-gutter) 0; padding: 0; border-top: 1px solid var(--rule); }
  .m-row { border-bottom: 1px solid var(--rule); }
  .m-row button { display: flex; align-items: center; gap: 14px; width: 100%; height: 44px; padding: 0; border: 0; background: none; color: var(--ink2); font: inherit; font-size: 14px; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .m-row .no { font-size: 11px; width: 18px; color: var(--faint); font-variant-numeric: tabular-nums; }
  .m-row .t { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .m-row .y { font-size: 12px; }
  .m-row.on button { color: var(--ink); }
  .m-row.on .no { color: var(--ink); }
  .m-row.on .t { font-weight: 600; }
  .m-row.m-all { border-bottom: none; }
  .m-row.m-all button { color: var(--ink); font-size: 13px; letter-spacing: 0.08em; }
  .m-row.m-all .y { color: var(--faint); }
}
@media (prefers-reduced-motion: reduce) {
  .fs-still, .fs-bg, .hero-still, .fs-video, .fs-dot::before { animation: none; transition: none; }
  .fs-slide.is-active { transform: none; }
}
</style>

<script>
// Nav auto-hide (desktop)
const nav = document.getElementById('home-nav');
let hoverTop = false, scrollShown = false, lastY = window.scrollY;
function syncNav() { nav?.classList.toggle('is-shown', hoverTop || scrollShown); }
window.addEventListener('mousemove', (e) => {
  const near = e.clientY <= (nav?.classList.contains('is-shown') ? 96 : 72);
  if (near !== hoverTop) { hoverTop = near; syncNav(); }
}, { passive: true });
document.documentElement.addEventListener('mouseleave', () => { hoverTop = false; syncNav(); });
window.addEventListener('scroll', () => {
  const y = window.scrollY, dy = y - lastY;
  if (y <= 4) scrollShown = false;
  else if (dy < -4) scrollShown = true;
  else if (dy > 4) scrollShown = false;
  if (Math.abs(dy) > 4 || y <= 4) lastY = y;
  syncNav();
}, { passive: true });
</script>

<script>
import { mountHomeClips } from '../scripts/home-clips.js';
import { mountHomeChapters } from '../scripts/home-chapters.js';
mountHomeClips();
import { mountMobileHero } from '../scripts/mobile-hero.js';
import { mountMobileStack } from '../scripts/mobile-stack.js';
import { mountMobilePager } from '../scripts/mobile-pager.js';
mountHomeChapters();
const heroDwell = mountMobileHero();
const mobileStackRoot = document.getElementById('m-feat');
const stackDwell = mobileStackRoot ? mountMobileStack(mobileStackRoot) : null;
mountMobilePager([
  { el: document.getElementById('first-screen'), dwell: heroDwell },
  { el: document.getElementById('picks'), dwell: stackDwell },
]);
</script>
