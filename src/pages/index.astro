---
import Base from '../layouts/Base.astro';
import { allWorks, coverClip, pickBody, pickDeskBody, pickIntro, pickSummary, pickTypeYear, workCovers, workFallback } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
const SCROLL_STILL = `${R2}/01.jpg?v=20261026`;
const SCROLL_FALLBACK = `${R2}/02.jpg`;
const picks = ws.map((w) => ({
  slug: w.slug,
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  intro: pickIntro(w),
  summary: pickSummary(w),
  meta: pickTypeYear(w),
  body: pickDeskBody(w),
  stills: workCovers(w),
  fallback: workFallback(w),
  clip: coverClip(w.slug),
}));
// 首页精选固定名单（顺序即轮播顺序）；不在名单里的作品不进首页。
const HOME_PICKS = [
  'xihu-panorama',
  'scendance',
  'chicken-universe',
  'anyreal',
  'genshot-AI-video-generation-tool',
  'mimi-agent',
  'tuijian',
  'peace-elite-hust-campus',
];
const homeWs = HOME_PICKS.map((slug) => ws.find((w) => w.slug === slug)).filter(Boolean);
const homePicks = homeWs.map((w) => picks.find((p) => p.slug === w.slug));
const leadPick = homePicks[0];
const ringWorks = homePicks;
const mobilePicks = homeWs.map((w, i) => ({
  no: String(i + 1).padStart(2, '0'),
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  meta: pickTypeYear(w),
  body: pickBody(w),
  cover: workCovers(w)[0],
  fallback: workFallback(w),
  clip: coverClip(w.slug),
}));
const mLead = mobilePicks[0];
const PAGE_DWELL: Record<'hero' | 'picks', 'on' | 'off'> = { hero: 'off', picks: 'on' };
---
<Base active="/" home fullscreen>

{/* ---- Mobile: hero + card stack (≤768px only) ---- */}
<div class="first-screen" id="first-screen" data-dwell={PAGE_DWELL.hero}>
<section class="hero" id="scroll-hero-m" aria-label="当代西湖繁胜全景图" data-clip={coverClip('xihu-panorama') ? '1' : undefined}>
  <div class="hero-pan">
    <img class="hero-still" src={SCROLL_STILL} data-fallback={SCROLL_FALLBACK} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
  </div>
  {coverClip('xihu-panorama') && (
    <video class="fs-clip" id="scroll-video-m" muted loop playsinline webkit-playsinline preload="metadata" disablepictureinpicture aria-hidden="true" data-src={coverClip('xihu-panorama')}></video>
  )}
  <div class="hero-info">
    <div class="hero-plate">
      <div class="hero-copy">
        <h1>当代西湖繁胜全景图</h1>
        <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成。</p>
      </div>
      <div class="fs-actions">
        <button id="snd-m" class="listen" type="button" aria-pressed="false" aria-controls="scroll-video-m"><span class="ic" aria-hidden="true"></span><span class="lb">聆听图景</span></button>
      </div>
      <div class="m-prog" id="m-prog" aria-hidden="true"><i><b id="m-prog-fill"></b></i><span id="m-prog-time">00:00 / 00:00</span></div>
    </div>
  </div>
</section>
<a class="m-peek" href="#picks"><span>精选作品</span><span>{mobilePicks.length}</span></a>
</div>

{leadPick && <section class="picks" id="picks" data-dwell={PAGE_DWELL.picks}>
  {mLead && <div class="m-feat" id="m-feat">
    <div class="m-hd"><b>精选作品</b><span id="m-count">01 / {String(mobilePicks.length).padStart(2, '0')}</span></div>
    <div class="m-stage" id="m-stage" role="group" aria-roledescription="carousel" aria-label="精选作品">
      {mobilePicks.map((w, i) => (
        <div class="m-card" data-i={i} data-clip={w.clip ? '1' : undefined} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img src={w.cover} data-fallback={w.fallback} alt={w.title} width="1200" height="675" draggable="false" decoding="async" referrerpolicy="no-referrer" loading={i < 4 ? 'eager' : 'lazy'}/>
          {w.clip && <video class="fs-clip" muted loop playsinline webkit-playsinline preload="metadata" disablepictureinpicture aria-hidden="true" data-src={w.clip}></video>}
          {w.clip && <div class="m-ctrls">
            <button class="fs-pin" type="button" aria-pressed="false" aria-label="播放预览" title="播放预览"><svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg><svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" fill="currentColor"/></svg></button>
            <button class="m-full" type="button" aria-label="全屏" title="全屏"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v2H7v3H5V5zm9 0h5v5h-2V7h-3V5zM5 14h2v3h3v2H5v-5zm12 3v-3h2v5h-5v-2h3z" fill="currentColor"/></svg></button>
          </div>}
        </div>
      ))}
    </div>
    <div class="m-bar" id="m-bar" aria-hidden="true">{mobilePicks.map((_, i) => <i class={i === 0 ? 'on' : undefined}></i>)}</div>
    <div class="m-info" aria-live="polite">
      <h2 class="m-title"><a class="m-title-link" id="m-title" href={mLead.href}>{mLead.title}</a></h2>
      <div class="m-meta" id="m-meta" hidden={!mLead.meta}>{mLead.meta}</div>
      <p class="m-body" id="m-body" hidden={!mLead.body}>{mLead.body}</p>
      <a class="m-view" id="m-view" href={mLead.href}>查看作品 <span aria-hidden="true">→</span></a>
    </div>
    <ul class="m-list" id="m-list">
      {mobilePicks.map((w, i) => (
        <li class:list={['m-row', { on: i === 0 }]} data-i={i} hidden={i > 3}>
          <button type="button" data-i={i}><span class="no">{w.no}</span><span class="t">{w.title}</span><span class="y">{w.year}</span></button>
        </li>
      ))}
      <li class="m-row m-all"><button type="button" id="m-all" aria-expanded="false" aria-controls="m-list"><span class="t">全部作品</span><span class="y">{mobilePicks.length}</span></button></li>
    </ul>
    <script type="application/json" id="m-pick-data" set:html={JSON.stringify(mobilePicks).replace(/</g, '\\u003c')}></script>
  </div>}
</section>}

{/* Desktop: one fullscreen chapter at a time. Scroll crossfades; nothing autoplays. */}
{leadPick && <div class="fs-runway" id="fs-runway" data-hold="0.85" style={`--chapters:${ringWorks.length};--hold:0.85`}>
  <div class="fs-stage" id="fs-stage" aria-label="精选作品">
    <div class="fs-slide is-active" data-i="0" data-clip={leadPick.clip ? '1' : undefined} aria-hidden="false">
      <div class="fs-pan">
        <img class="fs-still" src={SCROLL_STILL} data-fallback={SCROLL_FALLBACK} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
        {leadPick.clip && (
          <video
            id="scroll-video"
            class="fs-video fs-clip"
            muted
            playsinline
            webkit-playsinline
            x5-playsinline
            preload="none"
            disablepictureinpicture
            referrerpolicy="no-referrer"
            data-src={leadPick.clip}
            aria-hidden="true"
          ></video>
        )}
      </div>
      <div class="fs-plate">
          <p class="fs-kicker"><b>01</b> / {String(ringWorks.length).padStart(2, '0')}</p>
        <h1 class="fs-title">{leadPick.title}</h1>
        {leadPick.summary && <p class="fs-summary">{leadPick.summary}</p>}
        <div class="fs-actions">
          {leadPick.clip && <button class="fs-pin" type="button" aria-pressed="false" aria-label="播放预览" title="播放预览"><svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg><svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" fill="currentColor"/></svg></button>}
          <button id="snd" class="listen" type="button" aria-pressed="false" aria-controls="scroll-video" aria-label="聆听图景" title="聆听图景"><svg class="i-mute" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15.5 9.7l4.6 4.6m0-4.6l-4.6 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg><svg class="i-snd" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.6a8 8 0 0 1 0 10.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg></button>
          <span class="fs-prog" id="fs-prog" aria-hidden="true"><i><b id="fs-prog-fill"></b></i><span id="fs-prog-time">00:00 / 00:00</span></span>
          <a class="fs-view" href={leadPick.href}>查看作品 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    {ringWorks.slice(1).map((work, i) => (
      <div class="fs-slide" data-i={i + 1} data-clip={work.clip ? '1' : undefined} aria-hidden="true" inert>
        {work.clip ? (
          <div class="fs-visual">
            <img class="fs-bg" alt="" width="1920" height="1080" draggable="false" referrerpolicy="no-referrer" decoding="async" src={work.stills[0]} data-fallback={work.fallback} loading="lazy"/>
            <video class="fs-clip" id={`fs-video-${i + 1}`} muted loop playsinline webkit-playsinline preload="metadata" disablepictureinpicture aria-hidden="true" data-src={work.clip}></video>
          </div>
        ) : (
          <img class="fs-bg" alt="" width="1920" height="1080" draggable="false" referrerpolicy="no-referrer" decoding="async" src={work.stills[0]} data-fallback={work.fallback} loading="lazy"/>
        )}
        <div class="fs-plate">
          <p class="fs-kicker"><b>{String(i + 2).padStart(2, '0')}</b> / {String(ringWorks.length).padStart(2, '0')}</p>
          <h2 class="fs-title"><a href={work.href}>{work.title}</a></h2>
          {work.summary && <p class="fs-summary">{work.summary}</p>}
          <div class="fs-actions">
            {work.clip && <button class="fs-pin" type="button" aria-pressed="false" aria-label="播放预览" title="播放预览"><svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg><svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" fill="currentColor"/></svg></button>}
            {work.clip && <button class="listen" type="button" aria-pressed="false" aria-controls={`fs-video-${i + 1}`} aria-label="静音" title="静音"><svg class="i-mute" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15.5 9.7l4.6 4.6m0-4.6l-4.6 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg><svg class="i-snd" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.6a8 8 0 0 1 0 10.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg></button>}
            <a class="fs-view" href={work.href}>查看作品 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
    <div class="fs-rail">
      {ringWorks.map((work, i) => (
        <button class:list={['fs-dot', { on: i === 0 }]} type="button" data-i={i} aria-label={`第 ${i + 1} 件，${work.title}`} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
  </div>
</div>}


<style>
/* Chapters: full-bleed picture, type on paper. No edge darkening. */
.fs-runway { display: none; height: calc((var(--chapters) + var(--hold, 0.85)) * 100vh); background: var(--bg); }
.fs-stage {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}
@media (min-width: 769px) {
  .fs-runway { display: block; position: relative; width: auto; height: calc((var(--chapters) + var(--hold, 0.85)) * 100vh); overflow: visible; opacity: 1; pointer-events: auto; z-index: auto; }
  .first-screen { display: none; }
  .picks { display: none; }
}
@media (max-width: 768px) {
  /* Kept in the tree so 聆听图景 can play the same file; not shown. */
  .fs-runway {
    display: block;
    position: fixed;
    left: 0; top: 0;
    width: 2px; height: 2px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }
  .fs-still, .fs-bg { animation: none; }
}
.fs-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: translate3d(0, 0, 0) scale(1.04);
  pointer-events: none;
}
.fs-slide.is-active { opacity: 1; pointer-events: auto; }

/* Slide 0: panning painting */
.fs-pan {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.fs-still {
  position: absolute;
  top: calc(-8vh);
  left: 0;
  height: 116%;
  width: auto;
  max-width: none;
  object-fit: initial;
  animation: fs-pan 140s linear infinite alternate;
  will-change: transform;
}
@keyframes fs-pan {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(calc(-100% + 100vw), 0, 0); }
}
.fs-video {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1);
}
.fs-clip { transition: opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1); }
.fs-visual { position: absolute; inset: 0; }
.fs-clip {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  pointer-events: none;
  z-index: 1;
  background: transparent;
}
[data-clip].is-on .fs-clip,
[data-clip].is-on .fs-video { opacity: 1; }
.fs-pin {
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; padding: 0;
  border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
  border-radius: 0;
  background: color-mix(in srgb, var(--bg) 80%, transparent);
  color: var(--ink);
  cursor: pointer;
}
.fs-pin:hover { border-color: var(--ink); }
.fs-pin svg { width: 16px; height: 16px; display: block; }
.fs-pin .i-pause { display: none; }
.fs-pin[aria-pressed="true"] .i-play { display: none; }
.fs-pin[aria-pressed="true"] .i-pause { display: block; }
.hero .fs-clip { z-index: 1; }
.hero-info { z-index: 2; }
.fs-bg {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transform-origin: 50% 42%;
  animation: fs-drift 40s linear infinite alternate;
}
@keyframes fs-drift {
  from { transform: translate3d(1%, 0.5%, 0) scale(1.06); }
  to { transform: translate3d(-1%, -0.5%, 0) scale(1.06); }
}
.fs-plate {
  position: absolute;
  left: var(--page-pad);
  bottom: 40px;
  z-index: 2;
  width: min(400px, calc(100% - 120px));
  padding: 18px 20px 16px;
  background: color-mix(in srgb, var(--bg) 94%, transparent);
  color: var(--ink);
  transition: opacity 0.25s ease, visibility 0s;
}
/* 淡出由 home-clips.js 逐帧驱动 inline opacity；此规则只在淡出结束时接管隐藏 */
.fs-plate.is-closed { visibility: hidden; pointer-events: none; }
.fs-plate::after {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: color-mix(in srgb, var(--ink) 14%, transparent);
}
.fs-plate::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: var(--ink);
  transform: scaleY(var(--p, 0));
  transform-origin: top center;
  z-index: 1;
}
.fs-kicker {
  margin: 0 0 12px;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.16em;
  color: var(--muted);
}
.fs-kicker b { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
.fs-title {
  margin: 0 0 10px;
  font-family: var(--sans);
  font-size: clamp(28px, 3.2vw, 44px);
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: -0.03em;
  color: var(--ink);
}
.fs-title a { color: inherit; text-decoration: none; }
.fs-title a:hover { opacity: 0.72; }
.fs-summary { margin: 0 0 18px; font-family: var(--sans); font-size: 15px; color: var(--ink-soft); max-width: 36em; line-height: 1.65; }
.fs-summary { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.fs-actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.listen {
  display: inline-flex; align-items: center; gap: 8px;
  border: 0; background: var(--cta-bg); color: var(--cta-fg); border-radius: 0;
  padding: 11px 18px;
  font-family: var(--sans); font-size: 13px;
  letter-spacing: 0.08em; cursor: pointer;
}
.listen:hover { opacity: 0.86; }
.listen .ic { width: 0; height: 0; border-left: 7px solid var(--cta-fg); border-top: 4px solid transparent; border-bottom: 4px solid transparent; }
.listen[aria-pressed="true"] .ic { width: 8px; height: 10px; border: 0; border-left: 2px solid var(--cta-fg); border-right: 2px solid var(--cta-fg); }
.listen:disabled { opacity: 0.35; cursor: not-allowed; }
/* 桌面章节白卡内的聆听：喇叭图标按钮，与播放键同规格 */
.fs-plate .listen {
  width: 36px; height: 36px; padding: 0;
  justify-content: center;
  background: color-mix(in srgb, var(--bg) 80%, transparent);
  color: var(--ink);
  border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
}
.fs-plate .listen:hover { border-color: var(--ink); opacity: 1; }
.fs-plate .listen svg { width: 16px; height: 16px; display: block; }
.fs-plate .listen .i-snd { display: none; }
.fs-plate .listen[aria-pressed="true"] { background: var(--cta-bg); color: var(--cta-fg); border-color: transparent; }
.fs-plate .listen[aria-pressed="true"] .i-mute { display: none; }
.fs-plate .listen[aria-pressed="true"] .i-snd { display: block; }
/* 聆听进度内嵌在按钮行（播放/声音键与「查看作品」之间）：空间常驻，出声时淡入，绝不推动布局 */
.fs-prog {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 10px;
  opacity: 0; transition: opacity 0.3s ease;
  color: var(--muted); font-size: 11px; letter-spacing: 0.14em;
  font-variant-numeric: tabular-nums; pointer-events: none;
}
.fs-plate:has(.listen[aria-pressed="true"]) .fs-prog { opacity: 1; }
.fs-prog i { display: block; flex: 1; height: 1px; background: color-mix(in srgb, var(--ink) 18%, transparent); position: relative; }
.fs-prog b { position: absolute; left: 0; top: 0; height: 1px; width: 100%; background: var(--ink); transform-origin: 0 50%; transform: scaleX(var(--prog, 0)); }
.fs-prog > span { width: 88px; text-align: right; white-space: nowrap; }
.fs-view {
  display: inline-block; color: var(--ink);
  font-family: var(--sans);
  font-size: 14px; letter-spacing: 0.06em;
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
  padding-bottom: 2px;
}
.fs-view:hover { border-bottom-color: var(--ink); }
.fs-rail {
  position: absolute;
  right: var(--page-pad);
  top: 50%;
  transform: translateY(-50%);
  z-index: 4;
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 0;
}
.fs-dot {
  width: 28px; height: 16px; border: 0; padding: 0;
  background: transparent; cursor: pointer; position: relative;
}
.fs-dot::before {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 5px; height: 5px;
  border-radius: 0;
  background: color-mix(in srgb, var(--ink) 40%, transparent);
  filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.7));
  transform: translate(-50%, -50%);
  transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1), background 0.36s cubic-bezier(0.22, 1, 0.36, 1);
}
.fs-dot.on::before { height: 18px; background: var(--ink); }
.fs-dot:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

/* ---- Mobile ---- */
.m-prog, .m-peek { display: none; }
.first-screen {
  position: relative;
  height: 100vh; height: 100svh; height: 100dvh;
  background: var(--bg); color: var(--ink);
}
.hero {
  position: absolute; inset: 0; overflow: hidden; background: var(--bg);
}
.hero-pan {
  position: absolute; top: 0; left: 0;
  height: 100%; width: auto;
  animation: none;
  transform: translate3d(var(--pan-x, 0px), 0, 0);
}
.hero-still {
  position: relative; inset: auto; top: 0;
  height: 100%; width: auto; max-width: none; object-fit: initial;
  transform-origin: 30% 50%;
}
.hero-info {
