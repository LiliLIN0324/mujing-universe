---
import Base from '../layouts/Base.astro'; import WorkCard from '../components/WorkCard.astro';
import { allWorks, FEATURED } from '../lib';
const ws = await allWorks(); const feat = FEATURED.map(s => ws.find(w => w.slug === s)).filter(Boolean);
// Public R2 object. Do not commit the mp4. logo.jpg / 01.jpg are not in this prefix, so the poster is the local SVG.
const SCROLL_VIDEO = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/scroll-placeholder.mp4';
const SCROLL_POSTER = '/scroll-placeholder.svg';
---
<Base active="/">
<section class="wrap stage">
  <div class="hero" id="scroll-hero">
    <img class="hero-still" src={SCROLL_POSTER} alt="占位长卷" width="4800" height="600"/>
    <video
      id="scroll-video"
      class="hero-video"
      poster={SCROLL_POSTER}
      muted
      playsinline
      loop
      preload="none"
      disablepictureinpicture
      referrerpolicy="no-referrer"
      data-src={SCROLL_VIDEO}
      aria-hidden="true"
    ></video>
  </div>
  <div class="hero-copy">
    <p class="kicker cap">音画新线 · 进行中</p>
    <h1>当代西湖繁胜全景图</h1>
    <p class="sub">占位长卷 · 自绘矢量 · 正式作品待替换</p>
    <button id="snd" class="btn solid sound" type="button">▶ 聆听图景</button>
  </div>
</section>

<section class="wrap picks">
  <h2>精选</h2>
  <div class="grid">{feat.map(w => <WorkCard w={w}/>)}</div>
  <p class="more"><a class="btn" href="/works/">全部 {ws.length} 件作品</a></p>
</section>

<section class="narrow cta">
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.stage { padding-top: 48px; }
.hero {
  position: relative;
  overflow: hidden;
  height: min(62vh, 560px);
  min-height: 360px;
  border-radius: var(--radius);
  background: var(--bg2);
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-video {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease;
}
.hero.is-playing .hero-video { opacity: 1; }
.hero.is-still .hero-video { display: none; }
.hero-copy { text-align: center; padding: 56px 0 8px; }
.hero-copy h1 {
  margin: 0 0 12px;
  font-size: clamp(36px, 4vw, 48px);
  font-weight: 600;
  line-height: 1.15;
}
.sub { color: var(--muted); margin: 0 0 22px; }
.picks { padding-top: 120px; }
.picks h2 {
  margin: 0 0 48px;
  text-align: center;
  font-size: clamp(36px, 4vw, 48px);
  font-weight: 600;
}
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 64px 40px; }
.more { text-align: center; margin: 40px 0 0; }
.cta { text-align: center; margin-top: 160px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 760px) {
  .hero { height: 62vw; min-height: 220px; border-radius: 16px; }
  .grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-video { display: none; transition: none; }
}
</style>
<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
let stopped = false;

function showStill() {
  hero.classList.add('is-still');
  hero.classList.remove('is-playing');
  if (stopped) return;
  stopped = true;
  video.pause();
  video.removeAttribute('src');
  video.load();
}

function startVideo() {
  if (motion.matches) { showStill(); return; }
  const src = video.dataset.src;
  if (!src) { showStill(); return; }
  stopped = false;
  hero.classList.remove('is-still');
  video.muted = true;
  video.defaultMuted = true;
  video.playsInline = true;
  video.preload = 'auto';
  if (video.getAttribute('src') !== src) video.src = src;
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (err && err.name === 'NotAllowedError') showStill();
  });
}

video.addEventListener('playing', () => {
  if (!hero.classList.contains('is-still')) hero.classList.add('is-playing');
});
video.addEventListener('error', showStill);
if (motion.addEventListener) motion.addEventListener('change', () => motion.matches ? showStill() : startVideo());
startVideo();
</script>
<script>
let ctx,nodes=null;const b=document.getElementById('snd');
b.addEventListener('click',()=>{if(nodes){nodes.g.gain.setTargetAtTime(0,ctx.currentTime,.3);nodes.o.forEach(o=>o.stop(ctx.currentTime+1));nodes=null;b.textContent='▶ 聆听图景';return;}
ctx=ctx||new AudioContext();const g=ctx.createGain();g.gain.value=0;g.connect(ctx.destination);
const o=[196,293.7,392,587.3,659.3].map((f,i)=>{const x=ctx.createOscillator();x.type=i%2?'triangle':'sine';x.frequency.value=f;const lg=ctx.createGain();lg.gain.value=.1/(i+1);x.connect(lg).connect(g);x.start();return x;});
g.gain.setTargetAtTime(.45,ctx.currentTime,.8);nodes={g,o};b.textContent='❚❚ 静音';});
</script>
</Base>
