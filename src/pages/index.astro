---
import Base from '../layouts/Base.astro';
import { allWorks, pickBody, pickDeskBody, pickIntro, pickMeta, pickSummary, pickTech, pickTypeYear, workCovers, workFallback } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
const SCROLL_VIDEO = `${R2}/scroll-placeholder.mp4`;
const SCROLL_STILL = `${R2}/01.jpg`;
const picks = ws.map((w) => ({
  slug: w.slug,
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  intro: pickIntro(w),
  summary: pickSummary(w),
  meta: pickTypeYear(w),
  body: pickDeskBody(w),
  stills: workCovers(w),
  fallback: workFallback(w),
}));
const leadPick = picks[0];
const ringWorks = picks.slice(0, 10);
/* Mobile (≤768px) card stack: same 10 works + covers as the ring. Role has no
   field in the works data, so the 角色 column stays hidden until real data exists. */
const mobilePicks = ws.slice(0, 10).map((w, i) => ({
  no: String(i + 1).padStart(2, '0'),
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  meta: pickMeta(w),
  body: pickBody(w),
  role: [] as string[],
  tech: pickTech(w),
  cover: `/ring/${i}.jpg`,
  fallback: workFallback(w) || '/ring/paper.jpg',
}));
const mLead = mobilePicks[0];
/* Mobile (≤768px) page-by-page homepage: per-page "dwell" switch.
   'on'  = vertical swipes first play through the page's own content (hero: pan the
           painting in 3 steps; featured: walk the cards 01→10), then flip the page.
   'off' = the swipe flips the page immediately. Default (project lead): only 精选 (picks) dwells. */
const PAGE_DWELL: Record<'hero' | 'picks' | 'cta', 'on' | 'off'> = { hero: 'off', picks: 'on', cta: 'off' };
---
<Base active="/" home>
<div class="first-screen" id="first-screen" data-dwell={PAGE_DWELL.hero}>
<section class="hero" id="scroll-hero" aria-label="当代西湖繁胜全景图">
  <div class="hero-pan">
    <img class="hero-still" src={SCROLL_STILL} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
    <video
      id="scroll-video"
      class="hero-video"
      muted
      autoplay
      playsinline
      loop
      preload="auto"
      disablepictureinpicture
      referrerpolicy="no-referrer"
      src={SCROLL_VIDEO}
      data-src={SCROLL_VIDEO}
      aria-hidden="true"
    ></video>
  </div>
  <div class="hero-cue" aria-hidden="true">长卷 · 自动展开<i></i>01 / 12</div>
  <div class="hero-seal" aria-hidden="true">滑动或拖动 · 浏览全卷</div>
  <div class="m-prog" id="m-prog" aria-hidden="true"><i><b id="m-prog-fill"></b></i><span id="m-prog-time">00:00 / 00:00</span></div>
</section>
<div class="hero-info">
  <div class="hero-copy">
    <h1>当代西湖繁胜全景图</h1>
    <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成。</p>
    <p class="meta">古画新绘　·　进行中　·　2026</p>
  </div>
  <div class="hero-act">
    <button id="snd" class="listen" type="button" aria-pressed="false" aria-controls="scroll-video"><span class="ic" aria-hidden="true"></span><span class="lb">聆听图景</span></button>
  </div>
</div>
<a class="scroll-cue" id="scroll-cue" href="#picks" aria-label="向下滚动至精选"><span>SCROLL</span><i></i></a>
<a class="m-down" href="#picks" aria-label="向下滚动至精选作品"><b>下滑</b><i></i><em>⌄</em></a>
<a class="m-peek" href="#picks"><span>精选作品</span><span>{mobilePicks.length}</span></a>
</div>

{leadPick && <section class="picks" id="picks" aria-label="精选" data-dwell={PAGE_DWELL.picks}>
  {mLead && <div class="m-feat" id="m-feat">
    <div class="m-hd"><b>精选作品</b><span id="m-count">01 / {String(mobilePicks.length).padStart(2, '0')}</span></div>
    <div class="m-stage" id="m-stage" role="group" aria-roledescription="carousel" aria-label="精选作品">
      {mobilePicks.map((w, i) => (
        <div class="m-card" data-i={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img src={w.cover} data-fallback={w.fallback} alt={w.title} width="1200" height="675" draggable="false" decoding="async" referrerpolicy="no-referrer" loading={i < 4 ? 'eager' : 'lazy'}/>
        </div>
      ))}
    </div>
    <div class="m-bar" id="m-bar" aria-hidden="true">{mobilePicks.map((_, i) => <i class={i === 0 ? 'on' : undefined}></i>)}</div>
    <div class="m-info" aria-live="polite">
      <h2 class="m-title"><a class="m-title-link" id="m-title" href={mLead.href}>{mLead.title}</a></h2>
      <div class="m-meta" id="m-meta" hidden={!mLead.meta}>{mLead.meta}</div>
      <p class="m-body" id="m-body" hidden={!mLead.body}>{mLead.body}</p>
      <dl class="m-facts" id="m-facts" hidden={!mLead.role.length && !mLead.tech.length}>
        <div id="m-role" hidden={!mLead.role.length}><dt>角色</dt><dd>{mLead.role.join(' · ')}</dd></div>
        <div id="m-tech" hidden={!mLead.tech.length}><dt>技术</dt><dd>{mLead.tech.join(' · ')}</dd></div>
      </dl>
      <a class="m-view" id="m-view" href={mLead.href}>查看作品 <span aria-hidden="true">→</span></a>
    </div>
    <ul class="m-list" id="m-list">
      {mobilePicks.map((w, i) => (
        <li class:list={['m-row', { on: i === 0 }]} data-i={i} hidden={i > 3}>
          <button type="button" data-i={i}><span class="no">{w.no}</span><span class="t">{w.title}</span><span class="y">{w.year}</span></button>
        </li>
      ))}
      <li class="m-row m-all"><button type="button" id="m-all" aria-expanded="false" aria-controls="m-list"><span class="t">全部作品</span><span class="y">{mobilePicks.length}</span></button></li>
    </ul>
    <script type="application/json" id="m-pick-data" set:html={JSON.stringify(mobilePicks).replace(/</g, '\\u003c')}></script>
  </div>}
  <div class="picks-sticky">
  <canvas class="pick-canvas" id="pick-canvas" aria-hidden="true"></canvas>
  <div class="picks-layout">
    <div class="picks-copy">
      <h2 class="picks-label">精选</h2>
      <div class="picks-intro" id="pick-intro" aria-live="polite">
        <h3 class="pick-intro-title">
          <a class="pick-intro-title-link" data-role="title-link" href={leadPick.href}>{leadPick.title}</a>
        </h3>
        <p class="pick-intro-summary" data-role="summary" hidden={!leadPick.summary}>{leadPick.summary}</p>
        <p class="pick-intro-meta" data-role="meta" hidden={!leadPick.meta}>{leadPick.meta}</p>
        <p class="pick-intro-body" data-role="body" hidden={!leadPick.body}>{leadPick.body}</p>
        <a class="pick-intro-view" data-role="view" href={leadPick.href}>查看作品 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="about__gallery" id="pick-stage">
      <div class="about__gallery__wrapper" id="pick-gallery">
        {ringWorks.map((work, i) => (
          <div class="about__gallery__link" data-i={i}>
            <figure class="about__gallery__media">
              <img
                class="about__gallery__media__image"
                alt={work.title}
                width="1200"
                height="675"
                draggable="false"
                referrerpolicy="no-referrer"
                decoding="async"
                src={`/ring/${i}.jpg`}
                data-fallback={work.fallback || '/ring/paper.jpg'}
              />
            </figure>
          </div>
        ))}
      </div>
    </div>
    <div class="pick-list-window">
      <ol class="pick-list" id="pick-list">
        {picks.map((p, i) => (
          <li class:list={['pick-row', { 'is-active': i === 0 }]}>
            <button class="pick-row-btn" type="button" data-i={i} aria-current={i === 0 ? 'true' : undefined}>
              <span class="row-title">{p.title}</span>
              <span class="row-year">{p.year}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
  </div>
  <script type="application/json" id="pick-data" set:html={JSON.stringify(picks).replace(/</g, '\\u003c')}></script>
</section>}

<section class="narrow cta" id="cta" data-dwell={PAGE_DWELL.cta}>
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.first-screen {
  --hh: max(420px, min(660px, 73.4vh));
  position: relative;
  height: max(100vh, calc(var(--hh) + 240px));
  background: #fff;
  color: #1a1a18;
  font-family: "Noto Sans SC", "Noto Sans CJK SC", sans-serif;
}
.hero {
  position: relative;
  width: 100%;
  height: var(--hh);
  overflow: hidden;
  background: #d8d2c4;
}
/* Mock framing: still scaled to 1180/660 of the frame height, anchored top-left,
   lifted 100px so only pavilions / willows / blossoms / shoreline show.
   Pans very slowly left-to-right across the scroll. */
.hero-pan {
  position: absolute;
  top: calc(var(--hh) * -100 / 660);
  left: -6vw;
  height: calc(var(--hh) * 1180 / 660);
  width: max(calc(var(--hh) * 1180 / 660 * 1920 / 760), 112vw);
  animation: hero-pan 140s ease-in-out infinite alternate;
  will-change: transform;
}
@keyframes hero-pan {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-97% + 106vw)); }
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: 0 0;
  display: block;
}
.hero-video {
  opacity: 0;
  pointer-events: none;
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: radial-gradient(120% 90% at 50% 40%, rgba(0, 0, 0, 0) 60%, rgba(40, 30, 20, 0.12) 100%);
}
.hero-cue,
.hero-seal {
  position: absolute;
  z-index: 2;
  color: rgba(255, 255, 255, 0.92);
  font-size: 12px;
  line-height: normal;
  letter-spacing: 0.24em;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  pointer-events: none;
}
.hero-cue {
  left: 64px;
  bottom: 24px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.hero-cue i {
  display: block;
  width: 120px;
  height: 1px;
  background: rgba(255, 255, 255, 0.5);
  position: relative;
}
.hero-cue i::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  height: 1px;
  width: 22%;
  background: #fff;
}
.hero-seal {
  right: 64px;
  bottom: 22px;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.2em;
}
.hero-info {
  padding: 36px 64px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 32px;
}
.hero-copy h1 {
  margin: 0;
  color: #1a1a18;
  font-family: "Noto Serif SC", "Noto Serif CJK SC", serif;
  font-weight: 600;
  font-size: 52px;
  line-height: 1.1;
  letter-spacing: 0.03em;
}
.hero-copy .sub {
  margin: 12px 0 0;
  font-size: 17px;
  line-height: normal;
  color: #3d3a35;
  letter-spacing: 0.03em;
}
.hero-copy .meta {
  margin: 14px 0 0;
  font-size: 13px;
  line-height: normal;
  letter-spacing: 0.06em;
  color: #9a958c;
}
.hero-act { display: flex; gap: 28px; align-items: center; flex: none; }
.listen {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 0;
  background: #1a1a18;
  color: #fff;
  border-radius: 999px;
  padding: 14px 26px;
  font-family: inherit;
  font-size: 15px;
  line-height: normal;
  letter-spacing: 0.08em;
  cursor: pointer;
}
.listen:hover { opacity: 0.86; }
.listen .ic {
  width: 0;
  height: 0;
  border-left: 9px solid #fff;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
}
.listen[aria-pressed="true"] .ic {
  width: 9px;
  height: 12px;
  border: 0;
  border-left: 3px solid #fff;
  border-right: 3px solid #fff;
}
.listen:disabled,
.listen:disabled:hover {
  opacity: 0.45;
  cursor: not-allowed;
}
.scroll-cue {
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: #8a857c;
  font-size: 11px;
  line-height: normal;
  letter-spacing: 0.3em;
  text-decoration: none;
  transition: opacity 0.4s ease;
}
.scroll-cue span { margin-right: -0.3em; }
.scroll-cue i {
  display: block;
  width: 1px;
  height: 44px;
  background: linear-gradient(180deg, rgba(26, 26, 24, 0), rgba(26, 26, 24, 0.15));
  position: relative;
  overflow: hidden;
}
.scroll-cue i::after {
  content: "";
  position: absolute;
  left: 0;
  top: 14px;
  width: 1px;
  height: 18px;
  background: #1a1a18;
  animation: scroll-drip 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
}
@keyframes scroll-drip {
  0% { transform: translateY(-46px); }
  100% { transform: translateY(44px); }
}
.scroll-cue.is-gone { opacity: 0; pointer-events: none; }
.picks {
  height: 220vh;
  background: #F6F5F3;
  color: #1A1A1C;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  overflow: visible; /* MUST stay visible — overflow:hidden kills position:sticky */
}
.picks-sticky {
  position: sticky;
  top: 0;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(88px, 12vh, 120px) clamp(24px, 4vw, 48px) clamp(48px, 6vh, 72px);
  overflow: hidden;
  background: #F6F5F3;
}
.pick-canvas {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: block;
  pointer-events: auto;
  cursor: pointer;
}
.picks-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(340px, 1.25fr) minmax(260px, 0.85fr);
  column-gap: 48px;
  row-gap: 8px;
  align-items: start;
  /* Let canvas receive clicks in the ring area; re-enable on copy/list. */
  pointer-events: none;
}
.picks-copy {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  z-index: 1;
  background: #F6F5F3;
  pointer-events: auto;
}
.picks-label {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.picks-intro {
  width: min(480px, 40vw);
  margin: 0;
  color: #1A1A1C;
  font-family: inherit;
}
.picks-intro[hidden] { display: none !important; }
.pick-intro-title {
  margin: 0;
  color: #1A1A1C;
  font-family: inherit;
  font-size: clamp(28px, 2.2vw, 32px);
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: -0.02em;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pick-intro-title-link {
  color: inherit;
  text-decoration: none;
}
.pick-intro-title-link:hover { text-decoration: underline; text-underline-offset: 4px; }
/* 2. one-line summary — muted vs body */
.pick-intro-summary {
  margin: 12px 0 0;
  max-width: 28em;
  color: #6B6B6B;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 3. meta: 类型 · 年份 only */
.pick-intro-meta {
  margin: 10px 0 0;
  color: #8A8A8A;
  font-size: 13px;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 0.04em;
}
/* 4. body — richer copy, ~2–3 lines */
.pick-intro-body {
  margin: 14px 0 0;
  max-width: 28em;
  color: #3A3A3C;
  font-size: 15.5px;
  font-weight: 400;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
/* 5. view link */
.pick-intro-view {
  display: inline-block;
  margin-top: 18px;
  color: #1A1A1C;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-decoration: none;
  border-bottom: 1px solid rgba(26, 26, 28, 0.55);
  padding-bottom: 3px;
}
.pick-intro-view:hover { border-bottom-color: #1A1A1C; }
.pick-intro-view span { margin-left: 4px; font-family: Inter, system-ui, sans-serif; }
.picks-intro [hidden] { display: none !important; }
.about__gallery {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
.about__gallery__wrapper,
.about__gallery__link,
.about__gallery__media {
  margin: 0;
}
.about__gallery__media {
  width: 160px;
  height: 90px;
  aspect-ratio: 16 / 9;
  background: #E6E3DE;
  overflow: hidden;
}
.about__gallery__media__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
  pointer-events: none;
  user-select: none;
}
.pick-list-window {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: stretch;
  height: min(640px, 68vh);
  overflow: hidden;
  border-top: 1px solid rgba(26, 26, 28, 0.1);
  font-family: inherit;
  position: relative;
  z-index: 2;
  background: #F6F5F3;
  pointer-events: auto;
}
.pick-list {
  list-style: none;
  margin: 0;
  padding: 0;
  will-change: transform;
}
.pick-row {
  margin: 0;
  padding: 0;
  border-bottom: 1px solid rgba(26, 26, 28, 0.1);
  list-style: none;
}
.pick-row-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
  width: 100%;
  height: 48px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #6B6B6B;
  font-family: inherit;
  font-weight: 400;
  font-size: inherit;
  text-align: left;
  pointer-events: auto;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.pick-row-btn:hover,
.pick-row.is-active .pick-row-btn { color: #1A1A1C; }
.pick-row.is-active .row-title { font-weight: 600; }
.pick-row-btn:focus-visible { outline: 1px solid rgba(26, 26, 28, 0.35); outline-offset: -1px; }
.row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: inherit;
  line-height: 1.3;
}
.row-year {
  flex: none;
  color: #8A8A8A;
  font-size: 13px;
  font-weight: inherit;
  font-variant-numeric: tabular-nums;
}
.cta { text-align: center; margin-top: 280px; padding-top: 48px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 860px) {
  .picks { height: auto; }
  .pick-canvas { display: none; }
  .picks-sticky { position: relative; top: auto; height: auto; padding-top: 72px; }
  .picks-layout { grid-template-columns: 1fr; row-gap: 28px; }
  .picks-copy { grid-column: 1; grid-row: 1; }
  .about__gallery {
    position: relative;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .about__gallery__media {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .picks-intro { width: min(480px, 100%); }
  .pick-list-window { grid-column: 1; grid-row: 3; height: auto; max-height: none; overflow: hidden; }
}
@media (max-width: 760px) {
  .first-screen { --hh: max(360px, min(560px, 62vh)); }
  .hero-cue { left: 20px; }
  .hero-cue i { width: 64px; }
  .hero-seal { display: none; }
  .hero-info { padding: 28px 20px 0; flex-direction: column; align-items: flex-start; gap: 20px; }
  .hero-copy h1 { font-size: 34px; }
  .hero-copy .sub { font-size: 15px; }
}
/* ---- Mobile first screen (≤768px): full-height painting as the player. ---- */
.m-prog,
.m-down,
.m-peek { display: none; }
@media (max-width: 768px) {
  .first-screen {
    height: 100vh;
    height: max(100svh, 844px);
    background: #fff;
