---
import Base from '../layouts/Base.astro';
import { allWorks, featuredWorks } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
// scroll.mp4 keeps its AAC track. Autoplay stays muted; 「聆听图景」 unmutes this same video.
const SCROLL_VIDEO = `${R2}/scroll.mp4`;
const SCROLL_POSTER = `${R2}/still.jpg`;
const PICK_FRAMES = {
  'xihu-panorama': [
    { src: `${R2}/01.jpg`, ratio: '16 / 9', width: '100%', focus: 'center 62%' },
    { src: `${R2}/02.jpg`, ratio: '3 / 4', width: '72%', focus: '42% center' },
    { src: `${R2}/logo.jpg`, ratio: '1 / 1', width: '46%', focus: 'center' },
  ],
};
const FALLBACK_RATIOS = [
  { ratio: '16 / 9', width: '100%' },
  { ratio: '3 / 4', width: '72%' },
  { ratio: '1 / 1', width: '46%' },
];
const picks = featuredWorks(ws).slice(0, 3).map((w) => {
  const own = (w.images || []).filter((src) => src && !src.includes('scroll-placeholder'));
  const frames = PICK_FRAMES[w.slug] || own.slice(0, 3).map((src, i) => ({ src, focus: 'center', ...FALLBACK_RATIOS[i % 3] }));
  return {
    slug: w.slug,
    title: w.title,
    meta: [w.line, w.yearNum || w.year].filter(Boolean).join(' · '),
    href: `/works/${w.slug}/`,
    frames,
  };
}).filter((item) => item.frames.length);
const lead = picks[0];
---
<Base active="/">
<section class="hero" id="scroll-hero" aria-label="当代西湖繁胜全景图">
  <img class="hero-still" src={SCROLL_POSTER} alt="当代西湖繁胜全景图" width="32768" height="627" referrerpolicy="no-referrer" fetchpriority="high"/>
  <video
    id="scroll-video"
    class="hero-video"
    poster={SCROLL_POSTER}
    muted
    autoplay
    playsinline
    loop
    preload="none"
    disablepictureinpicture
    referrerpolicy="no-referrer"
    data-src={SCROLL_VIDEO}
    aria-hidden="true"
  ></video>
  <div class="hero-overlay">
    <div class="hero-copy">
      <p class="kicker">古画新绘 · 进行中</p>
      <h1>当代西湖繁胜全景图</h1>
      <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成</p>
      <button id="snd" class="btn solid sound" type="button" aria-pressed="false" aria-controls="scroll-video">▶ 聆听图景</button>
    </div>
    <a class="hero-more" href="/works/xihu-panorama/">查看作品</a>
  </div>
</section>

{lead && <section class="picks" id="picks" aria-labelledby="picks-mark">
  <div class="picks-board">
    <div class="picks-copy">
      <h2><a class="picks-title" id="picks-title" href={lead.href}>{lead.title}</a></h2>
      <p class="picks-meta" id="picks-meta">{lead.meta}</p>
    </div>
    <div class="picks-col" id="picks-col">
      {lead.frames.map((frame, i) => <img src={frame.src} alt={i === 0 ? lead.title : ''} style={`width:${frame.width};aspect-ratio:${frame.ratio};object-position:${frame.focus}`} referrerpolicy="no-referrer" loading="lazy"/>)}
    </div>
    <p class="picks-mark" id="picks-mark">精选</p>
    <ul class="picks-list">
      {picks.map((item, i) => <li>
        <button type="button" data-title={item.title} data-meta={item.meta} data-href={item.href} data-frames={JSON.stringify(item.frames)} aria-current={i === 0 ? 'true' : undefined}>{item.title}</button>
      </li>)}
      <li><a class="picks-all" href="/works/">全部作品</a></li>
    </ul>
  </div>
</section>}

<section class="narrow cta">
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  height: clamp(560px, 82vh, 920px);
  overflow: hidden;
  border-radius: 0;
  background: #141816;
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-video {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease;
}
.hero.is-playing .hero-video { opacity: 1; }
.hero.is-still .hero-video { display: none; }
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top right, rgba(8, 10, 9, 0.4) 0%, rgba(8, 10, 9, 0.1) 32%, rgba(8, 10, 9, 0) 54%);
}
.hero-overlay {
  position: absolute;
  left: clamp(24px, 4vw, 48px);
  right: clamp(24px, 4vw, 48px);
  bottom: clamp(24px, 4vw, 48px);
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  pointer-events: none;
}
.hero-copy,
.hero-more { pointer-events: auto; }
.hero-copy {
  max-width: min(420px, 46vw);
  text-align: left;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
}
.hero-copy .kicker {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.12em;
  opacity: 0.7;
}
.hero-copy h1 {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: clamp(28px, 3.6vw, 44px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.hero-copy .sub {
  margin: 0;
  color: #fff;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  opacity: 0.75;
}
#snd.btn.solid {
  margin-top: 18px;
  background: #fff;
  color: #1A1A1C;
  border-color: #fff;
}
.hero-more {
  flex: none;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  text-decoration: none;
  opacity: 0.85;
  white-space: nowrap;
}
.hero-more:hover { opacity: 1; }
#snd.btn.solid:disabled,
#snd.btn.solid:disabled:hover {
  opacity: 0.45;
  cursor: not-allowed;
}
.picks {
  background: #F6F5F3;
  padding: 148px 0 120px;
}
.picks-board {
  width: min(1180px, calc(100% - 96px));
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(160px, 0.85fr) minmax(280px, 520px) minmax(120px, 0.62fr);
  grid-template-rows: auto 1fr auto;
  column-gap: 8px;
  align-items: start;
}
.picks-copy {
  grid-column: 1;
  grid-row: 1;
  z-index: 2;
  margin-right: -36px;
  padding-top: 6vh;
}
.picks-copy h2 { margin: 0; font-weight: inherit; }
.picks-title {
  display: block;
  max-width: calc(100% + 48px);
  color: #1A1A1C;
  font-family: "Noto Serif SC", "Songti SC", "Noto Serif", serif;
  font-size: clamp(34px, 3.4vw, 52px);
  font-weight: 500;
  letter-spacing: 0.01em;
  line-height: 1.18;
  text-decoration: none;
}
.picks-title:hover { color: #1A1A1C; }
.picks-meta {
  margin: 8px 0 0;
  color: #9A9A9A;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.18em;
}
.picks-col {
  grid-column: 2;
  grid-row: 1 / span 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 42px;
}
.picks-col img {
  height: auto;
  max-width: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
  background: #E6E3DE;
}
.picks-mark {
  grid-column: 1;
  grid-row: 3;
  align-self: end;
  z-index: 2;
  margin: 0;
  color: #1A1A1C;
  font-family: "Noto Serif SC", "Songti SC", "Noto Serif", serif;
  font-size: clamp(64px, 7.4vw, 112px);
  font-weight: 500;
  letter-spacing: -0.04em;
  line-height: 0.86;
}
.picks-list {
  grid-column: 3;
  grid-row: 1 / span 3;
  align-self: center;
  justify-self: end;
  list-style: none;
  margin: 0;
  padding: 0;
  text-align: right;
}
.picks-list button {
  display: block;
  width: 100%;
  max-width: 12em;
  margin-left: auto;
  padding: 5px 0;
  border: 0;
  background: none;
  color: #B5B5B5;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  text-align: right;
  cursor: pointer;
}
.picks-list button[aria-current="true"] {
  color: #1A1A1C;
  font-weight: 600;
}
.picks-list button:focus-visible {
  outline: 1px solid var(--ink);
  outline-offset: 4px;
}
.picks-all {
  display: inline-block;
  margin-top: 18px;
  color: #B5B5B5;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-decoration: none;
}
.picks-all:hover { color: #1A1A1C; }
.cta { text-align: center; margin-top: 160px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 900px) {
  .picks { padding: 72px 0 56px; }
  .picks-board {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: calc(100% - 32px);
    gap: 28px;
  }
  .picks-copy { margin: 0; padding-top: 0; order: 1; }
  .picks-col { order: 2; align-items: flex-start; gap: 28px; }
  .picks-list { order: 3; text-align: left; align-self: start; }
  .picks-mark { order: 4; font-size: 64px; margin-top: 8px; }
  .picks-title { max-width: 100%; font-size: 34px; }
  .picks-list button { margin-left: 0; text-align: left; }
}
@media (max-width: 760px) {
  .hero { height: clamp(460px, 78vh, 640px); border-radius: 0; }
  .hero-overlay {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .hero-copy { max-width: none; width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-video { display: none; transition: none; }
  .hero.is-listening .hero-video {
    display: block;
    opacity: 0;
  }
}
</style>
<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const listen = document.getElementById('snd');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const still = hero.querySelector('.hero-still');
let stopped = false;
let listening = false;
let unavailable = false;
let suppressError = false;

function setVolume(value) {
  try { video.volume = value; } catch (err) { /* iOS keeps volume read-only */ }
}

function showStill() {
  hero.classList.add('is-still');
  hero.classList.remove('is-playing');
  if (stopped) return;
  stopped = true;
  suppressError = true;
  video.pause();
  video.removeAttribute('src');
  video.load();
}

function markUnavailable() {
  if (unavailable) return;
  unavailable = true;
  listening = false;
  hero.classList.remove('is-listening');
  video.muted = true;
  video.defaultMuted = true;
  video.setAttribute('muted', '');
  setVolume(0);
  listen.disabled = true;
  listen.setAttribute('aria-pressed', 'false');
  listen.textContent = '暂无声音';
  showStill();
}

function setAudible(on) {
  listening = on;
  hero.classList.toggle('is-listening', on);
  if (on) {
    video.muted = false;
    video.defaultMuted = false;
    video.removeAttribute('muted');
    setVolume(1);
    listen.setAttribute('aria-pressed', 'true');
    listen.textContent = '❚❚ 静音';
  } else {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    setVolume(0);
    listen.setAttribute('aria-pressed', 'false');
    if (!unavailable) listen.textContent = '▶ 聆听图景';
  }
}

function attachSource() {
  const src = video.dataset.src;
  if (!src) return false;
  suppressError = false;
  stopped = false;
  hero.classList.remove('is-still');
  video.playsInline = true;
  video.autoplay = true;
  video.loop = true;
  video.preload = 'auto';
  if (!listening) {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
  }
  if (video.getAttribute('src') !== src) video.src = src;
  return true;
}

function startVideo() {
  if (unavailable) return;
  if (motion.matches && !listening) { showStill(); return; }
  if (!attachSource()) { markUnavailable(); return; }
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (listening || unavailable) return;
    if (err && err.name === 'NotAllowedError') showStill();
    else if (video.error) markUnavailable();
  });
}

video.addEventListener('playing', () => {
  if (motion.matches || hero.classList.contains('is-still')) return;
  hero.classList.add('is-playing');
});
video.addEventListener('error', () => {
  if (suppressError || unavailable) return;
  markUnavailable();
});
if (still) still.addEventListener('error', () => { still.hidden = true; });
listen.addEventListener('click', () => {
  if (unavailable || listen.disabled) return;
  if (listening) {
    setAudible(false);
    if (motion.matches) showStill();
    return;
  }
  if (!attachSource()) { markUnavailable(); return; }
  // Unmute inside the click so the gesture unlocks this video's own audio track.
  setAudible(true);
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (unavailable) return;
    if (err && err.name === 'AbortError') return;
    setAudible(false);
    if (video.error) markUnavailable();
  });
});
if (motion.addEventListener) motion.addEventListener('change', () => {
  if (unavailable) return;
  if (motion.matches) {
    hero.classList.remove('is-playing');
    if (!listening) showStill();
    return;
  }
  startVideo();
});
startVideo();
</script>
<script>
const board = document.getElementById('picks');
if (board) {
  const buttons = [...board.querySelectorAll('.picks-list button')];
  const title = board.querySelector('.picks-title');
  const meta = board.querySelector('.picks-meta');
  const col = board.querySelector('.picks-col');
  const drop = (img) => img.addEventListener('error', () => img.remove(), { once: true });
  col.querySelectorAll('img').forEach(drop);
  const paint = (btn) => {
    if (btn.getAttribute('aria-current') === 'true') return;
    buttons.forEach((b) => b.removeAttribute('aria-current'));
    btn.setAttribute('aria-current', 'true');
    title.textContent = btn.dataset.title || '';
    title.href = btn.dataset.href || '/works/';
    meta.textContent = btn.dataset.meta || '';
    let frames = [];
    try { frames = JSON.parse(btn.dataset.frames || '[]'); } catch (err) { frames = []; }
    col.replaceChildren();
    frames.forEach((frame, i) => {
      const img = document.createElement('img');
      img.src = frame.src;
      img.alt = i === 0 ? (btn.dataset.title || '') : '';
      img.style.width = frame.width || '100%';
      img.style.aspectRatio = frame.ratio || '3 / 4';
      img.style.objectPosition = frame.focus || 'center';
      img.referrerPolicy = 'no-referrer';
      drop(img);
      col.append(img);
    });
  };
  buttons.forEach((btn) => {
    btn.addEventListener('mouseenter', () => paint(btn));
    btn.addEventListener('focus', () => paint(btn));
    btn.addEventListener('click', () => paint(btn));
  });
}
</script>
</Base>
