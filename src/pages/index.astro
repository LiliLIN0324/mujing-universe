<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const listen = document.getElementById('snd');
const listenLabel = listen.querySelector('.lb');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
// ≤768px: the painting player in scripts/mobile-hero.js owns the button and the video.
const mobileHeroMq = matchMedia('(max-width: 768px)');
const heroOnMobile = () => mobileHeroMq.matches;
let listening = false;

function setVolume(value) {
  try { video.volume = value; } catch (err) { /* iOS keeps volume read-only */ }
}

function failSilent() {
  listening = false;
  hero.classList.remove('is-listening');
  video.muted = true;
  video.defaultMuted = true;
  video.setAttribute('muted', '');
  setVolume(0);
  listen.disabled = false;
  listen.setAttribute('aria-pressed', 'false');
  listenLabel.textContent = '聆听图景';
}

function setAudible(on) {
  listening = on;
  hero.classList.toggle('is-listening', on);
  if (on) {
    video.muted = false;
    video.defaultMuted = false;
    video.removeAttribute('muted');
    setVolume(1);
    listen.setAttribute('aria-pressed', 'true');
    listenLabel.textContent = '静音';
  } else {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    setVolume(0);
    listen.setAttribute('aria-pressed', 'false');
    listenLabel.textContent = '聆听图景';
  }
}

function attachSource() {
  const src = video.dataset.src;
  if (!src) return false;
  video.playsInline = true;
  video.autoplay = true;
  video.loop = true;
  video.preload = 'auto';
  if (!listening) {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
  }
  if (video.getAttribute('src') !== src) video.src = src;
  return true;
}

function startVideo() {
  if (!attachSource()) { failSilent(); return; }
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (listening) return;
    if (err && err.name === 'NotAllowedError') return;
    if (video.error) failSilent();
  });
}

video.addEventListener('playing', () => {
  hero.classList.add('is-playing');
});
video.addEventListener('error', () => {
  if (heroOnMobile()) return;
  failSilent();
});
listen.addEventListener('click', () => {
  if (heroOnMobile()) return;
  if (listen.disabled) return;
  if (listening) {
    setAudible(false);
    return;
  }
  if (!attachSource()) { failSilent(); return; }
  setAudible(true);
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (err && err.name === 'AbortError') return;
    setAudible(false);
    if (video.error) failSilent();
  });
});
if (motion.addEventListener) motion.addEventListener('change', () => {
  if (heroOnMobile()) return;
  if (!motion.matches) startVideo();
});
if (!heroOnMobile()) {
  startVideo();
} else {
  const toDesktop = () => {
    if (heroOnMobile()) return;
    mobileHeroMq.removeEventListener?.('change', toDesktop);
    startVideo();
  };
  mobileHeroMq.addEventListener?.('change', toDesktop);
}
</script>
<script>
// Homepage auto-hide nav + SCROLL cue (layout only; no hero media logic here).
const nav = document.getElementById('home-nav');
const cue = document.getElementById('scroll-cue');
let hoverTop = false;
let scrollShown = false;
let lastY = window.scrollY;
function syncNav() {
  if (nav) nav.classList.toggle('is-shown', hoverTop || scrollShown);
}
window.addEventListener('mousemove', (e) => {
  const near = e.clientY <= (nav && nav.classList.contains('is-shown') ? 96 : 72);
  if (near !== hoverTop) { hoverTop = near; syncNav(); }
}, { passive: true });
document.documentElement.addEventListener('mouseleave', () => { hoverTop = false; syncNav(); });
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  const dy = y - lastY;
  if (y <= 4) scrollShown = false;
  else if (dy < -4) scrollShown = true;
  else if (dy > 4) scrollShown = false;
  if (Math.abs(dy) > 4 || y <= 4) lastY = y;
  syncNav();
  if (cue) cue.classList.toggle('is-gone', y > 40);
}, { passive: true });
if (cue) {
  cue.classList.toggle('is-gone', window.scrollY > 40);
  cue.addEventListener('click', (e) => {
    const target = document.getElementById('picks');
    if (!target) return;
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  });
}
</script>
<script>
import { mountPickRing } from '../scripts/pick-ring.js';
const picksRoot = document.getElementById('picks');
const pickDataEl = document.getElementById('pick-data');
// ≤768px: the WebGL ring is not initialised or rendered (mobile uses the card stack).
// If the viewport later grows past 768px, the ring mounts then, exactly as on desktop.
const mobileMq = matchMedia('(max-width: 768px)');
let ringMounted = false;
function mountRingIfDesktop() {
  if (ringMounted || mobileMq.matches || !picksRoot || !pickDataEl) return;
  ringMounted = true;
  mountPickRing(picksRoot, JSON.parse(pickDataEl.textContent || '[]'));
}
mountRingIfDesktop();
if (!ringMounted) {
  const onMq = () => {
    mountRingIfDesktop();
    if (ringMounted) mobileMq.removeEventListener?.('change', onMq);
  };
  mobileMq.addEventListener?.('change', onMq);
}
</script>
<script>
import { mountMobileHero } from '../scripts/mobile-hero.js';
import { mountMobileStack } from '../scripts/mobile-stack.js';
import { mountMobilePager } from '../scripts/mobile-pager.js';
const heroDwell = mountMobileHero();
const mobileStackRoot = document.getElementById('m-feat');
const stackDwell = mobileStackRoot ? mountMobileStack(mobileStackRoot) : null;
mountMobilePager([
  { el: document.getElementById('first-screen'), dwell: heroDwell },
  { el: document.getElementById('picks'), dwell: stackDwell },
  { el: document.getElementById('cta'), dwell: null },
]);
</script>
