---
import Base from '../layouts/Base.astro';
import { allWorks, pickIntro, workCovers, workFallback } from '../lib';
const ws = await allWorks();
const R2 = 'https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama';
// scroll.mp4 keeps its AAC track. Autoplay stays muted; 「聆听图景」 unmutes this same video.
const SCROLL_VIDEO = `${R2}/scroll.mp4`;
// 01.jpg matches the video frame (1920×760). still.jpg is a 52:1 panorama;
// object-fit:cover sliced its inscriptions into giant cropped glyphs.
const SCROLL_POSTER = `${R2}/01.jpg`;
const picks = ws.map((w) => ({
  slug: w.slug,
  title: w.title,
  year: w.yearNum || w.year,
  href: `/works/${w.slug}/`,
  intro: pickIntro(w),
  stills: workCovers(w),
  fallback: workFallback(w),
}));
const leadPick = picks[0];
const rearPick = leadPick.stills[1] ? leadPick : picks[1];
const rearStill = leadPick.stills[1] || rearPick.stills[0];
---
<Base active="/">
<section class="hero" id="scroll-hero" aria-label="当代西湖繁胜全景图">
  <img class="hero-still" src={SCROLL_POSTER} alt="当代西湖繁胜全景图" width="1920" height="760" referrerpolicy="no-referrer" fetchpriority="high"/>
  <video
    id="scroll-video"
    class="hero-video"
    poster={SCROLL_POSTER}
    muted
    autoplay
    playsinline
    loop
    preload="none"
    disablepictureinpicture
    referrerpolicy="no-referrer"
    data-src={SCROLL_VIDEO}
    aria-hidden="true"
  ></video>
  <div class="hero-overlay">
    <div class="hero-copy">
      <p class="kicker">古画新绘 · 进行中</p>
      <h1>当代西湖繁胜全景图</h1>
      <p class="sub">以宋画长卷重绘当代西湖，画面由声音转译生成</p>
      <button id="snd" class="btn solid sound" type="button" aria-pressed="false" aria-controls="scroll-video">▶ 聆听图景</button>
    </div>
    <a class="hero-more" href="/works/xihu-panorama/">查看作品</a>
  </div>
</section>

{leadPick && <section class="picks" id="picks" aria-label="精选">
  <div class="picks-layout">
    <div class="picks-left">
      <h2 class="picks-label">精选</h2>
      <p class="picks-intro" id="pick-intro">{leadPick.intro}</p>
      <div class="pick-stack" id="pick-stack">
        <button type="button" class="pick-card" data-slot="0" data-work="0" data-still="0" aria-label={leadPick.title} aria-current="true">
          <img class="pick-img" alt="" width="640" height="480" referrerpolicy="no-referrer" decoding="async" src={leadPick.stills[0]} />
        </button>
        <button type="button" class="pick-card" data-slot="1" data-work={leadPick.stills[1] ? '0' : '1'} data-still={leadPick.stills[1] ? '1' : '0'} aria-label={rearPick.title} aria-current="false">
          <img class="pick-img" alt="" width="640" height="480" referrerpolicy="no-referrer" decoding="async" src={rearStill} />
        </button>
      </div>
    </div>
    <ol class="pick-list">
      {picks.map((p, i) => (
        <li>
          <button type="button" class:list={['pick-row', { 'is-on': i === 0 }]} data-i={i} aria-current={i === 0 ? 'true' : undefined}>
            <span class="row-title">{p.title}</span>
            <span class="row-year">{p.year}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
  <script type="application/json" id="pick-data" set:html={JSON.stringify(picks).replace(/</g, '\\u003c')}></script>
</section>}

<section class="narrow cta">
  <h2>展览 · 委托 · 合作</h2>
  <p>文旅数字展陈、AIGC 音画委托、品牌合作与驻留，由经纪人统一对接。</p>
  <a class="btn solid" href="/contact/">合作</a>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  height: clamp(560px, 82vh, 920px);
  overflow: hidden;
  border-radius: 0;
  background: #141816;
}
.hero-still,
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-video {
  /* scroll.mp4 keeps its audio, but its frames carry burned-in captions
     (「132 艘」「篷、桅船」). Those cannot be removed with CSS, so the
     picture stays on 01.jpg and this element only plays sound. */
  opacity: 0;
  pointer-events: none;
}
.hero.is-still .hero-video { display: none; }
.hero::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: min(460px, 42vw);
  height: 46%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top, rgba(8, 10, 9, 0.22), rgba(8, 10, 9, 0));
}
.hero-overlay {
  position: absolute;
  left: clamp(24px, 4vw, 48px);
  right: clamp(24px, 4vw, 48px);
  bottom: clamp(24px, 4vw, 48px);
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  pointer-events: none;
}
.hero-copy,
.hero-more { pointer-events: auto; }
.hero-copy {
  max-width: min(420px, 46vw);
  text-align: left;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
}
.hero-copy .kicker {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.12em;
  opacity: 0.7;
}
.hero-copy h1 {
  margin: 0 0 8px;
  color: #fff;
  font-family: inherit;
  font-size: clamp(28px, 3.6vw, 44px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.hero-copy .sub {
  margin: 0;
  color: #fff;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  opacity: 0.75;
}
#snd.btn.solid {
  margin-top: 18px;
  background: #fff;
  color: #1A1A1C;
  border-color: #fff;
}
.hero-more {
  flex: none;
  color: #fff;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  text-decoration: none;
  opacity: 0.85;
  white-space: nowrap;
}
.hero-more:hover { opacity: 1; }
#snd.btn.solid:disabled,
#snd.btn.solid:disabled:hover {
  opacity: 0.45;
  cursor: not-allowed;
}
.picks {
  background: #F6F5F3;
  padding: clamp(80px, 12vh, 120px) clamp(24px, 4vw, 48px) clamp(64px, 8vh, 96px);
  color: #1A1A1C;
  font-family: "Alibaba PuHuiTi 3.0", "Noto Sans SC", system-ui, sans-serif;
}
.picks-layout {
  display: grid;
  grid-template-columns: min(380px, 32vw) minmax(0, 1fr);
  column-gap: clamp(28px, 3vw, 48px);
  align-items: start;
}
.picks-left { position: sticky; top: 88px; z-index: 1; }
.picks-label {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.picks-intro {
  width: min(380px, 32vw);
  margin: 0;
  color: #1A1A1C;
  font-family: inherit;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.65;
}
.pick-stack {
  position: relative;
  width: calc(min(320px, 28vw) + 56px);
  height: calc(min(320px, 28vw) * 3 / 4 + 32px);
  margin-top: 56px;
}
.pick-card {
  position: absolute;
  left: 0;
  top: 0;
  width: min(320px, 28vw);
  aspect-ratio: 4 / 3;
  height: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #E6E3DE;
  color: inherit;
  font: inherit;
  cursor: pointer;
  overflow: hidden;
  transform-origin: 50% 70%;
  transition: transform 0.65s cubic-bezier(.22, .61, .36, 1);
}
.pick-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0;
  display: block;
  pointer-events: none;
}
.pick-card[data-slot="0"] {
  z-index: 2;
  transform: translate3d(0, 0, 0) rotate(0deg);
  box-shadow: 0 14px 28px rgba(26, 26, 28, 0.12);
}
.pick-card[data-slot="1"] {
  z-index: 1;
  transform: translate3d(40px, 12px, 0) rotate(5deg);
  box-shadow: 0 8px 18px rgba(26, 26, 28, 0.08);
}
.pick-card:focus-visible,
.pick-row:focus-visible {
  outline: 1px solid #1A1A1C;
  outline-offset: 3px;
}
.pick-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid rgba(26, 26, 28, 0.1);
  font-family: inherit;
}
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
  width: 100%;
  height: 48px;
  padding: 0;
  border: 0;
  border-bottom: 1px solid rgba(26, 26, 28, 0.1);
  background: transparent;
  color: #1A1A1C;
  font-family: inherit;
  font-weight: 400;
  text-align: left;
  cursor: pointer;
}
.pick-row.is-on { font-weight: 600; }
.row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: inherit;
  line-height: 1.3;
}
.row-year {
  flex: none;
  color: #8A8A8A;
  font-size: 13px;
  font-weight: inherit;
  font-variant-numeric: tabular-nums;
}
.cta { text-align: center; margin-top: 160px; }
.cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; }
.cta p { color: var(--ink2); margin-bottom: 22px; }
@media (max-width: 860px) {
  .picks-layout { grid-template-columns: 1fr; row-gap: 36px; }
  .picks-left { position: static; }
  .picks-intro { width: min(380px, 100%); }
  .pick-card { width: min(320px, 78vw); }
  .pick-stack {
    width: calc(min(320px, 78vw) + 48px);
    height: calc(min(320px, 78vw) * 3 / 4 + 28px);
    margin-top: 36px;
  }
  .pick-card[data-slot="1"] { transform: translate3d(40px, 12px, 0) rotate(5deg); }
}
@media (max-width: 760px) {
  .hero { height: clamp(520px, 86vh, 720px); border-radius: 0; }
  .hero-overlay {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .hero-copy { max-width: none; width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-video { display: none; transition: none; }
  .hero.is-listening .hero-video {
    display: block;
    opacity: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .pick-card { transition: none; }
}
</style>
<script>
const hero = document.getElementById('scroll-hero');
const video = document.getElementById('scroll-video');
const listen = document.getElementById('snd');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const still = hero.querySelector('.hero-still');
let stopped = false;
let listening = false;
let unavailable = false;
let suppressError = false;

function setVolume(value) {
  try { video.volume = value; } catch (err) { /* iOS keeps volume read-only */ }
}

function showStill() {
  hero.classList.add('is-still');
  hero.classList.remove('is-playing');
  if (stopped) return;
  stopped = true;
  suppressError = true;
  video.pause();
  video.removeAttribute('src');
  video.load();
}

function markUnavailable() {
  if (unavailable) return;
  unavailable = true;
  listening = false;
  hero.classList.remove('is-listening');
  video.muted = true;
  video.defaultMuted = true;
  video.setAttribute('muted', '');
  setVolume(0);
  listen.disabled = true;
  listen.setAttribute('aria-pressed', 'false');
  listen.textContent = '暂无声音';
  showStill();
}

function setAudible(on) {
  listening = on;
  hero.classList.toggle('is-listening', on);
  if (on) {
    video.muted = false;
    video.defaultMuted = false;
    video.removeAttribute('muted');
    setVolume(1);
    listen.setAttribute('aria-pressed', 'true');
    listen.textContent = '❚❚ 静音';
  } else {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    setVolume(0);
    listen.setAttribute('aria-pressed', 'false');
    if (!unavailable) listen.textContent = '▶ 聆听图景';
  }
}

function attachSource() {
  const src = video.dataset.src;
  if (!src) return false;
  suppressError = false;
  stopped = false;
  hero.classList.remove('is-still');
  video.playsInline = true;
  video.autoplay = true;
  video.loop = true;
  video.preload = 'auto';
  if (!listening) {
    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
  }
  if (video.getAttribute('src') !== src) video.src = src;
  return true;
}

function startVideo() {
  if (unavailable) return;
  if (motion.matches && !listening) { showStill(); return; }
  if (!attachSource()) { markUnavailable(); return; }
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (listening || unavailable) return;
    if (err && err.name === 'NotAllowedError') showStill();
    else if (video.error) markUnavailable();
  });
}

video.addEventListener('playing', () => {
  if (motion.matches || hero.classList.contains('is-still')) return;
  hero.classList.add('is-playing');
});
video.addEventListener('error', () => {
  if (suppressError || unavailable) return;
  markUnavailable();
});
if (still) still.addEventListener('error', () => { still.hidden = true; });
listen.addEventListener('click', () => {
  if (unavailable || listen.disabled) return;
  if (listening) {
    setAudible(false);
    if (motion.matches) showStill();
    return;
  }
  if (!attachSource()) { markUnavailable(); return; }
  // Unmute inside the click so the gesture unlocks this video's own audio track.
  setAudible(true);
  const attempt = video.play();
  if (attempt) attempt.catch((err) => {
    if (unavailable) return;
    if (err && err.name === 'AbortError') return;
    setAudible(false);
    if (video.error) markUnavailable();
  });
});
if (motion.addEventListener) motion.addEventListener('change', () => {
  if (unavailable) return;
  if (motion.matches) {
    hero.classList.remove('is-playing');
    if (!listening) showStill();
    return;
  }
  startVideo();
});
startVideo();
</script>
<script>
const picksRoot = document.getElementById('picks');
const pickDataEl = document.getElementById('pick-data');
if (picksRoot && pickDataEl) {
  const pickData = JSON.parse(pickDataEl.textContent || '[]');
  const stack = document.getElementById('pick-stack');
  const introEl = document.getElementById('pick-intro');
  const cards = [...picksRoot.querySelectorAll('.pick-card')];
  const rows = [...picksRoot.querySelectorAll('.pick-row')];
  const pickMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let workIndex = 0;
  let stillIndex = 0;
  let flip = 0;
  let timer = 0;
  let onscreen = true;
  let holds = 0;

  function paint(card, slot, src, work, still) {
    card.dataset.slot = slot;
    card.dataset.work = String(work);
    card.dataset.still = String(still);
    card.setAttribute('aria-current', slot === '0' ? 'true' : 'false');
    card.setAttribute('aria-label', pickData[work].title);
    const img = card.querySelector('img');
    if (!img) return;
    img.dataset.fallback = pickData[work].fallback || '';
    if (img.getAttribute('src') !== src) {
      img.style.visibility = '';
      img.src = src;
    }
  }

  function failImage(img) {
    const next = img.dataset.fallback;
    if (next && img.getAttribute('src') !== next) {
      img.dataset.fallback = '';
      img.src = next;
      return;
    }
    img.style.visibility = 'hidden';
  }

  picksRoot.querySelectorAll('.pick-img').forEach((img) => {
    img.addEventListener('error', () => failImage(img));
    if (img.complete && img.getAttribute('src') && img.naturalWidth === 0) failImage(img);
  });

  function render() {
    const work = pickData[workIndex];
    const stills = work.stills.length ? work.stills : [];
    const frontStill = stills.length ? stillIndex % stills.length : 0;
    const frontSrc = stills[frontStill];
    let rearWork = workIndex;
    let rearStill = stills.length > 1 ? (frontStill + 1) % stills.length : 0;
    let rearSrc = stills[rearStill];
    if (stills.length < 2 && pickData.length > 1) {
      rearWork = (workIndex + 1) % pickData.length;
      rearStill = 0;
      rearSrc = pickData[rearWork].stills[0];
    }
    const order = flip % 2 ? [cards[1], cards[0]] : [cards[0], cards[1]];
    paint(order[0], '0', frontSrc, workIndex, frontStill);
    paint(order[1], '1', rearSrc, rearWork, rearStill);
    if (introEl) introEl.textContent = work.intro;
    rows.forEach((row, i) => {
      const on = i === workIndex;
      row.classList.toggle('is-on', on);
      if (on) row.setAttribute('aria-current', 'true');
      else row.removeAttribute('aria-current');
    });
  }

  function arm() {
    window.clearInterval(timer);
    timer = 0;
    const stills = pickData[workIndex] ? pickData[workIndex].stills : [];
    const paused = holds > 0 || !onscreen || document.hidden || pickMotion.matches || stills.length < 2;
    if (paused) return;
    timer = window.setInterval(() => {
      stillIndex = (stillIndex + 1) % pickData[workIndex].stills.length;
      flip += 1;
      render();
    }, 4200);
  }

  function hold(delta) {
    holds = Math.max(0, holds + delta);
    arm();
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const nextWork = Number(card.dataset.work);
      const nextStill = Number(card.dataset.still);
      if (nextWork === workIndex && nextStill === stillIndex) return;
      workIndex = nextWork;
      stillIndex = nextStill;
      flip += 1;
      render();
      arm();
    });
  });
  rows.forEach((row) => {
    row.addEventListener('click', () => {
      const next = Number(row.dataset.i);
      if (next === workIndex) return;
      workIndex = next;
      stillIndex = 0;
      flip += 1;
      render();
      arm();
    });
  });

  [stack, picksRoot.querySelector('.pick-list')].forEach((el) => {
    if (!el) return;
    el.addEventListener('pointerenter', () => hold(1));
    el.addEventListener('pointerleave', () => hold(-1));
    el.addEventListener('focusin', () => hold(1));
    el.addEventListener('focusout', (event) => {
      if (el.contains(event.relatedTarget)) return;
      hold(-1);
    });
  });

  const watch = new IntersectionObserver((entries) => {
    onscreen = entries.some((entry) => entry.isIntersecting);
    arm();
  }, { threshold: 0.2 });
  if (stack) watch.observe(stack);
  document.addEventListener('visibilitychange', arm);
  if (pickMotion.addEventListener) pickMotion.addEventListener('change', arm);
  render();
  arm();
}
</script>
</Base>
