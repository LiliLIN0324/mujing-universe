---
import Base from '../layouts/Base.astro';
import raw from '../data/news.json';
import {
  WHENS,
  classify,
  dateLabelShort,
  galleryOf,
  isSection,
  sortNews,
  todayISO,
  type NewsItem,
} from '../lib/news';

const today = todayISO();
const items = sortNews(
  raw.items.map((item) => {
    if (!isSection(item.section)) throw new Error(`新闻条目 ${item.id} 的板块无效`);
    return item as NewsItem;
  }),
);

/** 按年分组。items 已按时间倒序，相邻同年归一组。 */
const groups: { year: string; items: NewsItem[] }[] = [];
for (const item of items) {
  const year = item.start ? item.start.slice(0, 4) : '日期待定';
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(item);
  else groups.push({ year, items: [item] });
}

function timeAttr(item: NewsItem) {
  if (!item.start) return undefined;
  if (item.precision === 'year') return item.start.slice(0, 4);
  if (item.precision === 'month') return item.start.slice(0, 7);
  return item.start;
}

/** 英文题名并进中文一句话：跟在书名号（或「」）后；没有就补在句末括号里。 */
function mergeOriginal(summary: string, original?: string) {
  if (!original) return summary;
  if (summary.includes('》')) return summary.replace('》', `》（${original}）`);
  if (summary.includes('」')) return summary.replace('」', `」（${original}）`);
  if (summary.endsWith('。')) return summary.replace(/。$/, `（${original}）。`);
  return `${summary}（${original}）`;
}

/** 展开里有没有东西可看。 */
function hasDetail(item: NewsItem) {
  return Boolean(galleryOf(item).length || item.original || item.href || item.summary);
}
---
<Base
  title="新闻 · 幕景宇宙"
  description="幕景宇宙新闻。"
  active="/news/"
>
<main class="news-page">
  <section class="stage" id="list" aria-label="新闻列表">
    <div class="news-in">
      <h1 class="sr">新闻</h1>
      <div class="bar">
        <div class="whens" role="group" aria-label="按时间筛选">
          {WHENS.map((item) => (
            <a href={item.id === 'all' ? '/news/' : `/news/?when=${item.id}`} data-when-link={item.id} class={item.id === 'all' ? 'on' : undefined} aria-current={item.id === 'all' ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </div>
      <p class="sr" id="news-status" aria-live="polite">全部时间，{items.length} 条</p>
      <div class="timeline">
        {groups.map((group) => (
          <section class="epoch">
            <h2 class="year">{group.year}</h2>
            <ol class="news-list">
              {group.items.map((item) => {
                const openable = hasDetail(item);
                const detailId = `d-${item.id}`;
                const gallery = galleryOf(item);
                const cover = item.image || gallery[0];
                const many = gallery.length > 1;
                return (
                  <li
                    id={item.id}
                    data-start={item.start || undefined}
                    data-end={item.end || undefined}
                    data-open={item.open ? '1' : undefined}
                  >
                    <div class="line">
                      {openable ? (
                        <button class="hit" type="button" aria-expanded="false" aria-controls={detailId}>
                          <time class="date" datetime={timeAttr(item)}>{dateLabelShort(item)}</time>
                          <span class="copy">
                            <span class="title">{item.title}<i class="plus" aria-hidden="true"></i></span>
                          </span>
                        </button>
                      ) : (
                        <div class="hit">
                          <time class="date" datetime={timeAttr(item)}>{dateLabelShort(item)}</time>
                          <span class="copy">
                            <span class="title">{item.title}</span>
                          </span>
                        </div>
                      )}
                      {cover && (
                        <button class="cover" type="button" aria-label={many ? `放大封面，共 ${gallery.length} 张` : '放大封面'} data-images={many ? JSON.stringify(gallery) : undefined}>
                          <img src={cover} alt="" width="240" height="180" loading="lazy" decoding="async" />
                        </button>
                      )}
                    </div>
                    {openable && (
                      <div class="detail" id={detailId} hidden>
                        <div class="detail-grid">
                          <span></span>
                          <div class="detail-body">
                            {many && (
                              <figure class="shots" data-images={JSON.stringify(gallery)}>
                                <button class="shot" type="button" aria-label="放大图片">
                                  <img src={gallery[0]} alt="" />
                                </button>
                                <div class="shot-nav">
                                  <button class="shot-prev" type="button" aria-label="上一张">上一张</button>
                                  <span class="shot-count" aria-live="polite">1 / {gallery.length}</span>
                                  <button class="shot-next" type="button" aria-label="下一张">下一张</button>
                                </div>
                              </figure>
                            )}
                            {item.summary ? <p class="summary">{mergeOriginal(item.summary, item.original)}</p> : item.original && <p class="original" lang="en">{item.original}</p>}
                            {item.href && (
                              <p class="more">
                                {item.href.startsWith('http') ? (
                                  <a href={item.href} target="_blank" rel="noopener noreferrer">{item.hrefLabel || '查看'}</a>
                                ) : (
                                  <a href={item.href}>{item.hrefLabel || '查看'}</a>
                                )}
                              </p>
                            )}
                          </div>
                        </div>
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
      <p class="empty" id="news-empty" hidden>没有条目。</p>
    </div>
  </section>
  <div class="light" id="news-light" hidden>
    <button class="light-x" type="button">关闭</button>
    <img alt="" />
    <div class="light-nav" hidden>
      <button class="light-prev" type="button">上一张</button>
      <p class="light-count" aria-live="polite"></p>
      <button class="light-next" type="button">下一张</button>
    </div>
  </div>
</main>

<style>
.news-page {
  --paper-ink: var(--ink);
  --paper-dim: var(--muted);
  --paper-rule: var(--rule);
}
.news-in { width: min(var(--measure), calc(100% - 2 * var(--gutter))); margin-inline: auto; }
.stage {
  background: var(--bg);
  color: var(--paper-ink);
  min-height: calc(100svh - 80px);
  padding: 48px 0 88px;
}
.news-page h1 {
  margin: 0 0 22px;
  color: var(--paper-ink);
  font-weight: 600;
  font-size: clamp(40px, 5vw, 56px);
  line-height: 1;
  letter-spacing: -0.04em;
}
.bar {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--paper-rule);
}
.whens { display: flex; align-items: baseline; gap: 28px; }
.whens a {
  color: var(--paper-dim);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  padding: 0 0 8px;
  white-space: nowrap;
}
.whens a { font-size: 13px; letter-spacing: 0.18em; }
.whens a.on { color: var(--paper-ink); border-bottom-color: var(--paper-ink); }
.whens a:hover { color: var(--paper-ink); }
.stage a:focus-visible,
.stage button:focus-visible { outline: 2px solid var(--paper-ink); outline-offset: 3px; }

.sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* 幽灵年份 + 左侧时间轴 */
.epoch {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  column-gap: 32px;
}
.year {
  margin: 0;
  padding-top: 20px;
  font-size: 56px;
  font-weight: 200;
  line-height: 0.9;
  letter-spacing: -0.02em;
  color: var(--paper-ink);
  opacity: 0.14;
  font-variant-numeric: tabular-nums;
  position: sticky;
  top: 96px;
  align-self: start;
}
.news-list { position: relative; list-style: none; margin: 0; padding: 0 0 0 26px; }
.news-list::before {
  content: "";
  position: absolute;
  left: 4px;
  top: 14px;
  bottom: 14px;
  width: 1px;
  background: var(--paper-rule);
}
.news-list > li { position: relative; }
.news-list > li::before {
  content: "";
  position: absolute;
  left: -28px;
  top: 40px;
  width: 13px;
  height: 1px;
  background: var(--ink2);
}
.news-list > li:has(.hit[aria-expanded="true"])::before,
.news-list > li:has(.hit:hover)::before {
  background: var(--paper-ink);
}
.line { position: relative; border-bottom: 1px solid var(--paper-rule); }
.hit, .detail-grid {
  display: grid;
  grid-template-columns: 110px minmax(0, 1fr);
  column-gap: 24px;
}
.hit { align-items: center; width: 100%; }
.detail-grid { align-items: start; }
.copy { min-width: 0; }
/* 封面实际占位 120px + right 28px = 148px，预留 164px 留出呼吸间隙，标题不得压图 */
.line:has(.cover) .copy { padding-right: 164px; }
.cover {
  position: absolute;
  z-index: 1;
  right: 28px;
  top: 50%;
  transform: translateY(-50%);
  width: 120px;
  aspect-ratio: 4 / 3;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  overflow: hidden;
  background: none;
  cursor: zoom-in;
}
.cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  border-radius: 0;
}
.hit {
  margin: 0;
  padding: 26px 0;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  text-align: left;
}
button.hit { cursor: pointer; }
.date {
  font-size: 12px;
  line-height: 1.5;
  letter-spacing: 0.08em;
  color: var(--paper-dim);
  font-variant-numeric: tabular-nums;
}
.title {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.03em;
  color: var(--paper-ink);
}
.plus {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-left: 10px;
  position: relative;
  vertical-align: 1px;
  color: var(--ink2);
}
.plus::before, .plus::after {
  content: "";
  position: absolute;
  background: currentColor;
}
.plus::before { left: 4px; top: 0; width: 1px; height: 9px; }
.plus::after { left: 0; top: 4px; width: 9px; height: 1px; }
.hit[aria-expanded="true"] .plus::before { opacity: 0; }
.hit:hover .title { color: var(--paper-ink); }
li:has(.hit[aria-expanded="true"]) .line { border-bottom-color: transparent; }
li:has(.hit[aria-expanded="true"]) .hit { padding-bottom: 10px; }
li:has(.hit[aria-expanded="true"]) .cover { top: 26px; transform: none; }
li:has(.hit[aria-expanded="true"]) .detail-body { padding-right: 164px; }
.detail[hidden] { display: none; }
.detail-grid { padding-bottom: 22px; border-bottom: 1px solid var(--paper-rule); }
.light {
  position: fixed;
  inset: 0;
  z-index: 240;
  display: grid;
  place-items: center;
  padding: 72px 24px 32px;
  background: #fff;
}
.light[hidden] { display: none; }
.light img {
  max-width: min(920px, 100%);
  max-height: calc(100dvh - 120px);
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 0;
}
.light.has-many { padding-bottom: 72px; }
.light.has-many img { max-height: calc(100dvh - 168px); }
.light-nav {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  justify-content: center;
}
.light-nav[hidden] { display: none; }
.light button:focus-visible { outline: 2px solid var(--paper-ink); outline-offset: 3px; }
.light-x {
  position: absolute;
  top: 22px;
  right: 28px;
  border: 0;
  background: none;
  color: var(--paper-ink);
  font: inherit;
  font-size: 13px;
  letter-spacing: 0.14em;
  cursor: pointer;
}
.shots { margin: 2px 0 16px; max-width: 480px; }
.shot {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: none;
  cursor: zoom-in;
}
.shot img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 320px;
  object-fit: contain;
  object-position: center;
}
.shot-nav, .light-nav {
  display: flex;
  align-items: center;
  gap: 22px;
}
.shot-nav { margin-top: 8px; }
.shot-prev, .shot-next, .light-prev, .light-next {
  border: 0;
  background: none;
  padding: 0;
  color: var(--paper-ink);
  font: inherit;
  font-size: 13px;
  letter-spacing: 0.14em;
  cursor: pointer;
}
.shot-count, .light-count {
  margin: 0;
  font-size: 13px;
  letter-spacing: 0.08em;
  color: var(--paper-dim);
  font-variant-numeric: tabular-nums;
}
.detail-body p { margin: 0 0 8px; max-width: 40em; font-size: 14px; line-height: 1.7; color: var(--ink-soft); }
.detail-body .original { font-family: var(--en), var(--sans); font-size: 13px; color: var(--paper-dim); }
.detail-body a { color: var(--paper-ink); text-underline-offset: 3px; }
.empty { margin: 36px 0 0; color: var(--paper-dim); font-size: 15px; }
.news-list > li[hidden] { display: none; }
.epoch[hidden] { display: none; }
:global(footer.bot) { margin-top: 0; padding-top: 48px; }

@media (max-width: 800px) {
  .news-in { width: calc(100% - 2 * var(--gutter)); }
  .stage { min-height: calc(100svh - 52px); padding: 28px 0 72px; }
  .news-page h1 { font-size: 32px; margin-bottom: 22px; }
  .epoch { grid-template-columns: 1fr; column-gap: 0; }
  .year {
    padding: 26px 0 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--paper-dim);
    opacity: 1;
    position: static;
  }
  .news-list { padding-left: 20px; }
  .news-list::before { top: 8px; bottom: 8px; }
  .news-list > li::before { left: -22px; top: 30px; }
  .hit, .detail-grid {
    grid-template-columns: 1fr auto;
    row-gap: 2px;
  }
  .hit { padding: 20px 0; align-items: start; }
  .date { grid-column: 1; grid-row: 1; }
  .copy { grid-column: 1 / -1; grid-row: 2; }
  .line:has(.cover) .copy { padding-right: 100px; }
  .cover { width: 88px; right: 0; top: auto; bottom: 22px; transform: none; }
  li:has(.hit[aria-expanded="true"]) .cover { top: 20px; bottom: auto; }
  li:has(.hit[aria-expanded="true"]) .detail-body { padding-right: 100px; }
  .title { font-size: 18px; }
  .detail-grid > span { display: none; }
  .detail-body { grid-column: 1 / -1; }
}
</style>

<script>
  import { classify, todayISO } from '../lib/news';

  const page = document.querySelector('.news-page');
  if (page) {
    const light = page.querySelector<HTMLElement>('#news-light');
    const lightImg = light?.querySelector('img');
    const lightX = light?.querySelector<HTMLButtonElement>('.light-x');
    const lightNav = light?.querySelector<HTMLElement>('.light-nav');
    const lightCount = light?.querySelector<HTMLElement>('.light-count');
    const lightPrev = light?.querySelector<HTMLButtonElement>('.light-prev');
    const lightNext = light?.querySelector<HTMLButtonElement>('.light-next');
    let lightOpener: HTMLElement | null = null;
    let gallery: string[] = [];
    let index = 0;
    const parseImages = (raw: string | undefined): string[] => {
      if (!raw) return [];
      try {
        const value = JSON.parse(raw);
        if (!Array.isArray(value)) return [];
        return value.filter((item): item is string => typeof item === 'string' && item.length > 0);
      } catch {
        return [];
      }
    };
    const renderLight = () => {
      if (!light || !lightImg || !gallery.length) return;
      lightImg.src = gallery[index];
      const multi = gallery.length > 1;
      light.classList.toggle('has-many', multi);
      if (lightNav) lightNav.hidden = !multi;
      if (lightCount) lightCount.textContent = `${index + 1} / ${gallery.length}`;
    };
    const stepLight = (delta: number) => {
      if (gallery.length < 2) return;
      index = (index + delta + gallery.length) % gallery.length;
      renderLight();
    };
    const closeLight = () => {
      if (!light || light.hidden) return;
      light.hidden = true;
      light.classList.remove('has-many');
      if (lightNav) lightNav.hidden = true;
      lightImg?.removeAttribute('src');
      gallery = [];
      document.body.style.overflow = '';
      lightOpener?.focus();
      lightOpener = null;
    };
    const openLight = (srcs: string[], start: number, opener: HTMLElement) => {
      if (!light || !lightImg || !srcs.length) return;
      gallery = srcs;
      index = ((start % srcs.length) + srcs.length) % srcs.length;
      renderLight();
      light.hidden = false;
      document.body.style.overflow = 'hidden';
      lightOpener = opener;
      lightX?.focus();
    };
    page.querySelectorAll<HTMLImageElement>('.cover img').forEach((img) => {
      const fail = () => img.closest('.cover')?.remove();
      if (img.complete && img.naturalWidth === 0) fail();
      else img.addEventListener('error', fail);
    });
    page.querySelectorAll<HTMLButtonElement>('.cover').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const many = parseImages(btn.dataset.images);
        const img = btn.querySelector('img');
        const src = img?.currentSrc || img?.getAttribute('src') || '';
        const srcs = many.length ? many : (src ? [src] : []);
        if (srcs.length) openLight(srcs, 0, btn);
      });
    });
    page.querySelectorAll<HTMLElement>('.shots').forEach((fig) => {
      const srcs = parseImages(fig.dataset.images);
      const img = fig.querySelector('img');
      const count = fig.querySelector<HTMLElement>('.shot-count');
      const shot = fig.querySelector<HTMLButtonElement>('.shot');
      if (srcs.length < 2 || !img || !shot) return;
      let at = 0;
      const render = () => {
        img.src = srcs[at];
        if (count) count.textContent = `${at + 1} / ${srcs.length}`;
      };
      const step = (delta: number) => {
        at = (at + delta + srcs.length) % srcs.length;
        render();
      };
      fig.querySelector<HTMLButtonElement>('.shot-prev')?.addEventListener('click', () => step(-1));
      fig.querySelector<HTMLButtonElement>('.shot-next')?.addEventListener('click', () => step(1));
      shot.addEventListener('click', () => openLight(srcs, at, shot));
      fig.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        step(event.key === 'ArrowLeft' ? -1 : 1);
      });
    });
    lightPrev?.addEventListener('click', () => stepLight(-1));
    lightNext?.addEventListener('click', () => stepLight(1));
    lightX?.addEventListener('click', closeLight);
    light?.addEventListener('click', (event) => {
      if (event.target === light) closeLight();
    });
    document.addEventListener('keydown', (event) => {
      if (!light || light.hidden) return;
      if (event.key === 'Escape') closeLight();
      else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        stepLight(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        stepLight(1);
      }
    });
    const rows = [...page.querySelectorAll<HTMLLIElement>('.news-list > li')];
    const epochs = [...page.querySelectorAll<HTMLElement>('.epoch')];
    const whenLinks = [...page.querySelectorAll<HTMLAnchorElement>('[data-when-link]')];
    const hits = [...page.querySelectorAll<HTMLButtonElement>('.hit')];
    const status = page.querySelector<HTMLElement>('#news-status');
    const empty = page.querySelector<HTMLElement>('#news-empty');
    const whens = new Set(['all', 'now', 'future', 'past']);
    const whenLabel: Record<string, string> = {
      all: '全部时间',
      now: '现在',
      future: '即将',
      past: '往期',
    };

    const params = new URLSearchParams(location.search);
    let when = params.get('when') || 'all';
    if (!whens.has(when)) when = 'all';

    const hrefFor = (nextWhen: string) => {
      return nextWhen === 'all' ? '/news/' : `/news/?when=${nextWhen}`;
    };
    const write = () => history.replaceState(null, '', hrefFor(when));
    const mark = (link: HTMLAnchorElement, on: boolean) => {
      link.classList.toggle('on', on);
      if (on) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    };
    const bucketOf = (row: HTMLLIElement) => classify(
      { start: row.dataset.start || '', end: row.dataset.end || '', open: row.dataset.open === '1' },
      todayISO(),
    );
    const matches = (row: HTMLLIElement, nextWhen: string) => {
      return nextWhen === 'all' || bucketOf(row) === nextWhen;
    };
    const closeDetails = () => {
      page.querySelectorAll<HTMLElement>('.detail').forEach((panel) => { panel.hidden = true; });
      hits.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
    };

    const apply = () => {
      closeLight();
      closeDetails();
      let count = 0;
      rows.forEach((row) => {
        const show = matches(row, when);
        row.hidden = !show;
        if (show) count += 1;
      });
      epochs.forEach((epoch) => {
        const visible = [...epoch.querySelectorAll<HTMLLIElement>('li')].some((li) => !li.hidden);
        epoch.hidden = !visible;
      });
      whenLinks.forEach((link) => {
        const id = link.dataset.whenLink || 'all';
        mark(link, id === when);
        link.href = hrefFor(id);
      });
      if (status) status.textContent = `${whenLabel[when]}，${count} 条`;
      if (empty) {
        empty.hidden = count !== 0;
        empty.textContent = when === 'future' ? '没有即将到来的。' : when === 'now' ? '没有进行中的。' : '没有条目。';
      }
    };

    whenLinks.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      when = link.dataset.whenLink || 'all';
      write();
      apply();
    }));
    hits.forEach((btn) => btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      const willOpen = btn.getAttribute('aria-expanded') !== 'true';
      closeDetails();
      if (willOpen && panel) {
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
      }
    }));

    apply();
  }
</script>
</Base>
