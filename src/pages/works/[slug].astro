---
import Base from '../../layouts/Base.astro';
import Cooperate from '../../components/Cooperate.astro';
import DemoEmbed from '../../components/DemoEmbed.astro';
import { allWorks, coverClip, pickBody, pickTech, workAudio, workFallback, workPaper, workHero, workStills, workStrip, workSubtitle } from '../../lib';
export async function getStaticPaths() {
  const ws = await allWorks();
  // 下一件 follows the catalogue order; the last wraps to the first.
  return ws.map((w, i) => ({ params: { slug: w.slug }, props: { w, next: ws[i + 1] || ws[0] } }));
}
const { w, next } = Astro.props;
/* ≤768px page-by-page: per-page "dwell" switch ('on' = vertical swipes first walk the
   page's own content — the full-scroll strip on page 2 — then flip; 'off' = flip at once).
   Which pages dwell is TBD: all off. */
const PAGE_DWELL: Record<'intro' | 'scroll' | 'next', 'on' | 'off'> = { intro: 'off', scroll: 'off', next: 'off' };

const hero = workHero(w);
const paper = workPaper(w);
const fallback = workFallback(w);
const stills = workStills(w);
const strip = workStrip(w);
const audio = workAudio(w);
const clip = coverClip(w.slug);
const clipIsAudio = !!(clip && audio && clip === audio);
const sub = workSubtitle(w);
const oneLiner = (() => {
  const d = (w.description || '').replace(/（占位[^）]*）/g, '').trim();
  if (!d) return '';
  return d.endsWith('。') || d.length < 40 ? d : d.split('。')[0] + '。';
})();
const intro = pickBody(w);
const tech = pickTech(w);
const year = w.yearNum ? String(w.yearNum) : w.year;
const abstract = w.abstract && w.abstract !== w.description ? w.abstract : '';
// 角色: the works data has no role field, so it stays empty (hidden) until a real source exists.
const role = '';
const facts = [['分类', w.line], ['角色', role], ['技术', tech.join(' · ')], ['年份', year], ['状态', w.status]].filter(([, v]) => v);
const pad = (n: number) => String(n).padStart(2, '0');
const nextMeta = [next.line, next.yearNum || next.year].filter(Boolean).join(' · ');
const backHref = `/works/?line=${encodeURIComponent(w.line)}#archive`;
const backText = '← 作品';
const backNote = w.line;
// Demo 只认 demo 里的真实网址。报道只认 link。个人站 source 不当体验入口。
const httpUrl = (value?: string) => {
  const url = (value || '').trim();
  return /^https?:\/\//i.test(url) ? url : '';
};
const demoHref = httpUrl(w.demo);
const repoHref = httpUrl(w.repo);
const newsHref = httpUrl(w.link);
/* 西湖清趣：官网只留一条进壳入口（进度5 收口），壳在 /works/xihu-panorama/shell/ */
const XIHU_SHELL = w.slug === 'xihu-panorama';
---
<Base title={`${w.title} · 幕景宇宙`} description={intro ? intro.slice(0, 140) : undefined} active="/works/" home navClass="top--work">
<div class="wd">
  <section class="wd-page wd-p1" data-dwell={PAGE_DWELL.intro}>
    <figure class:list={['wd-hero', clip && 'has-motion']} style={paper ? `--wd-paper:${paper}` : undefined}>
      <div class="wd-frame">
        <img src={hero} data-fallback={fallback} alt={w.title} referrerpolicy="no-referrer" fetchpriority="high"/>
        {clip && <video class="wd-motion" id={clipIsAudio ? 'wd-audio' : undefined} data-src={clip} data-audio={clipIsAudio ? '1' : undefined} muted loop playsinline webkit-playsinline preload="none" disablepictureinpicture aria-hidden="true"></video>}
      </div>
      {(clip || audio) && <div class="wd-media-btns">
        {audio && <button class="wd-icon-btn" id="wd-listen" type="button" aria-pressed="false" aria-label="聆听图景" title="聆听图景">
          <svg class="i-mute" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15.5 9.7l4.6 4.6m0-4.6l-4.6 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg>
          <svg class="i-snd" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"/><path d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.6a8 8 0 0 1 0 10.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/></svg>
        </button>}
        {clip && <button class="wd-icon-btn" id="wd-hero-play" type="button" aria-pressed="false" aria-label="播放" title="播放">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" fill="currentColor"/></svg>
        </button>}
      </div>}
      <figcaption class="wd-cap" aria-hidden="true">{clip ? (w.slug === 'xihu-panorama' ? '长卷 · 画面' : '画面') : (w.slug === 'xihu-panorama' ? '长卷 · 静帧 01' : '静帧 01')}</figcaption>
    </figure>
    <div class="wd-wrap">
      <div class="wd-head">
        <div>
          <h1>{w.title}</h1>
          {(sub || oneLiner) && <p class="wd-sub">{sub || oneLiner}</p>}
        </div>
      </div>
      <div class="wd-body">
        <div class="wd-text">
          {intro && <p class="wd-intro">{intro}</p>}
          {abstract && <p class="wd-more">{abstract}</p>}
          {w.note && <p class="wd-more">{w.note}</p>}
          {(demoHref || repoHref || newsHref) && <div class="wd-links">
            {demoHref && <p class="wd-more wd-link-demo"><a href={demoHref} target="_blank" rel="noopener noreferrer">打开 Demo ↗</a></p>}
            {repoHref && <p class="wd-more">模板已经开源，代码和使用说明放在 <a href={repoHref} target="_blank" rel="noopener noreferrer">GitHub ↗</a>。</p>}
            {newsHref && <p class="wd-more"><a href={newsHref} target="_blank" rel="noopener noreferrer">相关报道 ↗</a></p>}
          </div>}
        </div>
        {facts.length > 0 && <dl class="wd-facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      </div>
    </div>
  </section>

  {demoHref && <section class="wd-page wd-demo" id="demo" aria-labelledby="demo-h" data-dwell={PAGE_DWELL.scroll}>
    <div class="wd-wrap">
      <div class="wd-sec"><b>体验</b><span class="d">网页端实时运行</span><span class="m">在页内试用</span></div>
      <h2 class="wd-demo-h" id="demo-h">直接打开看看</h2>
    </div>
    <div class="wd-demo-stage"><DemoEmbed url={demoHref} title={w.title} cover={hero} /></div>
  </section>}

  {XIHU_SHELL && <>
    <section class="wd-page wd-narr">
      <div class="wd-wrap">
        <div class="wd-sec"><b>缘起</b></div>
        <p class="wn-lead">一幅三百年前的西湖长卷，如果活过来，会是什么样子？</p>
        <p class="wn-text">《西湖清趣图》自钱塘门起，环湖一周，回钱塘门止——舟船、桥亭、园囿、寺观，一一在卷。我们想做的，是让这卷画重新呼吸：柳丝因风而动，船桨因水而鸣，雪落无声，钟声悠远。画仍是那幅画，只是时间重新开始流动。</p>
      </div>
    </section>

    <section class="wd-page wd-narr">
      <div class="wd-wrap">
        <div class="wd-sec"><b>音画</b><span class="d">声画相和</span></div>
        <p class="wn-text">原画一笔不动，只在画中「雕刻」动态——柳丝轻摆、船行水上、雨雪飘落，每一处的动，都与乐声相和。画即乐谱：画卷经过之处，就是音符响起之时。</p>
        <div class="wn-stage"><iframe src="/works/xihu-panorama/lakeside/index.html" loading="lazy" title="南宋复原 · 2.5D 湖山清远"></iframe></div>
        <p class="wn-note">2.5D 复原 · 可拖拽、缩放、点地名</p>

        <p class="wn-text" style="margin-top:32px">以下为二百九十秒成片的四个片段——风、雨、暖、雪，各取一息。</p>

        <div class="wn-clips">
          <div class="wn-clip">
            <video controls preload="none" playsinline poster="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/frame-trigger.jpg">
              <source src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/v_trigger.mp4" type="video/mp4"/>
            </video>
            <p class="wn-clip-label">风柳 · 柳丝因风而动，船只经过触发线，声随画起</p>
          </div>
          <div class="wn-clip">
            <video controls preload="none" playsinline poster="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/frame-rain.jpg">
              <source src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/v_rain.mp4" type="video/mp4"/>
            </video>
            <p class="wn-clip-label">雨 · 雨丝渐起，湖山压暗，雨声藏在乐声之下</p>
          </div>
          <div class="wn-clip">
            <video controls preload="none" playsinline poster="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/frame-climax.jpg">
              <source src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/v_climax.mp4" type="video/mp4"/>
            </video>
            <p class="wn-clip-label">暖 · 城楼暖光大盛，全卷至此处最为明亮</p>
          </div>
          <div class="wn-clip">
            <video controls preload="none" playsinline poster="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/frame-snow.jpg">
              <source src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/v_snow.mp4" type="video/mp4"/>
            </video>
            <p class="wn-clip-label">雪 · 远雪密、近雪疏，卷末题跋在雪中静至结束</p>
          </div>
        </div>
      </div>
    </section>

    <section class="wd-page wd-narr">
      <div class="wd-wrap">
        <div class="wd-sec"><b>圆相</b><span class="d">古人配的地图</span></div>
        <p class="wn-text">画卷开头另有一幅简笔平面导示图——不画山水，只以墨线勾出湖岸、堤桥、塔峰的方位，跋文里叫「圆相」，相当于古人给这卷画配的地图。我们把它做成可进入的空间，和今天的西湖叠在一起，八百年前的湖山格局，一眼对照。</p>
        <div class="wn-stage"><iframe src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/qingqu-scroll-labels/yuanxiang-3d/index.html?v=showcase-20261024" loading="lazy" title="圆相 3D 叠合"></iframe></div>
      </div>
    </section>

    <section class="wd-page wd-narr">
      <div class="wd-wrap">
        <div class="wd-sec"><b>题跋</b><span class="d">厉鹗 · 1727</span></div>
        <p class="wn-text">卷末是厉鹗在雍正五年写的一段图跋。收藏者王承武请他把画中名胜一一标出，他翻遍《武林旧事》《梦粱录》，把从钱塘门出发、环湖一周的近百处园子、寺观、桥梁全部点了出来——等于给这卷画写了一份说明书。</p>
        <blockquote class="wn-quote">
          <p class="wn-quote-orig">前作圆相，后引而长之，自钱塘门起，至钱塘门止。</p>
          <p class="wn-quote-trans">画卷开头是那幅平面地图，后面展开为长卷——从钱塘门出发，环湖一周，回到钱塘门。</p>
        </blockquote>
        <div class="wn-stage"><iframe src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/qingqu-scroll-labels/index.html" loading="lazy" title="画卷 · 地名校验台"></iframe></div>
      </div>
    </section>

    <section class="wd-page wd-narr">
      <div class="wd-wrap">
        <div class="wd-sec"><b>藏品</b></div>
        <p class="wn-text">《西湖清趣图》，旧传南宋画院李嵩所作，今多认为元明时期。纸本设色，高一尺有余，长逾五丈。现藏美国弗利尔美术馆（Freer Gallery of Art，史密森尼学会）。</p>
      </div>
    </section>
  </>}

  {(strip || stills.length > 0) && <section class="wd-page wd-p2" data-dwell={PAGE_DWELL.scroll}>
    {strip && <>
      <div class="wd-wrap"><div class="wd-sec"><b>全卷</b><span class="d">横向拖动浏览</span><span class="m">左右滑动</span></div></div>
      <div class="wd-strip" id="wd-strip"><img src={strip} alt={`${w.title} · 全卷`} referrerpolicy="no-referrer" loading="lazy" draggable="false"/></div>
      <div class="wd-prog" id="wd-prog" aria-hidden="true"></div>
    </>}
    {stills.length > 0 && <div class="wd-figs">
      {stills.map((src, i) => (
        <figure class="wd-fig" data-hide-on-err>
          <img data-r2 src={src} alt={`${w.title} · 静帧 ${pad(i + 1)}`} referrerpolicy="no-referrer" loading="lazy"/>
        </figure>
      ))}
    </div>}
  </section>}

  {XIHU_SHELL && audio && <section class="wd-page wd-narr wd-explore">
    <div class="wd-wrap">
      <div class="wd-sec"><b>探索</b></div>
      <div class="we-row">
        <button class="we-listen" id="wd-listen-explore" type="button">聆听图景</button>
        <a class="we-link" href="/works/xihu-panorama/shell/index.html">三层壳 · 复原 / 今图 / 画卷 ↗</a>
      </div>
      <div class="we-video">
        <p class="we-video-label">题跋朗读 · 六分三十六秒 · 云希</p>
        <video controls preload="none" playsinline style="width:100%;display:block;background:#000">
          <source src="https://pub-3209bcb7fc36444a914deb0e70ceca92.r2.dev/fig/xihu-panorama/scroll-reading.mp4" type="video/mp4"/>
        </video>
      </div>
    </div>
  </section>}

  <section class="wd-page wd-p3" data-dwell={PAGE_DWELL.next}>
    <nav class="wd-pn" aria-label="作品导航">
      <div class="wd-back-col"><p class="k">{backNote}</p><a class="wd-back" href={backHref}>{backText}</a></div>
      <a class="wd-next" href={`/works/${next.slug}/`}>
        <p class="k">下一件<span class="d"> →</span></p>
        <span class="row"><span><span class="t">{next.title}</span><span class="nm">{nextMeta}</span></span><span class="ar" aria-hidden="true">→</span></span>
      </a>
      <a class="wd-back-m" href={backHref}>{backText}<span>{backNote}</span></a>
    </nav>
    <div class="wd-end"><Cooperate /></div>
  </section>
</div>
{audio && !clipIsAudio && <video id="wd-audio" class="wd-sound" data-src={audio} preload="none" playsinline webkit-playsinline x5-playsinline x5-video-player-type="h5" aria-hidden="true"></video>}

<style>
:global(body) { background: var(--bg); }
.wd-sound { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.wd { color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wd p { margin: 0; }
/* 第一屏是完整的一页：视频区吃掉标题以外的全部空间，标题固定在页底。 */
.wd-hero {
  position: relative;
  margin: 0;
  overflow: hidden;
  background: var(--wd-paper, #d8d2c4);
}
.wd-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.wd-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (min-width: 769px) {
  .wd-page.wd-p1 { height: 100svh; display: flex; flex-direction: column; overflow: hidden; }
  .wd-page.wd-p1 .wd-hero { flex: 1 1 auto; min-height: 0; }
  .wd-page.wd-p1 .wd-wrap { flex: none; max-height: 17%; overflow: hidden; padding-bottom: 28px; }
  /* 第一屏只留画面和标题。长文会把入口裁掉，所以宽屏只留开头那句，两行链接跟在它下面。 */
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) { max-height: 360px; }
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) .wd-facts,
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) .wd-text > .wd-more { display: none; }
  /* 介绍句与副题是同一句，首屏不占高度，把画面拉长。 */
  .wd-page.wd-p1 .wd-intro { display: none; }
  /* 「打开 Demo」与下方「体验」区块是重复入口，首屏收掉；repo / 报道链接保留。 */
  .wd-page.wd-p1 .wd-link-demo { display: none; }
}
.wd-motion {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  z-index: 1;
  background: transparent;
}
.wd-hero.is-on .wd-motion { opacity: 1; }
/* 迷你浮窗：元素是 JS 建的，没有 Astro 作用域属性，必须 :global */
:global(.wd-mini) {
  position: fixed;
  right: 14px;
  bottom: 14px;
  z-index: 80;
  width: min(320px, 40vw);
  aspect-ratio: 16 / 9;
  background: #111;
  overflow: hidden;
  box-shadow: 0 10px 32px rgba(0, 0, 0, .28);
}
:global(.wd-mini .wd-motion) { opacity: 1; }
:global(.wd-mini-x) {
  position: absolute;
  top: 4px;
  right: 6px;
  z-index: 2;
  width: 22px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, .45);
  color: #fff;
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
}
:global(.wd-mini-snd) {
  position: absolute;
  top: 4px;
  left: 6px;
  z-index: 2;
  padding: 3px 9px;
  border: 0;
  border-radius: 999px;
  background: rgba(0, 0, 0, .45);
  color: #fff;
  font-size: 11px;
  line-height: 1.2;
  cursor: pointer;
}
@media (max-width: 768px) {
  :global(.wd-mini) { width: 36vw; right: 10px; bottom: 10px; }
}
.wd-media-btns { position: absolute; right: var(--page-pad); bottom: 18px; z-index: 3; display: flex; gap: 10px; }
.wd-icon-btn { width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgba(26, 26, 24, 0.55); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; backdrop-filter: blur(4px); transition: background .18s ease; }
.wd-icon-btn:hover { background: rgba(26, 26, 24, 0.78); }
.wd-icon-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.wd-icon-btn svg { width: 15px; height: 15px; display: block; }
#wd-hero-play .i-pause, #wd-listen .i-snd { display: none; }
#wd-hero-play[aria-pressed="true"] .i-pause, #wd-listen[aria-pressed="true"] .i-snd { display: block; }
#wd-hero-play[aria-pressed="true"] .i-play, #wd-listen[aria-pressed="true"] .i-mute { display: none; }
.wd-cap { position: absolute; left: var(--page-pad); bottom: 22px; z-index: 2; color: rgba(255, 255, 255, 0.92); font-size: 12px; line-height: normal; letter-spacing: 0.24em; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35); }
.wd-wrap { padding: 0 var(--page-pad); }
.wd-head { display: grid; grid-template-columns: 1fr auto; align-items: end; padding-top: 20px; }
.wd h1 { margin: 0; font-weight: 600; font-size: clamp(30px, 3.6vw, 42px); line-height: 1.1; letter-spacing: -0.03em; color: var(--ink); }
.wd-sub { margin-top: 6px !important; font-size: 16px; line-height: normal; color: var(--ink-soft); letter-spacing: 0.03em; }
.wd-body { display: grid; grid-template-columns: 7fr 4fr; gap: 96px; margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--rule); }
.wd-intro, .wd-more { font-size: 15px; line-height: 1.85; color: var(--ink-soft); max-width: 36em; letter-spacing: 0.02em; }
.wd-more { margin-top: 12px !important; }
.wd-more a { color: inherit; }
.wd-facts { margin: 0; font-size: 14px; }
.wd-facts div { display: grid; grid-template-columns: 72px 1fr; padding: 12px 0; border-bottom: 1px solid var(--rule); }
.wd-facts div:first-child { padding-top: 4px; }
.wd-facts dt { color: var(--faint); letter-spacing: 0.12em; font-size: 12px; line-height: 22px; }
.wd-facts dd { margin: 0; color: var(--ink); line-height: 22px; letter-spacing: 0.04em; }
.wd-sec { margin-top: 104px; display: flex; justify-content: space-between; align-items: baseline; line-height: normal; }
.wd-sec b { font-size: 12px; font-weight: 400; letter-spacing: 0.24em; color: var(--faint); }
.wd-sec span { font-size: 12px; letter-spacing: 0.14em; color: var(--faint); }
.wd-sec .m { display: none; }
.wd-strip {
  margin-top: 20px;
  height: 360px;
  overflow-x: auto;
  overflow-y: hidden;
