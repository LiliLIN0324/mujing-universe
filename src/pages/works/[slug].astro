---
import Base from '../../layouts/Base.astro';
import Cooperate from '../../components/Cooperate.astro';
import DemoEmbed from '../../components/DemoEmbed.astro';
import { allWorks, coverClip, pickBody, pickTech, workAudio, workFallback, workPaper, workHero, workStills, workStrip, workSubtitle } from '../../lib';
export async function getStaticPaths() {
  const ws = await allWorks();
  // 下一件 follows the catalogue order; the last wraps to the first.
  return ws.map((w, i) => ({ params: { slug: w.slug }, props: { w, next: ws[i + 1] || ws[0] } }));
}
const { w, next } = Astro.props;
/* ≤768px page-by-page: per-page "dwell" switch ('on' = vertical swipes first walk the
   page's own content — the full-scroll strip on page 2 — then flip; 'off' = flip at once).
   Which pages dwell is TBD: all off. */
const PAGE_DWELL: Record<'intro' | 'scroll' | 'next', 'on' | 'off'> = { intro: 'off', scroll: 'off', next: 'off' };

const hero = workHero(w);
const paper = workPaper(w);
const fallback = workFallback(w);
const stills = workStills(w);
const strip = workStrip(w);
const audio = workAudio(w);
const clip = coverClip(w.slug);
const clipIsAudio = !!(clip && audio && clip === audio);
const sub = workSubtitle(w);
const oneLiner = (() => {
  const d = (w.description || '').replace(/（占位[^）]*）/g, '').trim();
  if (!d) return '';
  return d.endsWith('。') || d.length < 40 ? d : d.split('。')[0] + '。';
})();
const intro = pickBody(w);
const tech = pickTech(w);
const year = w.yearNum ? String(w.yearNum) : w.year;
const abstract = w.abstract && w.abstract !== w.description ? w.abstract : '';
// 角色: the works data has no role field, so it stays empty (hidden) until a real source exists.
const role = '';
const facts = [['分类', w.line], ['角色', role], ['技术', tech.join(' · ')], ['年份', year], ['状态', w.status]].filter(([, v]) => v);
const pad = (n: number) => String(n).padStart(2, '0');
const nextMeta = [next.line, next.yearNum || next.year].filter(Boolean).join(' · ');
const backHref = `/works/?line=${encodeURIComponent(w.line)}#archive`;
const backText = '← 作品';
const backNote = w.line;
// Demo 只认 demo 里的真实网址。报道只认 link。个人站 source 不当体验入口。
const httpUrl = (value?: string) => {
  const url = (value || '').trim();
  return /^https?:\/\//i.test(url) ? url : '';
};
const demoHref = httpUrl(w.demo);
const repoHref = httpUrl(w.repo);
const newsHref = httpUrl(w.link);
/* 西湖清趣：官网只留一条进壳入口（进度5 收口），壳在 /works/xihu-panorama/shell/ */
const XIHU_SHELL = w.slug === 'xihu-panorama';
---
<Base title={`${w.title} · 幕景宇宙`} description={intro ? intro.slice(0, 140) : undefined} active="/works/" home navClass="top--work">
<div class="wd">
  <section class="wd-page wd-p1" data-dwell={PAGE_DWELL.intro}>
    <figure class:list={['wd-hero', clip && 'has-motion']} style={paper ? `--wd-paper:${paper}` : undefined}>
      <div class="wd-frame">
        <img src={hero} data-fallback={fallback} alt={w.title} referrerpolicy="no-referrer" fetchpriority="high"/>
        {clip && <video class="wd-motion" id={clipIsAudio ? 'wd-audio' : undefined} data-src={clip} data-audio={clipIsAudio ? '1' : undefined} muted loop playsinline webkit-playsinline preload="none" disablepictureinpicture aria-hidden="true"></video>}
      </div>
      {clip && <button class="wd-play" id="wd-hero-play" type="button" aria-pressed="false">播放</button>}
      <figcaption class="wd-cap" aria-hidden="true">{clip ? (w.slug === 'xihu-panorama' ? '长卷 · 画面' : '画面') : (w.slug === 'xihu-panorama' ? '长卷 · 静帧 01' : '静帧 01')}</figcaption>
    </figure>
    <div class="wd-wrap">
      <div class="wd-head">
        <div>
          <h1>{w.title}</h1>
          {(sub || oneLiner) && <p class="wd-sub">{sub || oneLiner}</p>}
        </div>
        {audio && <button class="wd-listen" id="wd-listen" type="button" aria-pressed="false"><span class="ic" aria-hidden="true"></span><span class="lb">聆听图景</span></button>}
      </div>
      <div class="wd-body">
        <div class="wd-text">
          {intro && <p class="wd-intro">{intro}</p>}
          {abstract && <p class="wd-more">{abstract}</p>}
          {w.note && <p class="wd-more">{w.note}</p>}
          {(demoHref || repoHref || newsHref) && <div class="wd-links">
            {demoHref && <p class="wd-more"><a href={demoHref} target="_blank" rel="noopener noreferrer">打开 Demo ↗</a></p>}
            {repoHref && <p class="wd-more">模板已经开源，代码和使用说明放在 <a href={repoHref} target="_blank" rel="noopener noreferrer">GitHub ↗</a>。</p>}
            {newsHref && <p class="wd-more"><a href={newsHref} target="_blank" rel="noopener noreferrer">相关报道 ↗</a></p>}
          </div>}
        </div>
        {facts.length > 0 && <dl class="wd-facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      </div>
    </div>
  </section>

  {demoHref && <section class="wd-page wd-demo" id="demo" aria-labelledby="demo-h" data-dwell={PAGE_DWELL.scroll}>
    <div class="wd-wrap">
      <div class="wd-sec"><b>体验</b><span class="d">网页端实时运行</span><span class="m">在页内试用</span></div>
      <h2 class="wd-demo-h" id="demo-h">直接打开看看</h2>
    </div>
    <div class="wd-demo-stage"><DemoEmbed url={demoHref} title={w.title} cover={hero} /></div>
  </section>}

  {XIHU_SHELL && <section class="wd-page wd-layers" id="layers" aria-labelledby="layers-h" data-dwell={PAGE_DWELL.scroll}>
    <div class="wd-wrap">
      <p class="wl-brand">当代西湖 · 画卷 / 复原 / 今图</p>
      <h2 class="wl-title" id="layers-h">同一卷西湖，三种看法</h2>
      <p class="wl-lead">画清趣长卷，游南宋复原，对今日湖山——同一片西湖，一个壳里切换。</p>
      <div class="wl-actions" style="margin-top:28px">
        <DemoEmbed url="/works/xihu-panorama/shell/" title="西湖清趣壳" cover={hero} />
      </div>
      <p class="wl-foot">古今对照为示意，非测绘级。</p>
    </div>
  </section>}

  {(strip || stills.length > 0) && <section class="wd-page wd-p2" data-dwell={PAGE_DWELL.scroll}>
    {strip && <>
      <div class="wd-wrap"><div class="wd-sec"><b>全卷</b><span class="d">横向拖动浏览</span><span class="m">左右滑动</span></div></div>
      <div class="wd-strip" id="wd-strip"><img src={strip} alt={`${w.title} · 全卷`} referrerpolicy="no-referrer" loading="lazy" draggable="false"/></div>
      <div class="wd-prog" id="wd-prog" aria-hidden="true"></div>
    </>}
    {stills.length > 0 && <div class="wd-figs">
      {stills.map((src, i) => (
        <figure class="wd-fig" data-hide-on-err>
          <img data-r2 src={src} alt={`${w.title} · 静帧 ${pad(i + 1)}`} referrerpolicy="no-referrer" loading="lazy"/>
        </figure>
      ))}
    </div>}
  </section>}

  <section class="wd-page wd-p3" data-dwell={PAGE_DWELL.next}>
    <nav class="wd-pn" aria-label="作品导航">
      <div class="wd-back-col"><p class="k">{backNote}</p><a class="wd-back" href={backHref}>{backText}</a></div>
      <a class="wd-next" href={`/works/${next.slug}/`}>
        <p class="k">下一件<span class="d"> →</span></p>
        <span class="row"><span><span class="t">{next.title}</span><span class="nm">{nextMeta}</span></span><span class="ar" aria-hidden="true">→</span></span>
      </a>
      <a class="wd-back-m" href={backHref}>{backText}<span>{backNote}</span></a>
    </nav>
    <div class="wd-end"><Cooperate /></div>
  </section>
</div>
{audio && !clipIsAudio && <video id="wd-audio" class="wd-sound" data-src={audio} preload="none" playsinline webkit-playsinline x5-playsinline x5-video-player-type="h5" aria-hidden="true"></video>}

<style>
:global(body) { background: var(--bg); }
.wd-sound { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.wd { color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wd p { margin: 0; }
/* 第一屏是完整的一页：视频区吃掉标题以外的全部空间，标题固定在页底。 */
.wd-hero {
  position: relative;
  margin: 0;
  overflow: hidden;
  background: var(--wd-paper, #d8d2c4);
}
.wd-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.wd-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (min-width: 769px) {
  .wd-page.wd-p1 { height: 100svh; display: flex; flex-direction: column; overflow: hidden; }
  .wd-page.wd-p1 .wd-hero { flex: 1 1 auto; min-height: 0; }
  .wd-page.wd-p1 .wd-wrap { flex: none; max-height: 17%; overflow: hidden; padding-bottom: 28px; }
  /* 第一屏只留画面和标题。长文会把入口裁掉，所以宽屏只留开头那句，两行链接跟在它下面。 */
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) { max-height: 360px; }
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) .wd-facts,
  .wd-page.wd-p1 .wd-wrap:has(.wd-links) .wd-text > .wd-more { display: none; }
}
.wd-motion {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  z-index: 1;
  background: transparent;
}
.wd-hero.is-on .wd-motion { opacity: 1; }
.wd-play {
  position: absolute;
  right: var(--page-pad);
  bottom: 18px;
  z-index: 2;
  border: 0;
  background: rgba(26, 26, 24, 0.82);
  color: #fff;
  font: inherit;
  font-size: 13px;
  letter-spacing: 0.12em;
  padding: 10px 16px;
  min-height: 44px;
  cursor: pointer;
}
.wd-cap { position: absolute; left: var(--page-pad); bottom: 22px; z-index: 2; color: rgba(255, 255, 255, 0.92); font-size: 12px; line-height: normal; letter-spacing: 0.24em; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35); }
.wd-wrap { padding: 0 var(--page-pad); }
.wd-head { display: grid; grid-template-columns: 1fr auto; align-items: end; padding-top: 20px; }
.wd h1 { margin: 0; font-weight: 600; font-size: clamp(30px, 3.6vw, 42px); line-height: 1.1; letter-spacing: -0.03em; color: var(--ink); }
.wd-sub { margin-top: 6px !important; font-size: 16px; line-height: normal; color: var(--ink-soft); letter-spacing: 0.03em; }
.wd-listen {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
  border: 0;
  border-radius: 0;
  padding: 14px 26px;
  background: var(--cta-bg);
  color: var(--cta-fg);
  font-family: inherit;
  font-size: 15px;
  line-height: normal;
  letter-spacing: 0.08em;
  cursor: pointer;
}
.wd-listen:hover { opacity: 0.86; }
.wd-listen .ic { width: 0; height: 0; border-left: 9px solid var(--cta-fg); border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
.wd-listen[aria-pressed="true"] .ic { width: 9px; height: 12px; border: 0; border-left: 3px solid var(--cta-fg); border-right: 3px solid var(--cta-fg); }
.wd-listen:disabled { opacity: 0.45; cursor: not-allowed; }
.wd-body { display: grid; grid-template-columns: 7fr 4fr; gap: 96px; margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--rule); }
.wd-intro, .wd-more { font-size: 15px; line-height: 1.85; color: var(--ink-soft); max-width: 36em; letter-spacing: 0.02em; }
.wd-more { margin-top: 12px !important; }
.wd-more a { color: inherit; }
.wd-facts { margin: 0; font-size: 14px; }
.wd-facts div { display: grid; grid-template-columns: 72px 1fr; padding: 12px 0; border-bottom: 1px solid var(--rule); }
.wd-facts div:first-child { padding-top: 4px; }
.wd-facts dt { color: var(--faint); letter-spacing: 0.12em; font-size: 12px; line-height: 22px; }
.wd-facts dd { margin: 0; color: var(--ink); line-height: 22px; letter-spacing: 0.04em; }
.wd-sec { margin-top: 104px; display: flex; justify-content: space-between; align-items: baseline; line-height: normal; }
.wd-sec b { font-size: 12px; font-weight: 400; letter-spacing: 0.24em; color: var(--faint); }
.wd-sec span { font-size: 12px; letter-spacing: 0.14em; color: var(--faint); }
.wd-sec .m { display: none; }
.wd-strip {
  margin-top: 20px;
  height: 360px;
  overflow-x: auto;
  overflow-y: hidden;
  background: var(--strip);
  scrollbar-width: none;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  overscroll-behavior-x: contain;
}
.wd-strip::-webkit-scrollbar { display: none; }
.wd-strip.is-drag { cursor: grabbing; }
.wd-strip img { height: 100%; max-height: 627px; width: auto; max-width: none; display: block; pointer-events: none; }
.wd-prog { --p: 0; margin: 16px var(--page-pad) 0; height: 1px; background: var(--rule); position: relative; }
.wd-prog::after { content: ""; position: absolute; left: 0; top: 0; height: 1px; width: 18%; background: var(--ink); transform: translateX(calc(var(--p) * (100% / 0.18 - 100%))); }
.wd-figs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: 32px var(--page-pad) 0;
}
.wd-fig { margin: 0; }
.wd-fig img { width: 100%; display: block; }
.wd-pn { margin: 128px var(--page-pad) 0; border-top: 1px solid var(--rule); display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: 40px 0 30px; }
.wd-end { margin: 8px var(--page-pad) 48px; }
.wd-pn .k { font-size: 12px; line-height: normal; letter-spacing: 0.22em; color: var(--faint); margin-bottom: 10px !important; }
.wd-back { display: inline-block; font-size: 14px; line-height: normal; letter-spacing: 0.12em; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink); padding-bottom: 3px; }
.wd-next { text-align: right; color: inherit; text-decoration: none; }
.wd-next .row { display: block; }
.wd-next .t { display: block; font-size: 22px; font-weight: 600; line-height: 1.3; letter-spacing: -0.03em; }
.wd-next .nm { display: block; margin-top: 8px; font-size: 13px; line-height: normal; color: var(--faint); letter-spacing: 0.06em; }
.wd-next .ar, .wd-back-m { display: none; }
.wd-next:hover .t { opacity: 0.7; }

/* 内嵌 Demo：全宽区块，比首屏文字列大得多 */
.wd-demo { padding: 96px 0 0; }
.wd-demo-h { margin: 18px 0 26px; font-size: clamp(24px, 2.6vw, 32px); font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; color: var(--ink); }
.wd-demo-stage { padding: 0 var(--page-pad); }
.wd-demo-stage :global(.de) { margin-top: 0; }

/* 西湖清趣 · 四层体验（同壳四段切换） */
.wd-layers { padding: 104px 0 0; }
.wl-brand { margin: 0 0 10px; font-size: 12px; letter-spacing: 0.18em; color: var(--faint); text-transform: uppercase; }
.wl-title { margin: 0; font-size: clamp(26px, 2.8vw, 34px); font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; color: var(--ink); }
.wl-lead { margin-top: 14px !important; font-size: 15px; line-height: 1.85; letter-spacing: 0.02em; color: var(--ink-soft); max-width: 34em; }
.wl-shell { margin-top: 36px; border-top: 1px solid var(--rule); }
/* 顶部分段 4 签 */
.wl-tabs { display: flex; border-bottom: 1px solid var(--rule); }
.wl-tab {
  display: inline-flex; align-items: baseline; gap: 8px;
  padding: 16px 22px 14px; border: 0; border-bottom: 2px solid transparent;
  background: none; color: var(--faint); font: inherit; cursor: pointer;
  transition: color .2s ease, border-color .2s ease;
}
.wl-tab-n { font-size: 11px; letter-spacing: 0.14em; }
.wl-tab-t { font-size: 16px; font-weight: 600; letter-spacing: 0.02em; }
.wl-tab-s { display: none; font-size: 11px; letter-spacing: 0.1em; }
.wl-tab:hover:not(:disabled) { color: var(--ink); }
.wl-tab.is-active { color: var(--ink); border-bottom-color: var(--ink); }
.wl-tab.is-pending { cursor: not-allowed; opacity: 0.45; }
.wl-tab:focus-visible { outline: 1px solid var(--ink); outline-offset: -1px; }
/* panel */
.wl-panel { padding: 28px 0 8px; }
.wl-panel[hidden] { display: none; }
.wl-sentence { margin: 0 0 18px !important; font-size: 15px; line-height: 1.75; letter-spacing: 0.02em; color: var(--ink-soft); max-width: 32em; }
.wl-stage {
  position: relative;
  width: 100%; min-height: 62vh;
  background: var(--bg);
  border: 1px solid var(--rule);
  overflow: hidden;
}
.wl-stage iframe {
  display: block; width: 100%; height: 62vh; min-height: 420px;
  border: 0; background: var(--bg);
}
.wl-stage.is-empty { display: flex; align-items: center; justify-content: center; min-height: 320px; }
.wl-empty { margin: 0; font-size: 14px; letter-spacing: 0.06em; color: var(--faint); }
.wl-actions { margin-top: 16px; }
.wl-btn {
  display: inline-block; padding: 10px 22px;
  background: var(--cta-bg); color: var(--cta-fg);
  font: inherit; font-size: 13px; letter-spacing: 0.08em;
  border: 0; cursor: pointer;
}
.wl-btn:hover:not(:disabled) { opacity: 0.86; }
.wl-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.wl-foot { margin-top: 18px !important; font-size: 12px; letter-spacing: 0.08em; color: var(--faint); }

@media (max-width: 768px) {
  :global(html) { scroll-snap-type: y mandatory; scroll-padding-top: 52px; }
  .wd-page { scroll-snap-align: start; scroll-snap-stop: always; min-height: calc(100vh - 52px); min-height: calc(100svh - 52px); }
  .wd-p3 { min-height: 0; }
  .wd-play { right: 12px; bottom: 12px; }
  .wd-cap { display: none; }
  .wd-wrap { padding: 0 var(--page-gutter); }
  .wd-head { display: block; padding-top: 0; }
  .wd h1 { margin-top: 12px; font-size: 30px; line-height: 1.22; letter-spacing: 0.02em; }
  .wd-sub { margin-top: 4px !important; font-size: 14px; line-height: 1.5; letter-spacing: 0; }
  .wd-listen { display: inline-flex; margin: 22px 0 0; padding: 12px 22px; font-size: 14px; }
  .wd-listen .ic { border-left-width: 8px; border-top-width: 5px; border-bottom-width: 5px; }
  .wd-body { display: block; margin-top: 32px; padding-top: 24px; }
  .wd-intro, .wd-more { font-size: 15px; line-height: 1.9; max-width: none; letter-spacing: 0; }
  .wd-facts { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px 36px; font-size: 13px; }
  .wd-facts div, .wd-facts div:first-child { display: block; padding: 0; border: 0; }
  .wd-facts dt { font-size: 11px; line-height: normal; letter-spacing: 0.1em; margin-bottom: 4px; }
  .wd-facts dd { line-height: normal; }
  .wd-p2 { padding-top: 1px; }
  .wd-sec { margin-top: 56px; }
  .wd-sec b, .wd-sec span { font-size: 11px; letter-spacing: 0.12em; }
  .wd-sec b { letter-spacing: 0.24em; }
  .wd-sec .d { display: none; }
  .wd-sec .m { display: inline; }
  .wd-strip { margin-top: 14px; height: 200px; cursor: auto; }
  .wd-prog { margin: 12px var(--page-gutter) 0; }
  .wd-prog::after { width: 8%; transform: translateX(calc(var(--p) * (100% / 0.08 - 100%))); }
  .wd-figs { grid-template-columns: 1fr 1fr; gap: 6px; margin: 16px var(--page-gutter) 0; }
  .wd-pn { display: block; margin: 64px var(--page-gutter) 0; padding: 22px 0 0; }
  .wd-end { margin: 8px var(--page-gutter) 32px; }
  .wd-back-col { display: none; }
  .wd-pn .k { font-size: 11px; margin-bottom: 0 !important; }
  .wd-pn .k .d { display: none; }
  .wd-next { display: block; text-align: left; }
  .wd-next .row { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
  .wd-next .t { font-size: 21px; }
  .wd-next .nm { margin-top: 6px; font-size: 12px; }
  .wd-next .ar { display: block; font-size: 18px; color: var(--ink); }
  .wd-back-m { display: flex; justify-content: space-between; margin-top: 28px; padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); font-size: 14px; line-height: normal; letter-spacing: 0.1em; color: var(--ink); text-decoration: none; }
  .wd-back-m span { color: var(--faint); font-size: 12px; }
  .wd-layers { padding: 28px 0 0; }
  .wd-demo { padding: 40px 0 0; }
  .wd-demo-h { margin: 10px 0 18px; font-size: 22px; }
  .wd-demo-stage { padding: 0 var(--page-gutter); }
  .wl-brand { font-size: 11px; letter-spacing: 0.14em; }
  .wl-title { font-size: 24px; line-height: 1.3; letter-spacing: 0.01em; }
  .wl-lead { margin-top: 10px !important; font-size: 14px; line-height: 1.8; letter-spacing: 0; }
  .wl-shell { margin-top: 22px; }
  .wl-tabs { overflow-x: auto; scrollbar-width: none; }
  .wl-tabs::-webkit-scrollbar { display: none; }
  .wl-tab { flex: 0 0 auto; padding: 12px 14px 10px; gap: 6px; }
  .wl-tab-n { font-size: 10px; letter-spacing: 0.1em; }
  .wl-tab-t { display: none; }
