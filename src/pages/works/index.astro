---
import Base from '../../layouts/Base.astro'; import WorkCover from '../../components/WorkCover.astro';
import { allWorks, LINES, WORKS_COVER, splitTitle, clean } from '../../lib';
const ws = (await allWorks()).map(w => ({
  ...w,
  main: splitTitle(w.title)[0],
  desc: clean(w.description),
  ym: `${w.line} · ${w.yearNum || w.year}`,
  meta: `${w.line} · ${w.yearNum || w.year}${w.status === '进行中' ? ' · 进行中' : ''}`,
}));
const first = ws[0];
const preload = [...new Set(ws.map(w => WORKS_COVER[w.slug]?.src).filter(Boolean))];
const tabs = [['全部', ws.length], ...LINES.map(l => [l, ws.filter(w => w.line === l).length])] as [string, number][];
---
<Base title="作品 · 幕景宇宙" active="/works/">
<main class="wk">
<section class="wk-head">
  <div class="wk-hl"><p class="wk-kick">Works · {ws.length}</p><h1>作品</h1></div>
  <div class="wk-tabwrap"><nav class="wk-tabs" id="wk-tabs" aria-label="按创作线筛选">
    {tabs.map(([l, n], i) => <a href={i === 0 ? '/works/' : `/works/?line=${encodeURIComponent(l)}`} data-f={l} class={i === 0 ? 'on' : undefined}>{l}<sup>{n}</sup></a>)}
  </nav></div>
</section>

<section class="wk-body">
  <div class="wk-list">
    <div class="wk-lh" aria-hidden="true"><span>No.</span><span>作品</span><span>类别 · 年份</span></div>
    <ol id="wk-rows">
      {ws.map((w, i) => <li data-line={w.line}><a class:list={['wk-row', i === 0 && 'on']} href={`/works/${w.slug}/`} data-slug={w.slug} data-no={w.no} data-title={w.title} data-meta={w.meta} data-desc={w.desc}>
        <span class="no">{w.no}</span><span class="tt">{w.main}</span><span class="mt">{w.ym}</span></a></li>)}
    </ol>
  </div>
  <aside class="wk-pv" id="wk-pv" aria-live="polite">
    <a class="pv-cv" id="pv-cv" href={`/works/${first.slug}/`} tabindex="-1" aria-hidden="true"><div class="pv-layer"><WorkCover w={first}/></div></a>
    <div class="pv-cap">
      <div class="pv-row"><span class="pv-no" id="pv-no">{first.no}</span><span id="pv-meta">{first.meta}</span></div>
      <h2 class="pv-t" id="pv-t">{first.title}</h2>
      <p class="pv-d" id="pv-d" hidden={!first.desc}>{first.desc}</p>
      <a class="more" id="pv-more" href={`/works/${first.slug}/`}>查看作品 <span>→</span></a>
    </div>
  </aside>

  <ol class="wk-m" id="wk-m">
    {ws.map(w => <li data-line={w.line} data-slug={w.slug}><a href={`/works/${w.slug}/`}>
      <WorkCover w={w}/>
      <div class="mr"><span class="no">{w.no}</span><span class="tt">{w.main}</span></div>
      <p class="mt">{w.meta}</p></a></li>)}
  </ol>
</section>
</main>
<script is:inline type="application/json" id="wk-preload" set:html={JSON.stringify(preload)}></script>

<style is:global>
.wk { --rule1: rgba(26,26,28,.10); --rule2: rgba(26,26,28,.16); --fbpaper: #F1EEE6; --song: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  width: min(1312px, calc(100% - 128px)); margin: 0 auto; }
.wk a { color: inherit; text-decoration: none; }
.wk [hidden], .wk .hide { display: none !important; }
/* head */
.wk-head { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; align-items: end; padding: 88px 0 36px; border-bottom: 1px solid var(--rule2); }
.wk-hl { grid-column: 1 / 7; }
.wk-kick { margin: 0; font-family: var(--en); font-size: 12px; letter-spacing: .14em; color: var(--muted); }
.wk h1 { margin: 14px 0 0; font-family: var(--song); font-weight: 600; font-size: 52px; line-height: 1.1; letter-spacing: .03em; color: var(--ink); }
.wk-tabwrap { grid-column: 7 / 13; }
.wk-tabs { display: flex; justify-content: flex-end; gap: 30px; padding-bottom: 4px; font-size: 15px; letter-spacing: .04em; color: var(--ink2); }
.wk-tabs a { white-space: nowrap; padding-bottom: 7px; border-bottom: 1px solid transparent; transition: color .15s; }
.wk-tabs a:hover { color: var(--ink); }
.wk-tabs a.on { color: var(--ink); border-bottom-color: var(--ink); }
.wk-tabs sup { font-family: var(--en); font-size: 10px; color: var(--muted); margin-left: 3px; letter-spacing: 0; vertical-align: 6px; line-height: 0; }
/* body */
.wk-body { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; padding-top: 28px; align-items: start; }
.wk-list { grid-column: 1 / 6; }
.wk-lh { display: grid; grid-template-columns: 48px 1fr auto; font-family: var(--en); font-size: 11px; letter-spacing: .14em; color: var(--muted); padding: 0 0 12px; border-bottom: 1px solid var(--rule2); }
.wk-list ol, .wk-m { list-style: none; margin: 0; padding: 0; }
.wk-row { display: grid; grid-template-columns: 48px 1fr auto; align-items: baseline; padding: 15px 0 14px; border-bottom: 1px solid var(--rule1); outline-offset: 2px; }
.wk-row .no { font-family: var(--en); font-size: 12px; letter-spacing: .06em; color: var(--muted); font-variant-numeric: tabular-nums; }
.wk-row .tt { font-family: var(--song); font-size: 20px; line-height: 1.4; font-weight: 400; letter-spacing: .02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 20px; color: #2a2a2c; }
.wk-row .mt { font-size: 13px; color: var(--muted); letter-spacing: .03em; white-space: nowrap; }
.wk-row.on .no { color: var(--accent); }
.wk-row.on .tt { color: var(--ink); font-weight: 600; }
.wk-row.on .mt { color: var(--ink2); }
.wk-pv { grid-column: 7 / 13; position: sticky; top: 112px; padding-top: 29px; }
.pv-cv { display: block; position: relative; aspect-ratio: 16 / 9; }
.pv-layer { position: absolute; inset: 0; transition: opacity .15s ease; }
.pv-layer.in { opacity: 0; }
.pv-cap { padding-top: 22px; }
.pv-row { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; color: var(--muted); letter-spacing: .04em; }
.pv-no { font-family: var(--en); color: var(--accent); letter-spacing: .06em; }
.wk .pv-t { margin: 10px 0 0; font-family: var(--song); font-weight: 600; font-size: 28px; line-height: 1.3; letter-spacing: .02em; color: var(--ink); }
.pv-d { margin: 12px 0 0; font-size: 15px; line-height: 1.75; color: var(--ink2); max-width: 34em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.wk .more { display: inline-block; margin-top: 20px; font-size: 14px; letter-spacing: .08em; border-bottom: 1px solid var(--ink); padding-bottom: 3px; }
.more span { font-family: var(--en); margin-left: 4px; }
.wk-m { display: none; }
/* cover */
.wk .cv { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #EFEDE9; container-type: inline-size; }
.wk .pv-layer .cv { height: 100%; }
.wk .cv img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; max-width: none; }
.wk .cv:not(.fb) > :not(img) { display: none; }
.wk .cv.fb { background: var(--fbpaper); box-shadow: inset 0 0 0 1px var(--rule2); }
.fb-no { position: absolute; left: 4.5cqw; top: 4cqw; font-family: var(--en); font-size: clamp(11px, 1.9cqw, 13px); line-height: 1; letter-spacing: .08em; color: var(--muted); }
.fb-t { position: absolute; left: 9cqw; right: 9cqw; top: 50%; transform: translateY(-54%); display: flex; flex-direction: column; align-items: flex-start; }
.fb-title { display: block; font-family: var(--song); font-weight: 600; font-size: 6.2cqw; line-height: 1.22; letter-spacing: .03em; color: var(--ink); text-wrap: balance; word-break: keep-all; overflow-wrap: normal; }
.fb-title.long { font-size: 4.6cqw; }
.fb-sub { display: block; margin-top: 2.2cqw; font-style: normal; font-family: var(--en), "Noto Sans SC", sans-serif; font-size: clamp(11px, 2.1cqw, 14px); line-height: 1.5; letter-spacing: .04em; color: var(--muted); }
.fb-meta { position: absolute; left: 4.5cqw; bottom: 4cqw; font-size: clamp(11px, 1.9cqw, 13px); letter-spacing: .06em; color: var(--muted); }
.seal-ghost {
  position: fixed; z-index: 40; box-sizing: border-box; margin: 0;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  padding: 8px; background: #FBFBFA; color: #1A1A1C; text-align: center; pointer-events: none;
  font-family: "Alibaba PuHuiTi 3.0", "PingFang SC", sans-serif; font-weight: 600; font-size: 13px; line-height: 1.2;
  filter: drop-shadow(1.15px 0 0 #1A1A1C) drop-shadow(-1.15px 0 0 #1A1A1C) drop-shadow(0 1.15px 0 #1A1A1C) drop-shadow(0 -1.15px 0 #1A1A1C);
  transform-origin: center center;
}
.seal-ghost span { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
@media (prefers-reduced-motion: reduce) {
  .pv-layer { transition: none !important; }
}
/* mobile ≤1023 */
@media (max-width: 1023px) {
  .wk { width: auto; margin: 0; }
  .wk-head { display: block; padding: 40px 24px 0; border-bottom: 0; }
  .wk h1 { font-size: 36px; line-height: 1.15; margin-top: 10px; }
  .wk-tabwrap { position: relative; margin: 26px -24px 0; border-bottom: 1px solid var(--rule2); }
  .wk-tabwrap::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 40px; pointer-events: none; background: linear-gradient(90deg, rgba(246,245,243,0), var(--bg)); }
  .wk-tabs { justify-content: flex-start; gap: 24px; padding: 0 24px; font-size: 14px; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
  .wk-tabs::-webkit-scrollbar { display: none; }
  .wk-tabs a { padding-bottom: 12px; }
  .wk-tabs a:last-child { margin-right: 16px; }
  .wk-body { display: block; padding-top: 0; }
  .wk-list, .wk-pv { display: none; }
  .wk-m { display: block; padding: 0 24px; }
  .wk-m li { border-bottom: 1px solid var(--rule1); }
  .wk-m li > a { display: block; padding: 28px 0 26px; }
  .wk-m .fb-no, .wk-m .fb-meta { display: none; }
  .wk-m .fb-t { transform: translateY(-50%); }
  .mr { display: flex; align-items: baseline; gap: 12px; margin-top: 16px; }
  .mr .no { flex: none; font-family: var(--en); font-size: 12px; letter-spacing: .06em; color: var(--muted); }
  .mr .tt { font-family: var(--song); font-weight: 600; font-size: 18px; line-height: 1.45; letter-spacing: .02em; color: var(--ink); }
  .wk-m .mt { margin: 6px 0 0 29px; font-size: 13px; color: var(--muted); letter-spacing: .03em; }
}
</style>
<script is:inline>
(() => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // 图片封面出错 → 换成排版封面（排版内容已在 DOM 里）
  const fail = (img) => { const cv = img.closest('.cv'); if (cv) cv.classList.add('fb'); img.remove(); };
  const guard = (root) => $$('img[data-cv-img]', root).forEach((img) => {
    if (img.complete && img.naturalWidth === 0 && img.src) fail(img);
    else img.addEventListener('error', () => fail(img), { once: true });
  });
  guard(document);

  const rows = $$('.wk-row'), cards = $$('#wk-m > li');
  const pvCv = $('#pv-cv'), pvNo = $('#pv-no'), pvMeta = $('#pv-meta'), pvT = $('#pv-t'), pvD = $('#pv-d'), pvMore = $('#pv-more');
  let cur = rows.find((r) => r.classList.contains('on'));
  function show(row) {
    if (!row || row === cur) return;
    cur?.classList.remove('on'); row.classList.add('on'); cur = row;
    const d = row.dataset, href = row.getAttribute('href');
    pvNo.textContent = d.no; pvMeta.textContent = d.meta; pvT.textContent = d.title;
    pvD.textContent = d.desc || ''; pvD.hidden = !d.desc;
    pvMore.href = href; pvCv.href = href;
    const src = cards.find((c) => c.dataset.slug === d.slug)?.querySelector('.cv');
    if (!src) return;
    const layer = document.createElement('div'); layer.className = 'pv-layer';
    const cv = src.cloneNode(true); $$('img', cv).forEach((i) => { i.loading = 'eager'; });
    layer.appendChild(cv); guard(layer);
    const old = $$('.pv-layer', pvCv);
    if (reduce) { old.forEach((o) => o.remove()); pvCv.appendChild(layer); return; }
    layer.classList.add('in'); pvCv.appendChild(layer);
    requestAnimationFrame(() => requestAnimationFrame(() => layer.classList.remove('in')));
    setTimeout(() => old.forEach((o) => o.remove()), 160);
  }
  rows.forEach((r) => { r.addEventListener('mouseenter', () => show(r)); r.addEventListener('focus', () => show(r)); });

  // 筛选：?line= + replaceState；列表和移动卡片同时过滤，当前项重置为第一件
  const tabs = $$('#wk-tabs a');
  const valid = new Set(tabs.map((t) => t.dataset.f));
  let line = new URLSearchParams(location.search).get('line') || '全部';
  if (!valid.has(line)) line = '全部';
  function apply() {
    tabs.forEach((t) => { const on = t.dataset.f === line; t.classList.toggle('on', on); if (on) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current'); });
    const hit = (el) => line === '全部' || el.dataset.line === line;
    $$('#wk-rows > li').forEach((li) => li.classList.toggle('hide', !hit(li)));
    cards.forEach((li) => li.classList.toggle('hide', !hit(li)));
    const firstRow = rows.find((r) => hit(r.parentElement));
    if (firstRow && firstRow !== cur) show(firstRow);
  }
  // 筛选切换：卡片收成略微倾斜的六边形，落进蜂窝格（像盖一枚印），再展开成筛后的列表。
  // 用固定定位的小砖，而不是裁切整行，避免宽行在飞行时叠成一大片字。
  const HEX = 'polygon(50% 4%, 93% 27%, 90% 75%, 50% 97%, 7% 75%, 10% 25%)';
  const RECT = 'polygon(0% 0%, 100% 0%, 100% 50%, 100% 100%, 0% 100%, 0% 50%)';
  let stampLock = false;
  let stampPending = null;
  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
  const listNodes = () => {
    const mobile = matchMedia('(max-width: 1023px)').matches;
    const all = $$(mobile ? '#wk-m > li' : '#wk-rows > li');
    return { all, shown: all.filter((li) => !li.classList.contains('hide')) };
  };
  function hexLattice(n, bounds) {
    const gap = 8;
    let cols = Math.max(1, Math.round(Math.sqrt(n * (bounds.width / Math.max(bounds.height, 1)))));
    let size = 76;
    const fits = () => {
      const rows = Math.ceil(n / cols);
      const rowW = cols * size + (cols - 1) * gap;
      const h = size + (rows - 1) * (size * 0.78);
      return rowW <= bounds.width + 1 && h <= bounds.height + 1;
    };
    for (let i = 0; i < 48 && !fits(); i++) {
      if (size > 44) size -= 2;
      else cols += 1;
    }
    const rows = Math.ceil(n / cols);
    const stepY = size * 0.78;
    const totalH = size + (rows - 1) * stepY;
    const top = bounds.top + Math.max(0, (bounds.height - totalH) / 2);
    const pts = [];
    let i = 0;
    for (let r = 0; r < rows; r++) {
      const count = Math.min(cols, n - i);
      const rowW = count * size + Math.max(0, count - 1) * gap;
      let left = bounds.left + (bounds.width - rowW) / 2;
      if (r % 2 === 1) left += Math.min((size + gap) / 2, Math.max(0, (bounds.width - rowW) / 2));
      for (let c = 0; c < count; c++) {
        pts.push({ x: left + c * (size + gap) + size / 2, y: top + size / 2 + r * stepY });
        i++;
      }
    }
    return { pts, size };
  }
  function packBounds(lis) {
    const parent = lis[0].parentElement.getBoundingClientRect();
    const top = Math.max(parent.top, 88);
    const bottom = Math.min(Math.max(parent.bottom, top + 180), window.innerHeight - 12);
    return { left: parent.left, top, width: Math.max(parent.width, 140), height: Math.max(180, bottom - top) };
  }
  function makeGhost(li, rect, tilt) {
    const g = document.createElement('div');
    g.className = 'seal-ghost';
    const title = (li.querySelector('.tt')?.textContent || '').trim();
    const span = document.createElement('span');
    span.textContent = title;
    g.appendChild(span);
    const img = li.querySelector('img');
    if (img && (img.currentSrc || img.src)) {
      g.style.backgroundImage = 'url("' + (img.currentSrc || img.src) + '")';
      g.style.backgroundSize = 'cover';
      g.style.backgroundPosition = 'center';
      g.style.color = '#fff';
      g.style.textShadow = '0 1px 6px rgba(0,0,0,.55)';
    }
    g.dataset.tilt = String(tilt);
    g.dataset.line = li.dataset.line || '';
    g._li = li;
    g.style.left = rect.left + 'px';
    g.style.top = rect.top + 'px';
    g.style.width = rect.width + 'px';
    g.style.height = rect.height + 'px';
    g.style.clipPath = RECT;
    g.style.transform = 'none';
    document.body.appendChild(g);
    li.style.visibility = 'hidden';
    return g;
  }
  function placeGhost(g, x, y, w, h, tilt, scale) {
    g.style.left = (x - w / 2) + 'px';
    g.style.top = (y - h / 2) + 'px';
    g.style.width = w + 'px';
    g.style.height = h + 'px';
    g.style.transform = 'rotate(' + tilt + 'deg)' + (scale ? ' scale(' + scale + ')' : '');
  }
  async function playStamp(nextLine) {
    const { all, shown } = listNodes();
    if (shown.length < 1) { line = nextLine; apply(); return; }
    stampLock = true;
    const bounds = packBounds(shown);
    const lattice = hexLattice(shown.length, bounds);
    const ghosts = shown.map((li, i) => makeGhost(li, li.getBoundingClientRect(), ((i * 37) % 15) - 7));
    ghosts[0].getBoundingClientRect();
    const ease = 'cubic-bezier(.2,.75,.2,1)';
    ghosts.forEach((g, i) => {
      const p = lattice.pts[i];
      const delay = Math.min(i * 10, 120);
      g.style.transition = 'left .36s ' + ease + ' ' + delay + 'ms, top .36s ' + ease + ' ' + delay + 'ms, width .36s ' + ease + ' ' + delay + 'ms, height .36s ' + ease + ' ' + delay + 'ms, clip-path .28s ease ' + delay + 'ms, transform .36s ' + ease + ' ' + delay + 'ms';
      g.style.clipPath = HEX;
      placeGhost(g, p.x, p.y, lattice.size, lattice.size, g.dataset.tilt, 1);
    });
    await wait(560);
    if (!stampLock) return;
    await wait(680);
    if (!stampLock) return;
    const target = stampPending || nextLine;
    ghosts.forEach((g) => {
      g.style.transition = 'transform .12s ease-out';
      g.style.transform = 'translateY(5px) rotate(' + g.dataset.tilt + 'deg) scale(.9)';
    });
    await wait(140);
    if (!stampLock) return;
    line = stampPending || nextLine;
    stampPending = null;
    history.replaceState(null, '', line === '全部' ? '/works/' : '?line=' + encodeURIComponent(line));
    apply();
    all.forEach((li) => { li.style.visibility = 'hidden'; });
    const now = listNodes().shown;
    const byLi = new Map(ghosts.map((g) => [g._li, g]));
    const cluster = lattice.pts[Math.floor((lattice.pts.length - 1) / 2)] || lattice.pts[0];
    now.forEach((li, i) => {
      const r = li.getBoundingClientRect();
      let g = byLi.get(li);
      if (!g) {
        const p = lattice.pts[i % lattice.pts.length] || cluster;
        g = makeGhost(li, { left: p.x - lattice.size / 2, top: p.y - lattice.size / 2, width: lattice.size, height: lattice.size }, ((i * 37) % 15) - 7);
        g.style.clipPath = HEX;
        g.style.transform = 'rotate(' + g.dataset.tilt + 'deg) scale(.9)';
        ghosts.push(g);
      }
      g._to = r;
      g.style.opacity = '1';
    });
    ghosts[0].getBoundingClientRect();
    requestAnimationFrame(() => {
      ghosts.forEach((g) => {
        if (!g._to) {
          g.style.transition = 'opacity .24s linear';
          g.style.opacity = '0';
          return;
        }
        const r = g._to;
        g.style.transition = 'left .44s cubic-bezier(.16,1,.3,1), top .44s cubic-bezier(.16,1,.3,1), width .44s cubic-bezier(.16,1,.3,1), height .44s cubic-bezier(.16,1,.3,1), clip-path .44s cubic-bezier(.16,1,.3,1), transform .44s cubic-bezier(.16,1,.3,1)';
        g.style.clipPath = RECT;
        g.style.transform = 'none';
        g.style.left = r.left + 'px';
        g.style.top = r.top + 'px';
        g.style.width = r.width + 'px';
        g.style.height = r.height + 'px';
      });
    });
    await wait(500);
    ghosts.forEach((g) => g.remove());
    all.forEach((li) => { li.style.visibility = ''; });
    stampLock = false;
    if (stampPending) {
      const queued = stampPending;
      stampPending = null;
      playStamp(queued);
    }
  }
  tabs.forEach((t) => t.addEventListener('click', (e) => {
    e.preventDefault();
    const next = t.dataset.f;
    if (!next || next === line && !stampLock) return;
    tabs.forEach((tab) => {
      const on = tab.dataset.f === next;
      tab.classList.toggle('on', on);
      if (on) tab.setAttribute('aria-current', 'true');
      else tab.removeAttribute('aria-current');
    });
    if (reduce || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      line = next;
      history.replaceState(null, '', line === '全部' ? '/works/' : '?line=' + encodeURIComponent(line));
      apply();
      return;
    }
    history.replaceState(null, '', next === '全部' ? '/works/' : '?line=' + encodeURIComponent(next));
    if (stampLock) { stampPending = next; return; }
    playStamp(next);
  }));
  apply();

  // 预取所有封面，悬停时不闪白
  const pre = () => {
    if (!matchMedia('(min-width: 1024px) and (hover: hover)').matches) return;
