---
// 作品库：代表作在前，全部作品默认收起。封面是静图，不自动播放。
import Base from '../../layouts/Base.astro';
import WorkCover from '../../components/WorkCover.astro';
import { FEATURED_SLUGS, LINES, allWorks, clean, splitTitle } from '../../lib';

const ws = (await allWorks()).map((w) => {
  const [main, sub] = splitTitle(w.title);
  return {
    ...w,
    main,
    sub,
    desc: clean(w.description),
    tag: w.status === '进行中' ? `${w.line} · 进行中` : w.line,
  };
});
const bySlug = new Map(ws.map((w) => [w.slug, w]));
const featured = FEATURED_SLUGS.map((slug) => bySlug.get(slug)).filter((w) => !!w);
const tabs = [['全部', ws.length], ...LINES.map((line) => [line, ws.filter((w) => w.line === line).length])] as [string, number][];
---
<Base title="作品 · 幕景宇宙" description="幕景宇宙的代表作，以及按创作线收着的全部作品。" active="/works/">
<main class="wf">
  <header class="wf-head">
    <h1>作品<sup>{ws.length}</sup></h1>
    <p class="intro">先看 {featured.length} 件代表作。其余按创作线收在全部作品里。</p>
  </header>

  <section class="wf-block" id="features" aria-labelledby="feat-title">
    <div class="wf-sec">
      <span class="n">01</span>
      <h2 id="feat-title">代表作 <em>Features</em></h2>
      <span class="r">{featured.length} 件</span>
    </div>
    <div class="wf-feat">
      {featured.map((w, i) => (
        <a class:list={['card', i === 0 && 'lead']} href={`/works/${w.slug}/`}>
          <div class="im">
            <WorkCover w={w} eager={i === 0} />
            <span class="go">查看</span>
          </div>
          <div class="cap">
            <span class="no">{w.no}</span>
            <h3><span class="ttl">{w.main}</span>{w.sub && <em>{w.sub}</em>}</h3>
            <span class="yr">{w.yearNum || w.year}</span>
            {w.desc && <p class="blurb">{w.desc}</p>}
            <span class="tag">{w.tag}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <details class="wf-fold" id="archive" data-mode="grid">
    <summary>
      <span class="n">02</span>
      <h2>全部作品 <em>All works</em></h2>
      <span class="r"><span class="when-shut">展开</span><span class="when-open">收起</span> <b>{ws.length}</b></span>
    </summary>
    <script is:inline>
      (function () {
        var a = document.getElementById('archive');
        if (!a) return;
        var line = new URLSearchParams(location.search).get('line');
        if (location.hash === '#archive' || (line && line !== '全部')) a.open = true;
      })();
    </script>
    <div class="wf-arch">
      <div class="wf-bar">
        <div class="wf-filters" role="group" aria-label="按创作线筛选">
          {tabs.map(([line, n], i) => (
            <button type="button" data-f={line} class={i === 0 ? 'on' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}>
              {line}<sup>{n}</sup>
            </button>
          ))}
        </div>
        <div class="wf-tools">
          <span class="wf-count" id="wf-count">{ws.length} 件</span>
          <div class="wf-view" role="group" aria-label="查看方式">
            <button type="button" data-mode="grid" class="on" aria-pressed="true">网格</button>
            <button type="button" data-mode="list" aria-pressed="false">列表</button>
          </div>
        </div>
      </div>
      <noscript><p class="wf-note">筛选需要打开脚本。这里是全部作品。</p></noscript>
      <div class="wf-cards">
        {ws.map((w) => (
          <a class="card" href={`/works/${w.slug}/`} data-line={w.line} data-slug={w.slug}>
            <div class="im"><WorkCover w={w} /></div>
            <div class="cap">
              <span class="no">{w.no}</span>
              <h3><span class="ttl">{w.main}</span>{w.sub && <em>{w.sub}</em>}</h3>
              <span class="yr">{w.yearNum || w.year}</span>
              <span class="tag">{w.tag}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="idx">
        <div class="row hd" aria-hidden="true">
          <span class="no">No.</span>
          <span class="t">作品</span>
          <span class="c">类别</span>
          <span class="d">简介</span>
          <span class="y">年份</span>
        </div>
        {ws.map((w) => (
          <a class="row" href={`/works/${w.slug}/`} data-line={w.line} data-slug={w.slug}>
            <span class="no">{w.no}</span>
            <span class="t">{w.main}{w.sub && <em>{w.sub}</em>}</span>
            <span class="c">{w.tag}</span>
            <span class="d">{w.desc}</span>
            <span class="y">{w.yearNum || w.year}</span>
          </a>
        ))}
      </div>
      <p class="wf-empty" id="wf-empty" hidden>这一类还没有作品。</p>
    </div>
  </details>
</main>

<style is:global>
.wf {
  --rule1: rgba(26, 26, 28, .10);
  --rule2: rgba(26, 26, 28, .16);
  --song: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  --fbpaper: #F1EEE6;
  width: min(1200px, calc(100% - 96px));
  margin: 0 auto;
  padding: 28px 0 16px;
  color: var(--ink);
}
.wf a { color: inherit; text-decoration: none; }
.wf p { margin: 0; }
.wf [hidden] { display: none !important; }
.wf-head {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(220px, .7fr);
  gap: 32px 48px;
  align-items: end;
  padding: 28px 0 4px;
}
.wf h1 {
  margin: 0;
  font-family: var(--song);
  font-weight: 600;
  font-size: clamp(64px, 8vw, 104px);
  line-height: .92;
  letter-spacing: .03em;
  color: var(--ink);
}
.wf h1 sup {
  font-family: var(--en);
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0;
  margin-left: 10px;
  color: var(--muted);
  vertical-align: super;
}
.wf .intro {
  margin: 0 0 10px;
  max-width: 22em;
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink2);
}
.wf-block { margin-top: 56px; scroll-margin-top: 96px; }
.wf-sec, .wf-fold summary {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  column-gap: 12px;
  align-items: baseline;
}
.wf-sec { border-top: 1px solid var(--ink); padding-top: 14px; }
.wf-sec .n, .wf-fold summary .n {
  font-family: var(--en);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .06em;
  color: var(--accent);
}
.wf h2 {
  margin: 0;
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: .14em;
  line-height: 1.4;
}
.wf h2 em {
  font-style: normal;
  font-weight: 400;
  font-family: var(--en);
  font-size: 12px;
  letter-spacing: .08em;
  color: var(--muted);
  margin-left: 8px;
}
.wf-sec .r, .wf-fold summary .r {
  font-size: 13px;
  letter-spacing: .06em;
  color: var(--muted);
  white-space: nowrap;
}
.wf-fold summary .r b { color: var(--ink); font-weight: 500; margin-left: 6px; }
.wf-feat {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 28px;
  row-gap: 64px;
  margin-top: 32px;
}
.wf-feat .lead { grid-column: 1 / -1; }
.wf .card { display: block; min-width: 0; color: inherit; }
.wf .im { position: relative; background: #EFEDE9; }
.wf .go {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: var(--bg);
  color: var(--ink);
  font-size: 13px;
  letter-spacing: .08em;
  padding: 10px 12px;
  opacity: 0;
  pointer-events: none;
}
.wf .cap {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  column-gap: 8px;
  align-items: baseline;
  padding-top: 14px;
}
.wf .cap .no, .wf .cap .yr, .wf .idx .no, .wf .idx .y {
  font-family: var(--en);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  letter-spacing: .04em;
  color: var(--muted);
}
.wf .card h3 {
  margin: 0;
  min-width: 0;
  font-family: var(--song);
  font-weight: 600;
  font-size: 22px;
  line-height: 1.35;
  letter-spacing: .02em;
  overflow-wrap: break-word;
}
.wf .lead h3 { font-size: clamp(26px, 2.4vw, 34px); }
.wf .card h3 em {
  display: block;
  margin-top: 4px;
  font-style: normal;
  font-weight: 400;
  font-family: var(--sans);
  font-size: 14px;
  letter-spacing: 0;
  color: var(--ink2);
}
.wf .blurb {
  grid-column: 2 / 4;
  margin-top: 8px;
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.wf .tag {
  grid-column: 2 / 4;
  margin-top: 10px;
  font-size: 12px;
  letter-spacing: .08em;
  color: var(--muted);
}
.wf-fold {
  margin-top: 72px;
  border-top: 1px solid var(--ink);
  scroll-margin-top: 96px;
  overflow-anchor: none;
}
.wf-fold summary {
  list-style: none;
  cursor: pointer;
  padding: 16px 96px 16px 0;
  min-height: 48px;
}
.wf-fold summary::-webkit-details-marker { display: none; }
.wf-fold summary::marker { content: ""; }
.wf-fold:not([open]) > :not(summary) { display: none !important; }
.wf-fold[open] .when-shut, .wf-fold:not([open]) .when-open { display: none; }
.wf-arch { padding-bottom: 8px; }
.wf-bar {
  position: sticky;
  top: 80px;
  z-index: 4;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px 24px;
  padding: 12px 0 10px;
  background: rgba(246, 245, 243, .94);
  backdrop-filter: blur(12px);
}
.wf-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2px 22px;
  flex: 1 1 280px;
  min-width: 0;
  max-width: 100%;
}
.wf-filters button, .wf-view button {
  border: 0;
  background: none;
  padding: 10px 0;
  font: inherit;
  font-size: 14px;
  letter-spacing: .04em;
  color: var(--muted);
  cursor: pointer;
  white-space: nowrap;
}
.wf-filters button sup {
  font-family: var(--en);
  font-size: 10px;
  margin-left: 4px;
  letter-spacing: 0;
  color: var(--muted);
}
.wf-filters button.on {
  color: var(--ink);
  box-shadow: inset 0 -1px 0 var(--accent);
}
.wf-tools { display: flex; align-items: center; gap: 18px; }
.wf-count { font-size: 12px; letter-spacing: .08em; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.wf-view { display: flex; gap: 16px; }
.wf-view button.on { color: var(--ink); font-weight: 600; }
.wf-note { margin: 8px 0 0; font-size: 13px; color: var(--muted); }
.wf-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 24px;
  row-gap: 56px;
  margin-top: 22px;
}
.wf-fold[data-mode="list"] .wf-cards, .wf-fold[data-mode="grid"] .idx { display: none; }
.wf-empty { margin: 28px 0 8px; color: var(--muted); font-size: 15px; }
.wf .idx { margin-top: 12px; border-top: 1px solid var(--ink); }
.wf .idx .row {
  display: grid;
  grid-template-columns: 52px minmax(0, 1.4fr) 148px minmax(0, 1.3fr) 56px;
  column-gap: 16px;
  align-items: center;
  min-height: 58px;
  padding: 10px 0;
  border-bottom: 1px solid var(--rule1);
  color: inherit;
}
.wf .idx .hd { min-height: 40px; }
.wf .idx .hd span {
  font-family: var(--en) !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  letter-spacing: .12em;
  color: var(--muted) !important;
}
.wf .idx .t {
  min-width: 0;
  font-family: var(--song);
  font-size: 18px;
  line-height: 1.4;
  letter-spacing: .02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wf .idx .t em {
  font-style: normal;
  font-weight: 400;
  font-family: var(--sans);
  font-size: 14px;
  color: var(--muted);
  margin-left: 8px;
}
.wf .idx .c, .wf .idx .d {
  min-width: 0;
  font-size: 14px;
  color: var(--ink2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wf .idx .y { text-align: right; }
/* cover */
.wf .cv { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #EFEDE9; container-type: inline-size; }
.wf .lead .cv { aspect-ratio: 2.35 / 1; }
.wf .cv img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; max-width: none; }
.wf .cv:not(.fb) > :not(img) { display: none; }
.wf .cv.fb { background: var(--fbpaper); box-shadow: inset 0 0 0 1px var(--rule2); }
.wf .fb-no { position: absolute; left: 4.5cqw; top: 4cqw; font-family: var(--en); font-size: clamp(11px, 1.9cqw, 13px); line-height: 1; letter-spacing: .08em; color: var(--muted); }
.wf .fb-t { position: absolute; left: 9cqw; right: 9cqw; top: 50%; transform: translateY(-54%); display: flex; flex-direction: column; align-items: flex-start; }
.wf .fb-title { display: block; font-family: var(--song); font-weight: 600; font-size: 6.2cqw; line-height: 1.22; letter-spacing: .03em; color: var(--ink); text-wrap: balance; word-break: keep-all; overflow-wrap: normal; }
.wf .fb-title.long { font-size: 4.6cqw; }
.wf .fb-sub { display: block; margin-top: 2.2cqw; font-style: normal; font-family: var(--en), "Noto Sans SC", sans-serif; font-size: clamp(11px, 2.1cqw, 14px); line-height: 1.5; letter-spacing: .04em; color: var(--muted); }
.wf .fb-meta { position: absolute; left: 4.5cqw; bottom: 4cqw; font-size: clamp(11px, 1.9cqw, 13px); letter-spacing: .06em; color: var(--muted); }
@media (hover: hover) and (pointer: fine) {
  .wf .go { transition: opacity .2s ease; }
  .wf .card:hover .go { opacity: 1; }
  .wf .card:hover .cap .no { color: var(--accent); }
  .wf .idx a.row:hover { background: rgba(26, 26, 28, .03); }
  .wf .idx a.row:hover .no { color: var(--accent); }
}
@media (hover: none) { .wf .go { display: none; } }
@media (prefers-reduced-motion: reduce) { .wf .go { transition: none; } }
@media (max-width: 1000px) {
  .wf { width: calc(100% - 48px); }
  .wf-cards { grid-template-columns: 1fr 1fr; }
  .wf .idx .row { grid-template-columns: 44px minmax(0, 1.5fr) minmax(0, .8fr) 48px; }
  .wf .idx .d { display: none; }
}
@media (max-width: 768px) {
  .wf-bar { top: 52px; }
  .wf-block, .wf-fold { scroll-margin-top: 64px; }
}
@media (max-width: 700px) {
  .wf { width: auto; margin: 0; padding: 8px 24px 8px; }
  .wf-head { display: block; padding-top: 16px; }
  .wf h1 { font-size: 52px; }
  .wf .intro { margin-top: 14px; }
  .wf-block { margin-top: 36px; }
  .wf-feat, .wf-cards { grid-template-columns: 1fr; row-gap: 36px; }
  .wf-feat .lead { grid-column: auto; }
  .wf .lead .cv { aspect-ratio: 16 / 9; }
  .wf .card h3, .wf .lead h3 { font-size: 20px; }
  .wf-fold { margin-top: 40px; }
  .wf h2 em { display: none; }
  .wf-fold summary { padding-right: 80px; }
  .wf-filters { gap: 0 16px; }
  .wf-filters button { min-height: 44px; }
  .wf-tools { width: 100%; justify-content: space-between; }
  .wf .idx .row { grid-template-columns: 36px minmax(0, 1fr) auto; column-gap: 10px; min-height: 52px; }
  .wf .idx .c, .wf .idx .d, .wf .idx .t em { display: none; }
  .wf .idx .t { font-size: 16px; }
  .wf-cards { row-gap: 32px; }
}
</style>
<script is:inline>
(() => {
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const fail = (img) => { const cv = img.closest('.cv'); if (cv) cv.classList.add('fb'); img.remove(); };
  $$('.wf img[data-cv-img]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0 && img.src) fail(img);
    else img.addEventListener('error', () => fail(img), { once: true });
  });

  const arch = $('#archive');
  if (!arch) return;
  const filters = $$('.wf-filters button');
  const valid = new Set(filters.map((b) => b.dataset.f));
  let line = new URLSearchParams(location.search).get('line') || '全部';
  if (!valid.has(line)) line = '全部';
  const cards = $$('.wf-cards .card');
  const rows = $$('.wf .idx .row[data-line]');
  const count = $('#wf-count');
  const empty = $('#wf-empty');

  function paint() {
    filters.forEach((b) => {
      const on = b.dataset.f === line;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    const hit = (el) => line === '全部' || el.dataset.line === line;
    cards.forEach((el) => { el.hidden = !hit(el); });
    rows.forEach((el) => { el.hidden = !hit(el); });
    const n = cards.filter((el) => !el.hidden).length;
    if (count) count.textContent = line === '全部' ? `${cards.length} 件` : `${n} / ${cards.length}`;
    if (empty) empty.hidden = n !== 0;
  }
  function writeUrl() {
    const url = new URL(location.href);
    if (line === '全部') url.searchParams.delete('line');
    else url.searchParams.set('line', line);
    url.hash = arch.open ? 'archive' : (url.hash === '#archive' ? '' : url.hash);
    history.replaceState(null, '', url.pathname + url.search + url.hash);
  }
  filters.forEach((b) => b.addEventListener('click', () => {
    line = b.dataset.f;
    paint();
    writeUrl();
  }));
  $$('.wf-view button').forEach((b) => b.addEventListener('click', () => {
    arch.dataset.mode = b.dataset.mode;
    $$('.wf-view button').forEach((x) => {
      const on = x === b;
      x.classList.toggle('on', on);
      x.setAttribute('aria-pressed', String(on));
    });
  }));
  arch.addEventListener('toggle', () => {
    if (arch.open) return;
    if (location.hash === '#archive') {
      history.replaceState(null, '', location.pathname + location.search);
    }
    const header = window.innerWidth <= 768 ? 72 : 108;
    const top = arch.getBoundingClientRect().top;
    const comfortable = top >= header && top < window.innerHeight * 0.45;
    if (!comfortable) {
      const root = document.documentElement;
      const prev = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      window.scrollTo({ top: Math.max(0, window.scrollY + top - header), behavior: 'auto' });
      root.style.scrollBehavior = prev;
    }
  });
  if ((location.hash === '#archive' || line !== '全部') && !arch.open) arch.open = true;
  paint();
})();
</script>
</Base>
